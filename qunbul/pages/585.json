[[80,1,"عَبَسَ وَتَوَلَّىٰ","ﰀ",[1]],[80,2,"أَن جَآءَهُ ٱلۡأَعۡمَىٰ","ﰁ",[2]],[80,3,"وَمَا يُدۡرِيكَ لَعَلَّهُۥ يَزَّكَّىٰ","ﰂ",[3]],[80,4,"أَوۡ يَذَّكَّرُ فَتَنفَعُهُ ٱلذِّكۡرَىٰ","ﰃ",[4]],[80,5,"أَمَّا مَنِ ٱسۡتَغۡنَىٰ","ﰄ",[5]],[80,6,"فَأَنتَ لَهُۥ تَصَّدَّىٰ","ﰅ",[6]],[80,7,"وَمَا عَلَيۡكَ أَلَّا يَزَّكَّىٰ","ﰆ",[7]],[80,8,"وَأَمَّا مَن جَآءَكَ يَسۡعَىٰ","ﰇ",[8]],[80,9,"وَهُوَ يَخۡشَىٰ","ﰈ",[9]],[80,10,"فَأَنتَ عَنۡهُۥ تَلَهَّىٰ","ﰉ",[10]],[80,11,"كَلَّا إِنَّهَا تَذۡكِرَةٞ","ﰊ",[11]],[80,12,"فَمَن شَآءَ ذَكَرَهُۥ","ﰋ",[12]],[80,13,"فِي صُحُفٖ مُّكَرَّمَةٖ","ﰌ",[13]],[80,14,"مَّرۡفُوعَةٖ مُّطَهَّرَةِۭ","ﰍ",[14]],[80,15,"بِأَيۡدِي سَفَرَةٖ","ﰎ",[15]],[80,16,"كِرَامِۭ بَرَرَةٖ","ﰏ",[16]],[80,17,"قُتِلَ ٱلۡإِنسَٰنُ مَا أَكۡفَرَهُۥ","ﰐ",[17]],[80,18,"مِنۡ أَيِّ شَيۡءٍ خَلَقَهُۥ","ﰑ",[18]],[80,19,"مِن نُّطۡفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ","ﰒ",[19]],[80,20,"ثُمَّ ٱلسَّبِيلَ يَسَّرَهُۥ","ﰓ",[20]],[80,21,"ثُمَّ أَمَاتَهُۥ فَأَقۡبَرَهُۥ","ﰔ",[21]],[80,22,"ثُمَّ إِذَا شَآءَ ا۬نشَرَهُۥ","ﰕ",[22]],[80,23,"كَلَّا لَمَّا يَقۡضِ مَا أَمَرَهُۥ","ﰖ",[23]],[80,24,"فَلۡيَنظُرِ ٱلۡإِنسَٰنُ إِلَىٰ طَعَامِهِۦ","ﰗ",[24]],[80,25,"إِنَّا صَبَبۡنَا ٱلۡمَآءَ صَبّٗا","ﰘ",[25]],[80,26,"ثُمَّ شَقَقۡنَا ٱلۡأَرۡضَ شَقّٗا","ﰙ",[26]],[80,27,"فَأَنۢبَتۡنَا فِيهَا حَبّٗا","ﰚ",[27]],[80,28,"وَعِنَبٗا وَقَضۡبٗا","ﰛ",[28]],[80,29,"وَزَيۡتُونٗا وَنَخۡلٗا","ﰜ",[29]],[80,30,"وَحَدَآئِقَ غُلۡبٗا","ﰝ",[30]],[80,31,"وَفَٰكِهَةٗ وَأَبّٗا","ﰞ",[31]],[80,32,"مَّتَٰعٗا لَّكُمُۥ وَلِأَنۡعَٰمِكُمُۥ","ﰟ",[32]],[80,33,"فَإِذَا جَآءَتِ ٱلصَّآخَّةُ","ﰠ",[33]],[80,34,"يَوۡمَ يَفِرُّ ٱلۡمَرۡءُ مِنۡ أَخِيهِۦ","ﰡ",[34]],[80,35,"وَأُمِّهِۦ وَأَبِيهِۦ","ﰢ",[35]],[80,36,"وَصَٰحِبَتِهِۦ وَبَنِيهِۦ","ﰣ",[36]],[80,37,"لِكُلِّ ٱمۡرِيٕٖ مِّنۡهُمُۥ يَوۡمَئِذٖ شَأۡنٞ يُغۡنِيهِۦ","ﰤ",[37]],[80,38,"وُجُوهٞ يَوۡمَئِذٖ مُّسۡفِرَةٞ","ﰥ",[38]],[80,39,"ضَاحِكَةٞ مُّسۡتَبۡشِرَةٞ","ﰦ",[39]],[80,40,"وَوُجُوهٞ يَوۡمَئِذٍ عَلَيۡهَا غَبَرَةٞ","ﰧ",[40]]]