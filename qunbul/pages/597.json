[[94,3,"ٱلَّذِي أَنقَضَ ظَهۡرَكَ","ﰂ",[3]],[94,4,"وَرَفَعۡنَا لَكَ ذِكۡرَكَ","ﰃ",[4]],[94,5,"فَإِنَّ مَعَ ٱلۡعُسۡرِ يُسۡرًا","ﰄ",[5]],[94,6,"إِنَّ مَعَ ٱلۡعُسۡرِ يُسۡرٗا","ﰅ",[6]],[94,7,"فَإِذَا فَرَغۡتَ فَٱنصَبۡ","ﰆ",[7]],[94,8,"وَإِلَىٰ رَبِّكَ فَٱرۡغَب","ﰇ",[8]],[95,1,"وَٱلتِّينِ وَٱلزَّيۡتُونِ","ﰀ",[1]],[95,2,"وَطُورِ سِينِينَ","ﰁ",[2]],[95,3,"وَهَٰذَا ٱلۡبَلَدِ ٱلۡأَمِينِ","ﰂ",[3]],[95,4,"لَقَدۡ خَلَقۡنَا ٱلۡإِنسَٰنَ فِي أَحۡسَنِ تَقۡوِيمٖ","ﰃ",[4]],[95,5,"ثُمَّ رَدَدۡنَٰهُۥ أَسۡفَلَ سَٰفِلِينَ","ﰄ",[5]],[95,6,"إِلَّا ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّٰلِحَٰتِ فَلَهُمُۥ أَجۡرٌ غَيۡرُ مَمۡنُونٖ","ﰅ",[6]],[95,7,"فَمَا يُكَذِّبُكَ بَعۡدُ بِٱلدِّينِ","ﰆ",[7]],[95,8,"أَلَيۡسَ ٱللَّهُ بِأَحۡكَمِ ٱلۡحَٰكِمِينَ","ﰇ",[8]],[96,1,"ٱقۡرَأۡ بِٱسۡمِ رَبِّكَ ٱلَّذِي خَلَقَ","ﰀ",[1]],[96,2,"خَلَقَ ٱلۡإِنسَٰنَ مِنۡ عَلَقٍ","ﰁ",[2]],[96,3,"ٱقۡرَأۡ وَرَبُّكَ ٱلۡأَكۡرَمُ","ﰂ",[3]],[96,4,"ٱلَّذِي عَلَّمَ بِٱلۡقَلَمِ","ﰃ",[4]],[96,5,"عَلَّمَ ٱلۡإِنسَٰنَ مَا لَمۡ يَعۡلَمۡ","ﰄ",[5]],[96,6,"كَلَّا إِنَّ ٱلۡإِنسَٰنَ لَيَطۡغَىٰ","ﰅ",[6]],[96,7,"أَن رَّءَاهُ ٱسۡتَغۡنَىٰ","ﰆ",[7]],[96,8,"إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجۡعَىٰ","ﰇ",[8]],[96,9,"أَرَءَيۡتَ ٱلَّذِي يَنۡهَىٰ","ﰈ",[9]],[96,10,"عَبۡدًا إِذَا صَلَّىٰ","ﰉ",[10]],[96,11,"أَرَءَيۡتَ إِن كَانَ عَلَى ٱلۡهُدَىٰ","ﰊ",[11]],[96,12,"أَوۡ أَمَرَ بِٱلتَّقۡوَىٰ","ﰋ",[12]]]