[[83,34,"فَٱلۡيَوۡمَ ٱلَّذِينَ ءَامَنُواْ مِنَ ٱلۡكُفَّارِ يَضۡحَكُونَ","ﰡ",[34]],[83,35,"عَلَى ٱلۡأَرَآئِكِ يَنظُرُونَ","ﰢ",[35]],[83,36,"هَلۡ ثُوِّبَ ٱلۡكُفَّارُ مَا كَانُواْ يَفۡعَلُونَ","ﰣ",[36]],[84,1,"إِذَا ٱلسَّمَآءُ ٱنشَقَّتۡ","ﰀ",[1]],[84,2,"وَأَذِنَتۡ لِرَبِّهَا وَحُقَّتۡ","ﰁ",[2]],[84,3,"وَإِذَا ٱلۡأَرۡضُ مُدَّتۡ","ﰂ",[3]],[84,4,"وَأَلۡقَتۡ مَا فِيهَا وَتَخَلَّتۡ","ﰃ",[4]],[84,5,"وَأَذِنَتۡ لِرَبِّهَا وَحُقَّتۡ","ﰄ",[5]],[84,6,"يَٰأَيُّهَا ٱلۡإِنسَٰنُ إِنَّكَ كَادِحٌ إِلَىٰ رَبِّكَ كَدۡحٗا فَمُلَٰقِيهِۦ","ﰅ",[6]],[84,7,"فَأَمَّا مَنۡ أُوتِيَ كِتَٰبَهُۥ بِيَمِينِهِۦ","ﰆ",[7]],[84,8,"فَسَوۡفَ يُحَاسَبُ حِسَابٗا يَسِيرٗا","ﰇ",[8]],[84,9,"وَيَنقَلِبُ إِلَىٰ أَهۡلِهِۦ مَسۡرُورٗا","ﰈ",[9]],[84,10,"وَأَمَّا مَنۡ أُوتِيَ كِتَٰبَهُۥ وَرَآءَ ظَهۡرِهِۦ","ﰉ",[10]],[84,11,"فَسَوۡفَ يَدۡعُواْ ثُبُورٗا","ﰊ",[11]],[84,12,"وَيُصَلَّي سَعِيرًا","ﰋ",[12]],[84,13,"إِنَّهُۥ كَانَ فِي أَهۡلِهِۦ مَسۡرُورًا","ﰌ",[13]],[84,14,"إِنَّهُۥ ظَنَّ أَن لَّن يَحُورَ","ﰍ",[14]],[84,15,"بَلَىٰۚ إِنَّ رَبَّهُۥ كَانَ بِهِۦ بَصِيرٗا","ﰎ",[15]],[84,16,"فَلَا أُقۡسِمُ بِٱلشَّفَقِ","ﰏ",[16]],[84,17,"وَٱلَّيۡلِ وَمَا وَسَقَ","ﰐ",[17]],[84,18,"وَٱلۡقَمَرِ إِذَا ٱتَّسَقَ","ﰑ",[18]],[84,19,"لَتَرۡكَبَنَّ طَبَقًا عَن طَبَقٖ","ﰒ",[19]],[84,20,"فَمَا لَهُمُۥ لَا يُؤۡمِنُونَ","ﰓ",[20]],[84,21,"وَإِذَا قُرِئَ عَلَيۡهِمُ ٱلۡقُرَانُ لَا يَسۡجُدُونَۤ۩","ﰔ",[21]],[84,22,"بَلِ ٱلَّذِينَ كَفَرُواْ يُكَذِّبُونَ","ﰕ",[22]],[84,23,"وَٱللَّهُ أَعۡلَمُ بِمَا يُوعُونَ","ﰖ",[23]],[84,24,"فَبَشِّرۡهُمُۥ بِعَذَابٍ أَلِيمٍ","ﰗ",[24]]]