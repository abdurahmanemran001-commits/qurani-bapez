[[56,80,"إِنَّهُۥ لَقُرَانٞ كَرِيمٞ","ﱏ",[77]],[56,81,"فِي كِتَٰبٖ مَّكۡنُونٖ","ﱐ",[78]],[56,82,"لَّا يَمَسُّهُۥ إِلَّا ٱلۡمُطَهَّرُونَ","ﱑ",[79]],[56,83,"تَنزِيلٞ مِّن رَّبِّ ٱلۡعَٰلَمِينَ","ﱒ",[80]],[56,84,"أَفَبِهَٰذَا ٱلۡحَدِيثِ أَنتُمُۥ مُدۡهِنُونَ","ﱓ",[81]],[56,85,"وَتَجۡعَلُونَ رِزۡقَكُمُۥ أَنَّكُمُۥ تُكَذِّبُونَ","ﱔ",[82]],[56,86,"فَلَوۡلَا إِذَا بَلَغَتِ ٱلۡحُلۡقُومَ","ﱕ",[83]],[56,87,"وَأَنتُمُۥ حِينَئِذٖ تَنظُرُونَ","ﱖ",[84]],[56,88,"وَنَحۡنُ أَقۡرَبُ إِلَيۡهِۦ مِنكُمُۥ وَلَٰكِن لَّا تُبۡصِرُونَ","ﱗ",[85]],[56,89,"فَلَوۡلَا إِن كُنتُمُۥ غَيۡرَ مَدِينِينَ","ﱘ",[86]],[56,90,"تَرۡجِعُونَهَا إِن كُنتُمُۥ صَٰدِقِينَ","ﱙ",[87]],[56,91,"فَأَمَّا إِن كَانَ مِنَ ٱلۡمُقَرَّبِينَ","ﱚ",[88]],[56,92,"فَرَوۡحٞ وَرَيۡحَانٞ وَجَنَّتُ نَعِيمٖ","ﱛ",[89]],[56,93,"وَأَمَّا إِن كَانَ مِنۡ أَصۡحَٰبِ ٱلۡيَمِينِ","ﱜ",[90]],[56,94,"فَسَلَٰمٞ لَّكَ مِنۡ أَصۡحَٰبِ ٱلۡيَمِينِ","ﱝ",[91]],[56,95,"وَأَمَّا إِن كَانَ مِنَ ٱلۡمُكَذِّبِينَ ٱلضَّآلِّينَ","ﱞ",[92]],[56,96,"فَنُزُلٞ مِّنۡ حَمِيمٖ","ﱟ",[93]],[56,97,"وَتَصۡلِيَةُ جَحِيمٍ","ﱠ",[94]],[56,98,"إِنَّ هَٰذَا لَهُوَ حَقُّ ٱلۡيَقِينِ","ﱡ",[95]],[56,99,"فَسَبِّحۡ بِٱسۡمِ رَبِّكَ ٱلۡعَظِيمِ","ﱢ",[96]],[57,1,"سَبَّحَ لِلَّهِ مَا فِي ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِۖ وَهُوَ ٱلۡعَزِيزُ ٱلۡحَكِيمُ","ﰀ",[1]],[57,2,"لَهُۥ مُلۡكُ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِۖ يُحۡيِۦ وَيُمِيتُۖ وَهُوَ عَلَىٰ كُلِّ شَيۡءٖ قَدِيرٌ","ﰁ",[2]],[57,3,"هُوَ ٱلۡأَوَّلُ وَٱلۡأٓخِرُ وَٱلظَّٰهِرُ وَٱلۡبَاطِنُۖ وَهُوَ بِكُلِّ شَيۡءٍ عَلِيمٌ","ﰂ",[3]]]