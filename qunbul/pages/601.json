[[103,1,"وَٱلۡعَصۡرِ","ﰀ",[1]],[103,2,"إِنَّ ٱلۡإِنسَٰنَ لَفِي خُسۡرٍ","ﰁ",[2]],[103,3,"إِلَّا ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّٰلِحَٰتِ وَتَوَاصَوۡاْ بِٱلۡحَقِّ وَتَوَاصَوۡاْ بِٱلصَّبۡرِ","ﰂ",[3]],[104,1,"وَيۡلٞ لِّكُلِّ هُمَزَةٖ لُّمَزَةٍ","ﰀ",[1]],[104,2,"ٱلَّذِي جَمَعَ مَالٗا وَعَدَّدَهُۥ","ﰁ",[2]],[104,3,"يَحۡسِبُ أَنَّ مَالَهُۥ أَخۡلَدَهُۥ","ﰂ",[3]],[104,4,"كَلَّاۖ لَيُنۢبَذَنَّ فِي ٱلۡحُطَمَةِ","ﰃ",[4]],[104,5,"وَمَا أَدۡرَىٰكَ مَا ٱلۡحُطَمَةُ","ﰄ",[5]],[104,6,"نَارُ ٱللَّهِ ٱلۡمُوقَدَةُ","ﰅ",[6]],[104,7,"ٱلَّتِي تَطَّلِعُ عَلَى ٱلۡأَفۡــِٔدَةِ","ﰆ",[7]],[104,8,"إِنَّهَا عَلَيۡهِمُۥ مُوصَدَةٞ","ﰇ",[8]],[104,9,"فِي عَمَدٖ مُّمَدَّدَةِۭ","ﰈ",[9]],[105,1,"أَلَمۡ تَرَ كَيۡفَ فَعَلَ رَبُّكَ بِأَصۡحَٰبِ ٱلۡفِيلِ","ﰀ",[1]],[105,2,"أَلَمۡ يَجۡعَلۡ كَيۡدَهُمُۥ فِي تَضۡلِيلٖ","ﰁ",[2]],[105,3,"وَأَرۡسَلَ عَلَيۡهِمُۥ طَيۡرًا أَبَابِيلَ","ﰂ",[3]],[105,4,"تَرۡمِيهِمُۥ بِحِجَارَةٖ مِّن سِجِّيلٖ","ﰃ",[4]],[105,5,"فَجَعَلَهُمُۥ كَعَصۡفٖ مَّأۡكُولِۭ","ﰄ",[5]]]