[[37,127,"فَكَذَّبُوهُۥ فَإِنَّهُمُۥ لَمُحۡضَرُونَ","ﱾ",[127]],[37,128,"إِلَّا عِبَادَ ٱللَّهِ ٱلۡمُخۡلِصِينَ","ﱿ",[128]],[37,129,"وَتَرَكۡنَا عَلَيۡهِۦ فِي ٱلۡأٓخِرِينَ","ﲀ",[129]],[37,130,"سَلَٰمٌ عَلَىٰ إِلۡ يَاسِينَ","ﲁ",[130]],[37,131,"إِنَّا كَذَٰلِكَ نَجۡزِي ٱلۡمُحۡسِنِينَ","ﲂ",[131]],[37,132,"إِنَّهُۥ مِنۡ عِبَادِنَا ٱلۡمُؤۡمِنِينَ","ﲃ",[132]],[37,133,"وَإِنَّ لُوطٗا لَّمِنَ ٱلۡمُرۡسَلِينَ","ﲄ",[133]],[37,134,"إِذۡ نَجَّيۡنَٰهُۥ وَأَهۡلَهُۥ أَجۡمَعِينَ","ﲅ",[134]],[37,135,"إِلَّا عَجُوزٗا فِي ٱلۡغَٰبِرِينَ","ﲆ",[135]],[37,136,"ثُمَّ دَمَّرۡنَا ٱلۡأٓخَرِينَ","ﲇ",[136]],[37,137,"وَإِنَّكُمُۥ لَتَمُرُّونَ عَلَيۡهِمُۥ مُصۡبِحِينَ","ﲈ",[137]],[37,138,"وَبِٱلَّيۡلِۚ أَفَلَا تَعۡقِلُونَ","ﲉ",[138]],[37,139,"وَإِنَّ يُونُسَ لَمِنَ ٱلۡمُرۡسَلِينَ","ﲊ",[139]],[37,140,"إِذۡ أَبَقَ إِلَى ٱلۡفُلۡكِ ٱلۡمَشۡحُونِ","ﲋ",[140]],[37,141,"فَسَاهَمَ فَكَانَ مِنَ ٱلۡمُدۡحَضِينَ","ﲌ",[141]],[37,142,"فَٱلۡتَقَمَهُ ٱلۡحُوتُ وَهُوَ مُلِيمٞ","ﲍ",[142]],[37,143,"فَلَوۡلَا أَنَّهُۥ كَانَ مِنَ ٱلۡمُسَبِّحِينَ","ﲎ",[143]],[37,144,"لَلَبِثَ فِي بَطۡنِهِۦ إِلَىٰ يَوۡمِ يُبۡعَثُونَ","ﲏ",[144]],[37,145,"۞فَنَبَذۡنَٰهُۥ بِٱلۡعَرَآءِ وَهُوَ سَقِيمٞ","ﲐ",[145]],[37,146,"وَأَنۢبَتۡنَا عَلَيۡهِۦ شَجَرَةٗ مِّن يَقۡطِينٖ","ﲑ",[146]],[37,147,"وَأَرۡسَلۡنَٰهُۥ إِلَىٰ مِاْئَةِ أَلۡفٍ أَوۡ يَزِيدُونَ","ﲒ",[147]],[37,148,"فَــَٔامَنُواْ فَمَتَّعۡنَٰهُمُۥ إِلَىٰ حِينٖ","ﲓ",[148]],[37,149,"فَٱسۡتَفۡتِهِمُۥ أَلِرَبِّكَ ٱلۡبَنَاتُ وَلَهُمُ ٱلۡبَنُونَ","ﲔ",[149]],[37,150,"أَمۡ خَلَقۡنَا ٱلۡمَلَٰٓئِكَةَ إِنَٰثٗا وَهُمُۥ شَٰهِدُونَ","ﲕ",[150]],[37,151,"أَلَا إِنَّهُمُۥ مِنۡ إِفۡكِهِمُۥ لَيَقُولُونَ","ﲖ",[151]],[37,152,"وَلَدَ ٱللَّهُ وَإِنَّهُمُۥ لَكَٰذِبُونَ","ﲗ",[152]],[37,153,"أَصۡطَفَى ٱلۡبَنَاتِ عَلَى ٱلۡبَنِينَ","ﲘ",[153]]]