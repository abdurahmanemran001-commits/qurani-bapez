[[86,1,"وَٱلسَّمَآءِ وَٱلطَّارِقِ","ﰀ",[1]],[86,2,"وَمَا أَدۡرَىٰكَ مَا ٱلطَّارِقُ","ﰁ",[2]],[86,3,"ٱلنَّجۡمُ ٱلثَّاقِبُ","ﰂ",[3]],[86,4,"إِن كُلُّ نَفۡسٖ لَّمَا عَلَيۡهَا حَافِظٞ","ﰃ",[4]],[86,5,"فَلۡيَنظُرِ ٱلۡإِنسَٰنُ مِمَّ خُلِقَ","ﰄ",[5]],[86,6,"خُلِقَ مِن مَّآءٖ دَافِقٖ","ﰅ",[6]],[86,7,"يَخۡرُجُ مِنۢ بَيۡنِ ٱلصُّلۡبِ وَٱلتَّرَآئِبِ","ﰆ",[7]],[86,8,"إِنَّهُۥ عَلَىٰ رَجۡعِهِۦ لَقَادِرٞ","ﰇ",[8]],[86,9,"يَوۡمَ تُبۡلَى ٱلسَّرَآئِرُ","ﰈ",[9]],[86,10,"فَمَا لَهُۥ مِن قُوَّةٖ وَلَا نَاصِرٖ","ﰉ",[10]],[86,11,"وَٱلسَّمَآءِ ذَاتِ ٱلرَّجۡعِ","ﰊ",[11]],[86,12,"وَٱلۡأَرۡضِ ذَاتِ ٱلصَّدۡعِ","ﰋ",[12]],[86,13,"إِنَّهُۥ لَقَوۡلٞ فَصۡلٞ","ﰌ",[13]],[86,14,"وَمَا هُوَ بِٱلۡهَزۡلِ","ﰍ",[14]],[86,15,"إِنَّهُمُۥ يَكِيدُونَ كَيۡدٗا","ﰎ",[15]],[86,16,"وَأَكِيدُ كَيۡدٗا","ﰏ",[16]],[86,17,"فَمَهِّلِ ٱلۡكَٰفِرِينَ أَمۡهِلۡهُمُۥ رُوَيۡدَۢا","ﰐ",[17]],[87,1,"سَبِّحِ ٱسۡمَ رَبِّكَ ٱلۡأَعۡلَى","ﰀ",[1]],[87,2,"ٱلَّذِي خَلَقَ فَسَوَّىٰ","ﰁ",[2]],[87,3,"وَٱلَّذِي قَدَّرَ فَهَدَىٰ","ﰂ",[3]],[87,4,"وَٱلَّذِي أَخۡرَجَ ٱلۡمَرۡعَىٰ","ﰃ",[4]],[87,5,"فَجَعَلَهُۥ غُثَآءً أَحۡوَىٰ","ﰄ",[5]],[87,6,"سَنُقۡرِئُكَ فَلَا تَنسَىٰ","ﰅ",[6]],[87,7,"إِلَّا مَا شَآءَ ٱللَّهُۚ إِنَّهُۥ يَعۡلَمُ ٱلۡجَهۡرَ وَمَا يَخۡفَىٰ","ﰆ",[7]],[87,8,"وَنُيَسِّرُكَ لِلۡيُسۡرَىٰ","ﰇ",[8]],[87,9,"فَذَكِّرۡ إِن نَّفَعَتِ ٱلذِّكۡرَىٰ","ﰈ",[9]],[87,10,"سَيَذَّكَّرُ مَن يَخۡشَىٰ","ﰉ",[10]]]