[[44,38,"إِنَّ يَوۡمَ ٱلۡفَصۡلِ مِيقَٰتُهُمُۥ أَجۡمَعِينَ","ﰥ",[40]],[44,39,"يَوۡمَ لَا يُغۡنِي مَوۡلًى عَن مَّوۡلٗى شَيۡــٔٗا وَلَا هُمُۥ يُنصَرُونَ","ﰦ",[41]],[44,40,"إِلَّا مَن رَّحِمَ ٱللَّهُۚ إِنَّهُۥ هُوَ ٱلۡعَزِيزُ ٱلرَّحِيمُ","ﰧ",[42]],[44,41,"إِنَّ شَجَرَتَ ٱلزَّقُّومِ طَعَامُ ٱلۡأَثِيمِ","ﰨ",[43,44]],[44,42,"كَٱلۡمُهۡلِ يَغۡلِي فِي ٱلۡبُطُونِ","ﰩ",[45]],[44,43,"كَغَلۡيِ ٱلۡحَمِيمِ","ﰪ",[46]],[44,44,"خُذُوهُۥ فَٱعۡتُلُوهُۥ إِلَىٰ سَوَآءِ ٱلۡجَحِيمِ","ﰫ",[47]],[44,45,"ثُمَّ صُبُّواْ فَوۡقَ رَأۡسِهِۦ مِنۡ عَذَابِ ٱلۡحَمِيمِ","ﰬ",[48]],[44,46,"ذُقۡ إِنَّكَ أَنتَ ٱلۡعَزِيزُ ٱلۡكَرِيمُ","ﰭ",[49]],[44,47,"إِنَّ هَٰذَا مَا كُنتُمُۥ بِهِۦ تَمۡتَرُونَ","ﰮ",[50]],[44,48,"إِنَّ ٱلۡمُتَّقِينَ فِي مَقَامٍ أَمِينٖ","ﰯ",[51]],[44,49,"فِي جَنَّٰتٖ وَعِيُونٖ","ﰰ",[52]],[44,50,"يَلۡبَسُونَ مِن سُندُسٖ وَإِسۡتَبۡرَقٖ مُّتَقَٰبِلِينَ","ﰱ",[53]],[44,51,"كَذَٰلِكَ وَزَوَّجۡنَٰهُمُۥ بِحُورٍ عِينٖ","ﰲ",[54]],[44,52,"يَدۡعُونَ فِيهَا بِكُلِّ فَٰكِهَةٍ ءَامِنِينَ","ﰳ",[55]],[44,53,"لَا يَذُوقُونَ فِيهَا ٱلۡمَوۡتَ إِلَّا ٱلۡمَوۡتَةَ ٱلۡأُولَىٰۖ وَوَقَىٰهُمُۥ عَذَابَ ٱلۡجَحِيمِ","ﰴ",[56]],[44,54,"فَضۡلٗا مِّن رَّبِّكَۚ ذَٰلِكَ هُوَ ٱلۡفَوۡزُ ٱلۡعَظِيمُ","ﰵ",[57]],[44,55,"فَإِنَّمَا يَسَّرۡنَٰهُۥ بِلِسَانِكَ لَعَلَّهُمُۥ يَتَذَكَّرُونَ","ﰶ",[58]],[44,56,"فَٱرۡتَقِبۡ إِنَّهُمُۥ مُرۡتَقِبُونَ","ﰷ",[59]]]