[[37,52,"يَقُولُ أَ۟نَّكَ لَمِنَ ٱلۡمُصَدِّقِينَ","ﰳ",[52]],[37,53,"أَ۟ذَا مُتۡنَا وَكُنَّا تُرَابٗا وَعِظَٰمًا أَ۟نَّا لَمَدِينُونَ","ﰴ",[53]],[37,54,"قَالَ هَلۡ أَنتُمُۥ مُطَّلِعُونَ","ﰵ",[54]],[37,55,"فَٱطَّلَعَ فَرَءَاهُۥ فِي سَوَآءِ ٱلۡجَحِيمِ","ﰶ",[55]],[37,56,"قَالَ تَٱللَّهِ إِن كِدتَّ لَتُرۡدِينِ","ﰷ",[56]],[37,57,"وَلَوۡلَا نِعۡمَةُ رَبِّي لَكُنتُ مِنَ ٱلۡمُحۡضَرِينَ","ﰸ",[57]],[37,58,"أَفَمَا نَحۡنُ بِمَيِّتِينَ","ﰹ",[58]],[37,59,"إِلَّا مَوۡتَتَنَا ٱلۡأُولَىٰ وَمَا نَحۡنُ بِمُعَذَّبِينَ","ﰺ",[59]],[37,60,"إِنَّ هَٰذَا لَهُوَ ٱلۡفَوۡزُ ٱلۡعَظِيمُ","ﰻ",[60]],[37,61,"لِمِثۡلِ هَٰذَا فَلۡيَعۡمَلِ ٱلۡعَٰمِلُونَ","ﰼ",[61]],[37,62,"أَذَٰلِكَ خَيۡرٞ نُّزُلًا أَمۡ شَجَرَةُ ٱلزَّقُّومِ","ﰽ",[62]],[37,63,"إِنَّا جَعَلۡنَٰهَا فِتۡنَةٗ لِّلظَّٰلِمِينَ","ﰾ",[63]],[37,64,"إِنَّهَا شَجَرَةٞ تَخۡرُجُ فِي أَصۡلِ ٱلۡجَحِيمِ","ﰿ",[64]],[37,65,"طَلۡعُهَا كَأَنَّهُۥ رُءُوسُ ٱلشَّيَٰطِينِ","ﱀ",[65]],[37,66,"فَإِنَّهُمُۥ لَأٓكِلُونَ مِنۡهَا فَمَالِــُٔونَ مِنۡهَا ٱلۡبُطُونَ","ﱁ",[66]],[37,67,"ثُمَّ إِنَّ لَهُمُۥ عَلَيۡهَا لَشَوۡبٗا مِّنۡ حَمِيمٖ","ﱂ",[67]],[37,68,"ثُمَّ إِنَّ مَرۡجِعَهُمُۥ لَإِلَى ٱلۡجَحِيمِ","ﱃ",[68]],[37,69,"إِنَّهُمُۥ أَلۡفَوۡاْ ءَابَآءَهُمُۥ ضَآلِّينَ","ﱄ",[69]],[37,70,"فَهُمُۥ عَلَىٰ ءَاثَٰرِهِمُۥ يُهۡرَعُونَ","ﱅ",[70]],[37,71,"وَلَقَدۡ ضَلَّ قَبۡلَهُمُۥ أَكۡثَرُ ٱلۡأَوَّلِينَ","ﱆ",[71]],[37,72,"وَلَقَدۡ أَرۡسَلۡنَا فِيهِمُۥ مُنذِرِينَ","ﱇ",[72]],[37,73,"فَٱنظُرۡ كَيۡفَ كَانَ عَٰقِبَةُ ٱلۡمُنذَرِينَ","ﱈ",[73]],[37,74,"إِلَّا عِبَادَ ٱللَّهِ ٱلۡمُخۡلِصِينَ","ﱉ",[74]],[37,75,"وَلَقَدۡ نَادَىٰنَا نُوحٞ فَلَنِعۡمَ ٱلۡمُجِيبُونَ","ﱊ",[75]],[37,76,"وَنَجَّيۡنَٰهُۥ وَأَهۡلَهُۥ مِنَ ٱلۡكَرۡبِ ٱلۡعَظِيمِ","ﱋ",[76]]]