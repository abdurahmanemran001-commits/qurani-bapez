[[53,44,"وَأَنَّهُۥ خَلَقَ ٱلزَّوۡجَيۡنِ ٱلذَّكَرَ وَٱلۡأُنثَىٰ","ﰫ",[45]],[53,45,"مِن نُّطۡفَةٍ إِذَا تُمۡنَىٰ","ﰬ",[46]],[53,46,"وَأَنَّ عَلَيۡهِ ٱلنَّشَآءَةَ ٱلۡأُخۡرَىٰ","ﰭ",[47]],[53,47,"وَأَنَّهُۥ هُوَ أَغۡنَىٰ وَأَقۡنَىٰ","ﰮ",[48]],[53,48,"وَأَنَّهُۥ هُوَ رَبُّ ٱلشِّعۡرَىٰ","ﰯ",[49]],[53,49,"وَأَنَّهُۥ أَهۡلَكَ عَادًا ٱلۡأُولَىٰ","ﰰ",[50]],[53,50,"وَثَمُودٗا فَمَا أَبۡقَىٰ","ﰱ",[51]],[53,51,"وَقَوۡمَ نُوحٖ مِّن قَبۡلُۖ إِنَّهُمُۥ كَانُواْ هُمُۥ أَظۡلَمَ وَأَطۡغَىٰ","ﰲ",[52]],[53,52,"وَٱلۡمُؤۡتَفِكَةَ أَهۡوَىٰ","ﰳ",[53]],[53,53,"فَغَشَّىٰهَا مَا غَشَّىٰ","ﰴ",[54]],[53,54,"فَبِأَيِّ ءَالَآءِ رَبِّكَ تَتَمَارَىٰ","ﰵ",[55]],[53,55,"هَٰذَا نَذِيرٞ مِّنَ ٱلنُّذُرِ ٱلۡأُولَىٰ","ﰶ",[56]],[53,56,"أَزِفَتِ ٱلۡأٓزِفَةُ","ﰷ",[57]],[53,57,"لَيۡسَ لَهَا مِن دُونِ ٱللَّهِ كَاشِفَةٌ","ﰸ",[58]],[53,58,"أَفَمِنۡ هَٰذَا ٱلۡحَدِيثِ تَعۡجَبُونَ","ﰹ",[59]],[53,59,"وَتَضۡحَكُونَ وَلَا تَبۡكُونَ","ﰺ",[60]],[53,60,"وَأَنتُمُۥ سَٰمِدُونَ","ﰻ",[61]],[53,61,"فَٱسۡجُدُواْۤ لِلَّهِۤ وَٱعۡبُدُواْ۩","ﰼ",[62]],[54,1,"ٱقۡتَرَبَتِ ٱلسَّاعَةُ وَٱنشَقَّ ٱلۡقَمَرُ","ﰀ",[1]],[54,2,"وَإِن يَرَوۡاْ ءَايَةٗ يُعۡرِضُواْ وَيَقُولُواْ سِحۡرٞ مُّسۡتَمِرّٞ","ﰁ",[2]],[54,3,"وَكَذَّبُواْ وَٱتَّبَعُواْ أَهۡوَآءَهُمُۥۚ وَكُلُّ أَمۡرٖ مُّسۡتَقِرّٞ","ﰂ",[3]],[54,4,"وَلَقَدۡ جَآءَهُمُۥ مِنَ ٱلۡأَنۢبَآءِ مَا فِيهِۦ مُزۡدَجَرٌ","ﰃ",[4]],[54,5,"حِكۡمَةُۢ بَٰلِغَةٞۖ فَمَا تُغۡنِ ٱلنُّذُرُ","ﰄ",[5]],[54,6,"فَتَوَلَّ عَنۡهُمُۥۘ يَوۡمَ يَدۡعُ ٱلدَّاعِ إِلَىٰ شَيۡءٖ نُّكۡرٍ","ﰅ",[6]]]