[[100,6,"إِنَّ ٱلۡإِنسَٰنَ لِرَبِّهِۦ لَكَنُودٞ","ﰅ",[6]],[100,7,"وَإِنَّهُۥ عَلَىٰ ذَٰلِكَ لَشَهِيدٞ","ﰆ",[7]],[100,8,"وَإِنَّهُۥ لِحُبِّ ٱلۡخَيۡرِ لَشَدِيدٌ","ﰇ",[8]],[100,9,"۞أَفَلَا يَعۡلَمُ إِذَا بُعۡثِرَ مَا فِي ٱلۡقُبُورِ","ﰈ",[9]],[100,10,"وَحُصِّلَ مَا فِي ٱلصُّدُورِ","ﰉ",[10]],[100,11,"إِنَّ رَبَّهُمُۥ بِهِمُۥ يَوۡمَئِذٖ لَّخَبِيرُۢ","ﰊ",[11]],[101,1,"ٱلۡقَارِعَةُ مَا ٱلۡقَارِعَةُ","ﰀ",[1,2]],[101,2,"وَمَا أَدۡرَىٰكَ مَا ٱلۡقَارِعَةُ","ﰁ",[3]],[101,3,"يَوۡمَ يَكُونُ ٱلنَّاسُ كَٱلۡفَرَاشِ ٱلۡمَبۡثُوثِ","ﰂ",[4]],[101,4,"وَتَكُونُ ٱلۡجِبَالُ كَٱلۡعِهۡنِ ٱلۡمَنفُوشِ","ﰃ",[5]],[101,5,"فَأَمَّا مَن ثَقُلَتۡ مَوَٰزِينُهُۥ","ﰄ",[6]],[101,6,"فَهُوَ فِي عِيشَةٖ رَّاضِيَةٖ","ﰅ",[7]],[101,7,"وَأَمَّا مَنۡ خَفَّتۡ مَوَٰزِينُهُۥ","ﰆ",[8]],[101,8,"فَأُمُّهُۥ هَاوِيَةٞ","ﰇ",[9]],[101,9,"وَمَا أَدۡرَىٰكَ مَا هِيَهۡ","ﰈ",[10]],[101,10,"نَارٌ حَامِيَةُۢ","ﰉ",[11]],[102,1,"أَلۡهَىٰكُمُ ٱلتَّكَاثُرُ","ﰀ",[1]],[102,2,"حَتَّىٰ زُرۡتُمُ ٱلۡمَقَابِرَ","ﰁ",[2]],[102,3,"كَلَّا سَوۡفَ تَعۡلَمُونَ","ﰂ",[3]],[102,4,"ثُمَّ كَلَّا سَوۡفَ تَعۡلَمُونَ","ﰃ",[4]],[102,5,"كَلَّا لَوۡ تَعۡلَمُونَ عِلۡمَ ٱلۡيَقِينِ","ﰄ",[5]],[102,6,"لَتَرَوُنَّ ٱلۡجَحِيمَ","ﰅ",[6]],[102,7,"ثُمَّ لَتَرَوُنَّهَا عَيۡنَ ٱلۡيَقِينِ","ﰆ",[7]],[102,8,"ثُمَّ لَتُسۡــَٔلُنَّ يَوۡمَئِذٍ عَنِ ٱلنَّعِيمِ","ﰇ",[8]]]