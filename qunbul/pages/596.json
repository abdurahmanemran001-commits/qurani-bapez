[[92,10,"فَسَنُيَسِّرُهُۥ لِلۡعُسۡرَىٰ","ﰉ",[10]],[92,11,"وَمَا يُغۡنِي عَنۡهُۥ مَالُهُۥ إِذَا تَرَدَّىٰ","ﰊ",[11]],[92,12,"إِنَّ عَلَيۡنَا لَلۡهُدَىٰ","ﰋ",[12]],[92,13,"وَإِنَّ لَنَا لَلۡأٓخِرَةَ وَٱلۡأُولَىٰ","ﰌ",[13]],[92,14,"فَأَنذَرۡتُكُمُۥ نَارٗا تَلَظَّىٰ","ﰍ",[14]],[92,15,"لَا يَصۡلَىٰهَا إِلَّا ٱلۡأَشۡقَى","ﰎ",[15]],[92,16,"ٱلَّذِي كَذَّبَ وَتَوَلَّىٰ","ﰏ",[16]],[92,17,"وَسَيُجَنَّبُهَا ٱلۡأَتۡقَى","ﰐ",[17]],[92,18,"ٱلَّذِي يُؤۡتِي مَالَهُۥ يَتَزَكَّىٰ","ﰑ",[18]],[92,19,"وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعۡمَةٖ تُجۡزَىٰ","ﰒ",[19]],[92,20,"إِلَّا ٱبۡتِغَآءَ وَجۡهِ رَبِّهِ ٱلۡأَعۡلَىٰ","ﰓ",[20]],[92,21,"وَلَسَوۡفَ يَرۡضَىٰ","ﰔ",[21]],[93,1,"وَٱلضُّحَىٰ","ﰀ",[1]],[93,2,"وَٱلَّيۡلِ إِذَا سَجَىٰ","ﰁ",[2]],[93,3,"مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ","ﰂ",[3]],[93,4,"وَلَلۡأٓخِرَةُ خَيۡرٞ لَّكَ مِنَ ٱلۡأُولَىٰ","ﰃ",[4]],[93,5,"وَلَسَوۡفَ يُعۡطِيكَ رَبُّكَ فَتَرۡضَىٰ","ﰄ",[5]],[93,6,"أَلَمۡ يَجِدۡكَ يَتِيمٗا فَــَٔاوَىٰ","ﰅ",[6]],[93,7,"وَوَجَدَكَ ضَآلّٗا فَهَدَىٰ","ﰆ",[7]],[93,8,"وَوَجَدَكَ عَآئِلٗا فَأَغۡنَىٰ","ﰇ",[8]],[93,9,"فَأَمَّا ٱلۡيَتِيمَ فَلَا تَقۡهَرۡ","ﰈ",[9]],[93,10,"وَأَمَّا ٱلسَّآئِلَ فَلَا تَنۡهَرۡ","ﰉ",[10]],[93,11,"وَأَمَّا بِنِعۡمَةِ رَبِّكَ فَحَدِّثۡ","ﰊ",[11]],[94,1,"أَلَمۡ نَشۡرَحۡ لَكَ صَدۡرَكَ","ﰀ",[1]],[94,2,"وَوَضَعۡنَا عَنكَ وِزۡرَكَ","ﰁ",[2]]]