[[56,19,"يَطُوفُ عَلَيۡهِمُۥ وِلۡدَٰنٞ مُّخَلَّدُونَ","ﰒ",[17]],[56,20,"بِأَكۡوَابٖ وَأَبَارِيقَ","ﰓ",[18]],[56,21,"وَكَأۡسٖ مِّن مَّعِينٖ","ﰔ",[18]],[56,22,"لَّا يُصَدَّعُونَ عَنۡهَا وَلَا يُنزَفُونَ","ﰕ",[19]],[56,23,"وَفَٰكِهَةٖ مِّمَّا يَتَخَيَّرُونَ","ﰖ",[20]],[56,24,"وَلَحۡمِ طَيۡرٖ مِّمَّا يَشۡتَهُونَ","ﰗ",[21]],[56,25,"وَحُورٌ عِينٞ كَأَمۡثَٰلِ ٱللُّؤۡلُوِٕ ٱلۡمَكۡنُونِ","ﰘ",[22,23]],[56,26,"جَزَآءَۢ بِمَا كَانُواْ يَعۡمَلُونَ","ﰙ",[24]],[56,27,"لَا يَسۡمَعُونَ فِيهَا لَغۡوٗا وَلَا تَأۡثِيمًا إِلَّا قِيلٗا سَلَٰمٗا سَلَٰمٗا","ﰚ",[25,26]],[56,28,"وَأَصۡحَٰبُ ٱلۡيَمِينِ","ﰛ",[27]],[56,29,"مَا أَصۡحَٰبُ ٱلۡيَمِينِ","ﰜ",[27]],[56,30,"فِي سِدۡرٖ مَّخۡضُودٖ","ﰝ",[28]],[56,31,"وَطَلۡحٖ مَّنضُودٖ","ﰞ",[29]],[56,32,"وَظِلّٖ مَّمۡدُودٖ","ﰟ",[30]],[56,33,"وَمَآءٖ مَّسۡكُوبٖ","ﰠ",[31]],[56,34,"وَفَٰكِهَةٖ كَثِيرَةٖ","ﰡ",[32]],[56,35,"لَّا مَقۡطُوعَةٖ وَلَا مَمۡنُوعَةٖ","ﰢ",[33]],[56,36,"وَفُرُشٖ مَّرۡفُوعَةٍ","ﰣ",[34]],[56,37,"إِنَّا أَنشَأۡنَٰهُنَّ إِنشَآءٗ","ﰤ",[35]],[56,38,"فَجَعَلۡنَٰهُنَّ أَبۡكَارًا","ﰥ",[36]],[56,39,"عُرُبًا أَتۡرَابٗا","ﰦ",[37]],[56,40,"لِّأَصۡحَٰبِ ٱلۡيَمِينِ","ﰧ",[38]],[56,41,"ثُلَّةٞ مِّنَ ٱلۡأَوَّلِينَ","ﰨ",[39]],[56,42,"وَثُلَّةٞ مِّنَ ٱلۡأٓخِرِينَ","ﰩ",[40]],[56,43,"وَأَصۡحَٰبُ ٱلشِّمَالِ","ﰪ",[41]],[56,44,"مَا أَصۡحَٰبُ ٱلشِّمَالِ","ﰫ",[41]],[56,45,"فِي سَمُومٖ وَحَمِيمٖ وَظِلّٖ مِّن يَحۡمُومٖ","ﰬ",[42,43]],[56,46,"لَّا بَارِدٖ وَلَا كَرِيمٍ","ﰭ",[44]],[56,47,"إِنَّهُمُۥ كَانُواْ قَبۡلَ ذَٰلِكَ مُتۡرَفِينَ","ﰮ",[45]],[56,48,"وَكَانُواْ يُصِرُّونَ عَلَى ٱلۡحِنثِ ٱلۡعَظِيمِ","ﰯ",[46]],[56,49,"وَكَانُواْ يَقُولُونَ","ﰰ",[47]],[56,50,"أَى۪ذَا مُتۡنَا وَكُنَّا تُرَابٗا وَعِظَٰمًا أَ۟نَّا لَمَبۡعُوثُونَ","ﰱ",[47]],[56,51,"أَوَءَابَآؤُنَا ٱلۡأَوَّلُونَ","ﰲ",[48]],[56,52,"قُلۡ إِنَّ ٱلۡأَوَّلِينَ وَٱلۡأٓخِرِينَ","ﰳ",[49]],[56,53,"لَمَجۡمُوعُونَ إِلَىٰ مِيقَٰتِ يَوۡمٖ مَّعۡلُومٖ","ﰴ",[50]]]