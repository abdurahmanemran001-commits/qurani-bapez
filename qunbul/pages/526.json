[[53,1,"وَٱلنَّجۡمِ إِذَا هَوَىٰ","ﰀ",[1]],[53,2,"مَا ضَلَّ صَاحِبُكُمُۥ وَمَا غَوَىٰ","ﰁ",[2]],[53,3,"وَمَا يَنطِقُ عَنِ ٱلۡهَوَىٰ","ﰂ",[3]],[53,4,"إِنۡ هُوَ إِلَّا وَحۡيٞ يُوحَىٰ","ﰃ",[4]],[53,5,"عَلَّمَهُۥ شَدِيدُ ٱلۡقُوَىٰ","ﰄ",[5]],[53,6,"ذُو مِرَّةٖ فَٱسۡتَوَىٰ","ﰅ",[6]],[53,7,"وَهُوَ بِٱلۡأُفُقِ ٱلۡأَعۡلَىٰ","ﰆ",[7]],[53,8,"ثُمَّ دَنَا فَتَدَلَّىٰ","ﰇ",[8]],[53,9,"فَكَانَ قَابَ قَوۡسَيۡنِ أَوۡ أَدۡنَىٰ","ﰈ",[9]],[53,10,"فَأَوۡحَىٰ إِلَىٰ عَبۡدِهِۦ مَا أَوۡحَىٰ","ﰉ",[10]],[53,11,"مَا كَذَبَ ٱلۡفُؤَادُ مَا رَأَىٰ","ﰊ",[11]],[53,12,"أَفَتُمَٰرُونَهُۥ عَلَىٰ مَا يَرَىٰ","ﰋ",[12]],[53,13,"وَلَقَدۡ رَءَاهُۥ نَزۡلَةً أُخۡرَىٰ","ﰌ",[13]],[53,14,"عِندَ سِدۡرَةِ ٱلۡمُنتَهَىٰ","ﰍ",[14]],[53,15,"عِندَهَا جَنَّةُ ٱلۡمَأۡوَىٰ","ﰎ",[15]],[53,16,"إِذۡ يَغۡشَى ٱلسِّدۡرَةَ مَا يَغۡشَىٰ","ﰏ",[16]],[53,17,"مَا زَاغَ ٱلۡبَصَرُ وَمَا طَغَىٰ","ﰐ",[17]],[53,18,"لَقَدۡ رَأَىٰ مِنۡ ءَايَٰتِ رَبِّهِ ٱلۡكُبۡرَىٰ","ﰑ",[18]],[53,19,"أَفَرَءَيۡتُمُ ٱللَّٰتَ وَٱلۡعُزَّىٰ","ﰒ",[19]],[53,20,"وَمَنَوٰٓءَةَ ٱلثَّالِثَةَ ٱلۡأُخۡرَىٰ","ﰓ",[20]],[53,21,"أَلَكُمُ ٱلذَّكَرُ وَلَهُ ٱلۡأُنثَىٰ","ﰔ",[21]],[53,22,"تِلۡكَ إِذٗا قِسۡمَةٞ ضِئۡزَىٰ","ﰕ",[22]],[53,23,"إِنۡ هِيَ إِلَّا أَسۡمَآءٞ سَمَّيۡتُمُوهَا أَنتُمُۥ وَءَابَآؤُكُمُۥ مَا أَنزَلَ ٱللَّهُ بِهَا مِن سُلۡطَٰنٍۚ إِن يَتَّبِعُونَ إِلَّا ٱلظَّنَّ وَمَا تَهۡوَى ٱلۡأَنفُسُۖ وَلَقَدۡ جَآءَهُمُۥ مِن رَّبِّهِمُ ٱلۡهُدَىٰ","ﰖ",[23]],[53,24,"أَمۡ لِلۡإِنسَٰنِ مَا تَمَنَّىٰ","ﰗ",[24]],[53,25,"فَلِلَّهِ ٱلۡأٓخِرَةُ وَٱلۡأُولَىٰ","ﰘ",[25]],[53,26,"۞وَكَم مِّن مَّلَكٖ فِي ٱلسَّمَٰوَٰتِ لَا تُغۡنِي شَفَٰعَتُهُمُۥ شَيۡــًٔا إِلَّا مِنۢ بَعۡدِ أَن يَأۡذَنَ ٱللَّهُ لِمَن يَشَآءُ وَيَرۡضَىٰ","ﰙ",[26]]]