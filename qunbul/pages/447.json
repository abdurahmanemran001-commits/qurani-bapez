[[37,25,"مَا لَكُمُۥ لَا تَنَاصَرُونَ","ﰘ",[25]],[37,26,"بَلۡ هُمُ ٱلۡيَوۡمَ مُسۡتَسۡلِمُونَ","ﰙ",[26]],[37,27,"وَأَقۡبَلَ بَعۡضُهُمُۥ عَلَىٰ بَعۡضٖ يَتَسَآءَلُونَ","ﰚ",[27]],[37,28,"قَالُواْ إِنَّكُمُۥ كُنتُمُۥ تَأۡتُونَنَا عَنِ ٱلۡيَمِينِ","ﰛ",[28]],[37,29,"قَالُواْ بَل لَّمۡ تَكُونُواْ مُؤۡمِنِينَ","ﰜ",[29]],[37,30,"وَمَا كَانَ لَنَا عَلَيۡكُمُۥ مِن سُلۡطَٰنِۭۖ بَلۡ كُنتُمُۥ قَوۡمٗا طَٰغِينَ","ﰝ",[30]],[37,31,"فَحَقَّ عَلَيۡنَا قَوۡلُ رَبِّنَاۖ إِنَّا لَذَآئِقُونَ","ﰞ",[31]],[37,32,"فَأَغۡوَيۡنَٰكُمُۥ إِنَّا كُنَّا غَٰوِينَ","ﰟ",[32]],[37,33,"فَإِنَّهُمُۥ يَوۡمَئِذٖ فِي ٱلۡعَذَابِ مُشۡتَرِكُونَ","ﰠ",[33]],[37,34,"إِنَّا كَذَٰلِكَ نَفۡعَلُ بِٱلۡمُجۡرِمِينَ","ﰡ",[34]],[37,35,"إِنَّهُمُۥ كَانُواْ إِذَا قِيلَ لَهُمُۥ لَا إِلَٰهَ إِلَّا ٱللَّهُ يَسۡتَكۡبِرُونَ","ﰢ",[35]],[37,36,"وَيَقُولُونَ أَى۪نَّا لَتَارِكُواْ ءَالِهَتِنَا لِشَاعِرٖ مَّجۡنُونِۭ","ﰣ",[36]],[37,37,"بَلۡ جَآءَ بِٱلۡحَقِّ وَصَدَّقَ ٱلۡمُرۡسَلِينَ","ﰤ",[37]],[37,38,"إِنَّكُمُۥ لَذَآئِقُواْ ٱلۡعَذَابِ ٱلۡأَلِيمِ","ﰥ",[38]],[37,39,"وَمَا تُجۡزَوۡنَ إِلَّا مَا كُنتُمُۥ تَعۡمَلُونَ","ﰦ",[39]],[37,40,"إِلَّا عِبَادَ ٱللَّهِ ٱلۡمُخۡلِصِينَ","ﰧ",[40]],[37,41,"أُوْلَٰٓئِكَ لَهُمُۥ رِزۡقٞ مَّعۡلُومٞ","ﰨ",[41]],[37,42,"فَوَٰكِهُ وَهُمُۥ مُكۡرَمُونَ","ﰩ",[42]],[37,43,"فِي جَنَّٰتِ ٱلنَّعِيمِ","ﰪ",[43]],[37,44,"عَلَىٰ سُرُرٖ مُّتَقَٰبِلِينَ","ﰫ",[44]],[37,45,"يُطَافُ عَلَيۡهِمُۥ بِكَأۡسٖ مِّن مَّعِينِۭ","ﰬ",[45]],[37,46,"بَيۡضَآءَ لَذَّةٖ لِّلشَّٰرِبِينَ","ﰭ",[46]],[37,47,"لَا فِيهَا غَوۡلٞ وَلَا هُمُۥ عَنۡهَا يُنزَفُونَ","ﰮ",[47]],[37,48,"وَعِندَهُمُۥ قَٰصِرَٰتُ ٱلطَّرۡفِ عِينٞ","ﰯ",[48]],[37,49,"كَأَنَّهُنَّ بَيۡضٞ مَّكۡنُونٞ","ﰰ",[49]],[37,50,"فَأَقۡبَلَ بَعۡضُهُمُۥ عَلَىٰ بَعۡضٖ يَتَسَآءَلُونَ","ﰱ",[50]],[37,51,"قَالَ قَآئِلٞ مِّنۡهُمُۥ إِنِّي كَانَ لِي قَرِينٞ","ﰲ",[51]]]