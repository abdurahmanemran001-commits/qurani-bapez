[[79,17,"ٱذۡهَبۡ إِلَىٰ فِرۡعَوۡنَ إِنَّهُۥ طَغَىٰ","ﰐ",[17]],[79,18,"فَقُلۡ هَل لَّكَ إِلَىٰ أَن تَزَّكَّىٰ","ﰑ",[18]],[79,19,"وَأَهۡدِيَكَ إِلَىٰ رَبِّكَ فَتَخۡشَىٰ","ﰒ",[19]],[79,20,"فَأَرَىٰهُ ٱلۡأٓيَةَ ٱلۡكُبۡرَىٰ","ﰓ",[20]],[79,21,"فَكَذَّبَ وَعَصَىٰ","ﰔ",[21]],[79,22,"ثُمَّ أَدۡبَرَ يَسۡعَىٰ","ﰕ",[22]],[79,23,"فَحَشَرَ فَنَادَىٰ","ﰖ",[23]],[79,24,"فَقَالَ أَنَا۠ رَبُّكُمُ ٱلۡأَعۡلَىٰ","ﰗ",[24]],[79,25,"فَأَخَذَهُ ٱللَّهُ نَكَالَ ٱلۡأٓخِرَةِ وَٱلۡأُولَىٰ","ﰘ",[25]],[79,26,"إِنَّ فِي ذَٰلِكَ لَعِبۡرَةٗ لِّمَن يَخۡشَىٰ","ﰙ",[26]],[79,27,"ءَا۬نتُمُۥ أَشَدُّ خَلۡقًا أَمِ ٱلسَّمَآءُۚ بَنَىٰهَا","ﰚ",[27]],[79,28,"رَفَعَ سَمۡكَهَا فَسَوَّىٰهَا","ﰛ",[28]],[79,29,"وَأَغۡطَشَ لَيۡلَهَا وَأَخۡرَجَ ضُحَىٰهَا","ﰜ",[29]],[79,30,"وَٱلۡأَرۡضَ بَعۡدَ ذَٰلِكَ دَحَىٰهَا","ﰝ",[30]],[79,31,"أَخۡرَجَ مِنۡهَا مَآءَهَا وَمَرۡعَىٰهَا","ﰞ",[31]],[79,32,"وَٱلۡجِبَالَ أَرۡسَىٰهَا","ﰟ",[32]],[79,33,"مَتَٰعٗا لَّكُمُۥ وَلِأَنۡعَٰمِكُمُۥ","ﰠ",[33]],[79,34,"فَإِذَا جَآءَتِ ٱلطَّآمَّةُ ٱلۡكُبۡرَىٰ","ﰡ",[34]],[79,35,"يَوۡمَ يَتَذَكَّرُ ٱلۡإِنسَٰنُ مَا سَعَىٰ","ﰢ",[35]],[79,36,"وَبُرِّزَتِ ٱلۡجَحِيمُ لِمَن يَرَىٰ","ﰣ",[36]],[79,37,"فَأَمَّا مَن طَغَىٰ وَءَاثَرَ ٱلۡحَيَوٰةَ ٱلدُّنۡيَا","ﰤ",[37,38]],[79,38,"فَإِنَّ ٱلۡجَحِيمَ هِيَ ٱلۡمَأۡوَىٰ","ﰥ",[39]],[79,39,"وَأَمَّا مَنۡ خَافَ مَقَامَ رَبِّهِۦ وَنَهَى ٱلنَّفۡسَ عَنِ ٱلۡهَوَىٰ","ﰦ",[40]],[79,40,"فَإِنَّ ٱلۡجَنَّةَ هِيَ ٱلۡمَأۡوَىٰ","ﰧ",[41]],[79,41,"يَسۡــَٔلُونَكَ عَنِ ٱلسَّاعَةِ أَيَّانَ مُرۡسَىٰهَا","ﰨ",[42]],[79,42,"فِيمَ أَنتَ مِن ذِكۡرَىٰهَا","ﰩ",[43]],[79,43,"إِلَىٰ رَبِّكَ مُنتَهَىٰهَا","ﰪ",[44]],[79,44,"إِنَّمَا أَنتَ مُنذِرُ مَن يَخۡشَىٰهَا","ﰫ",[45]],[79,45,"كَأَنَّهُمُۥ يَوۡمَ يَرَوۡنَهَا لَمۡ يَلۡبَثُواْ إِلَّا عَشِيَّةً أَوۡ ضُحَىٰهَا","ﰬ",[46]]]