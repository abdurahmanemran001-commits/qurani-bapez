[[55,41,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","ﰨ",[42]],[55,42,"هَٰذِهِۦ جَهَنَّمُ اُ۬لَّتِي يُكَذِّبُ بِهَا اَ۬لۡمُجۡرِمُونَ","ﰩ",[43]],[55,43,"يَطُوفُونَ بَيۡنَهَا وَبَيۡنَ حَمِيمٍ ءَانٖ","ﰪ",[44]],[55,44,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","ﰫ",[45]],[55,45,"وَلِمَنۡ خَافَ مَقَامَ رَبِّهِۦ جَنَّتَانِ","ﰬ",[46]],[55,46,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","ﰭ",[47]],[55,47,"ذَوَاتَآ أَفۡنَانٖ","ﰮ",[48]],[55,48,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","ﰯ",[49]],[55,49,"فِيهِمَا عَيۡنَانِ تَجۡرِيَانِ","ﰰ",[50]],[55,50,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","ﰱ",[51]],[55,51,"فِيهِمَا مِن كُلِّ فَٰكِهَةٖ زَوۡجَانِ","ﰲ",[52]],[55,52,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","ﰳ",[53]],[55,53,"مُتَّكِــِٔينَ عَلَىٰ فُرُشِۢ بَطَآئِنُهَا مِنۡ إِسۡتَبۡرَقٖۚ وَجَنَى اَ۬لۡجَنَّتَيۡنِ دَانٖ","ﰴ",[54]],[55,54,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","ﰵ",[55]],[55,55,"فِيهِنَّ قَٰصِرَٰتُ اُ۬لطَّرۡفِ لَمۡ يَطۡمِثۡهُنَّ إِنسٞ قَبۡلَهُمۡ وَلَا جَآنّٞ","ﰶ",[56]],[55,56,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","ﰷ",[57]],[55,57,"كَأَنَّهُنَّ اَ۬لۡيَاقُوتُ وَاَلۡمَرۡجَانُ","ﰸ",[58]],[55,58,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","ﰹ",[59]],[55,59,"هَلۡ جَزَآءُ اُ۬لۡإِحۡسَٰنِ إِلَّا اَ۬لۡإِحۡسَٰنُ","ﰺ",[60]],[55,60,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","ﰻ",[61]],[55,61,"وَمِن دُونِهِمَا جَنَّتَانِ","ﰼ",[62]],[55,62,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","ﰽ",[63]],[55,63,"مُدۡهَآمَّتَانِ","ﰾ",[64]],[55,64,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","ﰿ",[65]],[55,65,"فِيهِمَا عَيۡنَانِ نَضَّاخَتَانِ","ﱀ",[66]],[55,66,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","ﱁ",[67]],[55,67,"فِيهِمَا فَٰكِهَةٞ وَنَخۡلٞ وَرُمَّانٞ","ﱂ",[68]],[55,68,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","ﱃ",[69]]]