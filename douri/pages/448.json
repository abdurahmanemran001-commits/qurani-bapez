[[37,52,"يَقُولُ أَٰ۟نَّكَ لَمِنَ اَ۬لۡمُصَدِّقِينَ","ﰳ",[52]],[37,53,"أَٰ۟ذَا مُتۡنَا وَكُنَّا تُرَابٗا وَعِظَٰمًا أَٰ۟نَّا لَمَدِينُونَ","ﰴ",[53]],[37,54,"قَالَ هَلۡ أَنتُم مُّطَّلِعُونَ","ﰵ",[54]],[37,55,"فَاَطَّلَعَ فَرَء۪اهُ فِي سَوَآءِ اِ۬لۡجَحِيمِ","ﰶ",[55]],[37,56,"قَالَ تَاَللَّهِ إِن كِدتَّ لَتُرۡدِينِ","ﰷ",[56]],[37,57,"وَلَوۡلَا نِعۡمَةُ رَبِّي لَكُنتُ مِنَ اَ۬لۡمُحۡضَرِينَ","ﰸ",[57]],[37,58,"أَفَمَا نَحۡنُ بِمَيِّتِينَ","ﰹ",[58]],[37,59,"إِلَّا مَوۡتَتَنَا اَ۬لۡأُولۭيٰ وَمَا نَحۡنُ بِمُعَذَّبِينَ","ﰺ",[59]],[37,60,"إِنَّ هَٰذَا لَهۡوَ اَ۬لۡفَوۡزُ اُ۬لۡعَظِيمُ","ﰻ",[60]],[37,61,"لِمِثۡلِ هَٰذَا فَلۡيَعۡمَلِ اِ۬لۡعَٰمِلُونَ","ﰼ",[61]],[37,62,"أَذَٰلِكَ خَيۡرٞ نُّزُلًا أَمۡ شَجَرَةُ اُ۬لزَّقُّومِ","ﰽ",[62]],[37,63,"إِنَّا جَعَلۡنَٰهَا فِتۡنَةٗ لِّلظَّٰلِمِينَ","ﰾ",[63]],[37,64,"إِنَّهَا شَجَرَةٞ تَخۡرُجُ فِيٓ أَصۡلِ اِ۬لۡجَحِيمِ","ﰿ",[64]],[37,65,"طَلۡعُهَا كَأَنَّهُۥ رُءُوسُ اُ۬لشَّيَٰطِينِ","ﱀ",[65]],[37,66,"فَإِنَّهُمۡ لَأٓكِلُونَ مِنۡهَا فَمَالِــُٔونَ مِنۡهَا اَ۬لۡبُطُونَ","ﱁ",[66]],[37,67,"ثُمَّ إِنَّ لَهُمۡ عَلَيۡهَا لَشَوۡبٗا مِّنۡ حَمِيمٖ","ﱂ",[67]],[37,68,"ثُمَّ إِنَّ مَرۡجِعَهُمۡ لَإِاْلَى اَ۬لۡجَحِيمِ","ﱃ",[68]],[37,69,"إِنَّهُمۡ أَلۡفَوۡاْ ءَابَآءَهُمۡ ضَآلِّينَ","ﱄ",[69]],[37,70,"فَهُمۡ عَلَىٰٓ ءَاثٰ۪رِهِمۡ يُهۡرَعُونَ","ﱅ",[70]],[37,71,"وَلَقَد ضَّلَّ قَبۡلَهُمۡ أَكۡثَرُ اُ۬لۡأَوَّلِينَ","ﱆ",[71]],[37,72,"وَلَقَدۡ أَرۡسَلۡنَا فِيهِم مُّنذِرِينَ","ﱇ",[72]],[37,73,"فَاَنظُرۡ كَيۡفَ كَانَ عَٰقِبَةُ اُ۬لۡمُنذَرِينَ","ﱈ",[73]],[37,74,"إِلَّا عِبَادَ اَ۬للَّهِ اِ۬لۡمُخۡلِصِينَ","ﱉ",[74]],[37,75,"وَلَقَدۡ نَادَىٰنَا نُوحٞ فَلَنِعۡمَ اَ۬لۡمُجِيبُونَ","ﱊ",[75]],[37,76,"وَنَجَّيۡنَٰهُ وَأَهۡلَهُۥ مِنَ اَ۬لۡكَرۡبِ اِ۬لۡعَظِيمِ","ﱋ",[76]]]