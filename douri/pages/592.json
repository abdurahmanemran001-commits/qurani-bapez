[[87,11,"وَيَتَجَنَّبُهَا اَ۬لۡأَشۡقَى","ﰊ",[11]],[87,12,"اَ۬لَّذِي يَصۡلَى اَ۬لنَّارَ اَ۬لۡكُبۡر۪يٰ","ﰋ",[12]],[87,13,"ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحۡيۭيٰ","ﰌ",[13]],[87,14,"قَدۡ أَفۡلَحَ مَن تَزَكّۭيٰ","ﰍ",[14]],[87,15,"وَذَكَرَ اَ۪سۡمَ رَبِّهِۦ فَصَلّۭيٰ","ﰎ",[15]],[87,16,"بَلۡ يُؤۡثِرُونَ اَ۬لۡحَيَوٰةَ اَ۬لدُّنۡيۭا","ﰏ",[16]],[87,17,"وَاَلۡأٓخِرَةُ خَيۡرٞ وَأَبۡقۭيٰٓ","ﰐ",[17]],[87,18,"إِنَّ هَٰذَا لَفِي اِ۬لصُّحُفِ اِ۬لۡأُولۭيٰ","ﰑ",[18]],[87,19,"صُحُفِ إِبۡرَٰهِيمَ وَمُوسۭيٰ","ﰒ",[19]],[88,1,"هَلۡ أَتَىٰكَ حَدِيثُ اُ۬لۡغَٰشِيَةِ","ﰀ",[1]],[88,2,"وُجُوهٞ يَوۡمَئِذٍ خَٰشِعَةٌ","ﰁ",[2]],[88,3,"عَامِلَةٞ نَّاصِبَةٞ","ﰂ",[3]],[88,4,"تُصۡلَىٰ نَارًا حَامِيَةٗ","ﰃ",[4]],[88,5,"تُسۡقَىٰ مِنۡ عَيۡنٍ ءَانِيَةٖ","ﰄ",[5]],[88,6,"لَّيۡسَ لَهُمۡ طَعَامٌ إِلَّا مِن ضَرِيعٖ","ﰅ",[6]],[88,7,"لَّا يُسۡمِنُ وَلَا يُغۡنِي مِن جُوعٖ","ﰆ",[7]],[88,8,"وُجُوهٞ يَوۡمَئِذٖ نَّاعِمَةٞ","ﰇ",[8]],[88,9,"لِّسَعۡيِهَا رَاضِيَةٞ","ﰈ",[9]],[88,10,"فِي جَنَّةٍ عَالِيَةٖ","ﰉ",[10]],[88,11,"لَّا يُسۡمَعُ فِيهَا لَٰغِيَةٞ","ﰊ",[11]],[88,12,"فِيهَا عَيۡنٞ جَارِيَةٞ","ﰋ",[12]],[88,13,"فِيهَا سُرُرٞ مَّرۡفُوعَةٞ","ﰌ",[13]],[88,14,"وَأَكۡوَابٞ مَّوۡضُوعَةٞ","ﰍ",[14]],[88,15,"وَنَمَارِقُ مَصۡفُوفَةٞ","ﰎ",[15]],[88,16,"وَزَرَابِيُّ مَبۡثُوثَةٌ","ﰏ",[16]],[88,17,"أَفَلَا يَنظُرُونَ إِلَى اَ۬لۡإِبِلِ كَيۡفَ خُلِقَتۡ","ﰐ",[17]],[88,18,"وَإِلَى اَ۬لسَّمَآءِ كَيۡفَ رُفِعَتۡ","ﰑ",[18]],[88,19,"وَإِلَى اَ۬لۡجِبَالِ كَيۡفَ نُصِبَتۡ","ﰒ",[19]],[88,20,"وَإِلَى اَ۬لۡأَرۡضِ كَيۡفَ سُطِحَتۡ","ﰓ",[20]],[88,21,"فَذَكِّرۡ إِنَّمَآ أَنتَ مُذَكِّرٞ","ﰔ",[21]],[88,22,"لَّسۡتَ عَلَيۡهِم بِمُصَيۡطِرٍ","ﰕ",[22]]]