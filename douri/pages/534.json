[[55,69,"فِيهِنَّ خَيۡرَٰتٌ حِسَانٞ","ﱄ",[70]],[55,70,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","ﱅ",[71]],[55,71,"۞ حُورٞ مَّقۡصُورَٰتٞ فِي اِ۬لۡخِيَامِ","ﱆ",[72]],[55,72,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","ﱇ",[73]],[55,73,"لَمۡ يَطۡمِثۡهُنَّ إِنسٞ قَبۡلَهُمۡ وَلَا جَآنّٞ","ﱈ",[74]],[55,74,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","ﱉ",[75]],[55,75,"مُتَّكِــِٔينَ عَلَىٰ رَفۡرَفٍ خُضۡرٖ وَعَبۡقَرِيٍّ حِسَانٖ","ﱊ",[76]],[55,76,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","ﱋ",[77]],[55,77,"تَبَٰرَكَ اَ۪سۡمُ رَبِّكَ ذِي اِ۬لۡجَلَٰلِ وَاَلۡإِكۡرَامِ","ﱌ",[78]],[56,1,"إِذَا وَقَعَتِ اِ۬لۡوَاقِعَةُ","ﰀ",[1]],[56,2,"لَيۡسَ لِوَقۡعَتِهَا كَاذِبَةٌ","ﰁ",[2]],[56,3,"خَافِضَةٞ رَّافِعَةٌ","ﰂ",[3]],[56,4,"إِذَا رُجَّتِ اِ۬لۡأَرۡضُ رَجّٗا","ﰃ",[4]],[56,5,"وَبُسَّتِ اِ۬لۡجِبَالُ بَسّٗا","ﰄ",[5]],[56,6,"فَكَانَتۡ هَبَآءٗ مُّنۢبَثّٗا","ﰅ",[6]],[56,7,"وَكُنتُمۡ أَزۡوَٰجٗا ثَلَٰثَةٗ","ﰆ",[7]],[56,8,"فَأَصۡحَٰبُ اُ۬لۡمَيۡمَنَةِ","ﰇ",[8]],[56,9,"مَآ أَصۡحَٰبُ اُ۬لۡمَيۡمَنَةِ","ﰈ",[8]],[56,10,"وَأَصۡحَٰبُ اُ۬لۡمَشۡــَٔمَةِ","ﰉ",[9]],[56,11,"مَآ أَصۡحَٰبُ اُ۬لۡمَشۡــَٔمَةِ","ﰊ",[9]],[56,12,"وَاَلسَّٰبِقُونَ اَ۬لسَّٰبِقُونَ","ﰋ",[10]],[56,13,"أُوْلَٰٓئِكَ اَ۬لۡمُقَرَّبُونَ","ﰌ",[11]],[56,14,"فِي جَنَّٰتِ اِ۬لنَّعِيمِ","ﰍ",[12]],[56,15,"ثُلَّةٞ مِّنَ اَ۬لۡأَوَّلِينَ","ﰎ",[13]],[56,16,"وَقَلِيلٞ مِّنَ اَ۬لۡأٓخِرِينَ","ﰏ",[14]],[56,17,"عَلَىٰ سُرُرٖ مَّوۡضُونَةٖ","ﰐ",[15]],[56,18,"مُّتَّكِــِٔينَ عَلَيۡهَا مُتَقَٰبِلِينَ","ﰑ",[16]]]