[[74,48,"فَمَا تَنفَعُهُمۡ شَفَٰعَةُ اُ۬لشَّٰفِعِينَ","ﰯ",[48]],[74,49,"فَمَا لَهُمۡ عَنِ اِ۬لتَّذۡكِرَةِ مُعۡرِضِينَ","ﰰ",[49]],[74,50,"كَأَنَّهُمۡ حُمُرٞ مُّسۡتَنفِرَةٞ","ﰱ",[50]],[74,51,"فَرَّتۡ مِن قَسۡوَرَةِۢ","ﰲ",[51]],[74,52,"بَلۡ يُرِيدُ كُلُّ اُ۪مۡرِيٕٖ مِّنۡهُمۡ أَن يُؤۡتَىٰ صُحُفٗا مُّنَشَّرَةٗ","ﰳ",[52]],[74,53,"كَلَّاۖ بَل لَّا يَخَافُونَ اَ۬لۡأٓخِرَةَ","ﰴ",[53]],[74,54,"كَلَّآ إِنَّهُۥ تَذۡكِرَةٞ","ﰵ",[54]],[74,55,"فَمَن شَآءَ ذَكَرَهُۥ","ﰶ",[55]],[74,56,"وَمَا يَذۡكُرُونَ إِلَّآ أَن يَشَآءَ اَ۬للَّهُۚ هُوَ أَهۡلُ اُ۬لتَّقۡوۭيٰ وَأَهۡلُ اُ۬لۡمَغۡفِرَةِ","ﰷ",[56]],[75,1,"لَآ أُقۡسِمُ بِيَوۡمِ اِ۬لۡقِيَٰمَةِ","ﰀ",[1]],[75,2,"وَلَآ أُقۡسِمُ بِالنَّفۡسِ اِ۬للَّوَّامَةِ","ﰁ",[2]],[75,3,"أَيَحۡسِبُ اُ۬لۡإِنسَٰنُ أَلَّن نَّجۡمَعَ عِظَامَهُۥ","ﰂ",[3]],[75,4,"بَلَىٰ قَٰدِرِينَ عَلَىٰٓ أَن نُّسَوِّيَ بَنَانَهُۥ","ﰃ",[4]],[75,5,"بَلۡ يُرِيدُ اُ۬لۡإِنسَٰنُ لِيَفۡجُرَ أَمَامَهُۥ","ﰄ",[5]],[75,6,"يَسۡــَٔلُ أَيَّانَ يَوۡمُ اُ۬لۡقِيَٰمَةِ","ﰅ",[6]],[75,7,"فَإِذَا بَرِقَ اَ۬لۡبَصَرُ","ﰆ",[7]],[75,8,"وَخَسَفَ اَ۬لۡقَمَرُ","ﰇ",[8]],[75,9,"وَجُمِعَ اَ۬لشَّمۡسُ وَاَلۡقَمَرُ","ﰈ",[9]],[75,10,"يَقُولُ اُ۬لۡإِنسَٰنُ يَوۡمَئِذٍ أَيۡنَ اَ۬لۡمَفَرُّ","ﰉ",[10]],[75,11,"كَلَّا لَا وَزَرَ","ﰊ",[11]],[75,12,"إِلَىٰ رَبِّكَ يَوۡمَئِذٍ اِ۬لۡمُسۡتَقَرُّ","ﰋ",[12]],[75,13,"يُنَبَّؤُاْ اُ۬لۡإِنسَٰنُ يَوۡمَئِذِۢ بِمَا قَدَّمَ وَأَخَّرَ","ﰌ",[13]],[75,14,"بَلِ اِ۬لۡإِنسَٰنُ عَلَىٰ نَفۡسِهِۦ بَصِيرَةٞ","ﰍ",[14]],[75,15,"وَلَوۡ أَلۡقَىٰ مَعَاذِيرَهُۥ","ﰎ",[15]],[75,16,"لَا تُحَرِّكۡ بِهِۦ لِسَانَكَ لِتَعۡجَلَ بِهِۦٓ إِنَّ عَلَيۡنَا جَمۡعَهُۥ وَقُرۡءَانَهُۥ","ﰏ",[16,17]],[75,17,"فَإِذَا قَرَأۡنَٰهُ فَاَتَّبِعۡ قُرۡءَانَهُۥ","ﰐ",[18]],[75,18,"ثُمَّ إِنَّ عَلَيۡنَا بَيَانَهُۥ","ﰑ",[19]]]