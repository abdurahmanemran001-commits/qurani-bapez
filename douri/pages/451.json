[[37,127,"فَكَذَّبُوهُ فَإِنَّهُمۡ لَمُحۡضَرُونَ","ﱾ",[127]],[37,128,"إِلَّا عِبَادَ اَ۬للَّهِ اِ۬لۡمُخۡلِصِينَ","ﱿ",[128]],[37,129,"وَتَرَكۡنَا عَلَيۡهِ فِي اِ۬لۡأٓخِرِينَ","ﲀ",[129]],[37,130,"سَلَٰمٌ عَلَىٰٓ إِلۡ يَاسِينَ","ﲁ",[130]],[37,131,"إِنَّا كَذَٰلِكَ نَجۡزِي اِ۬لۡمُحۡسِنِينَ","ﲂ",[131]],[37,132,"إِنَّهُۥ مِنۡ عِبَادِنَا اَ۬لۡمُؤۡمِنِينَ","ﲃ",[132]],[37,133,"وَإِنَّ لُوطٗا لَّمِنَ اَ۬لۡمُرۡسَلِينَ","ﲄ",[133]],[37,134,"إِذۡ نَجَّيۡنَٰهُ وَأَهۡلَهُۥٓ أَجۡمَعِينَ","ﲅ",[134]],[37,135,"إِلَّا عَجُوزٗا فِي اِ۬لۡغَٰبِرِينَ","ﲆ",[135]],[37,136,"ثُمَّ دَمَّرۡنَا اَ۬لۡأٓخَرِينَ","ﲇ",[136]],[37,137,"وَإِنَّكُمۡ لَتَمُرُّونَ عَلَيۡهِم مُّصۡبِحِينَ","ﲈ",[137]],[37,138,"وَبِالَّيۡلِۗ أَفَلَا تَعۡقِلُونَ","ﲉ",[138]],[37,139,"وَإِنَّ يُونُسَ لَمِنَ اَ۬لۡمُرۡسَلِينَ","ﲊ",[139]],[37,140,"إِذۡ أَبَقَ إِلَى اَ۬لۡفُلۡكِ اِ۬لۡمَشۡحُونِ","ﲋ",[140]],[37,141,"فَسَاهَمَ فَكَانَ مِنَ اَ۬لۡمُدۡحَضِينَ","ﲌ",[141]],[37,142,"فَاَلۡتَقَمَهُ اُ۬لۡحُوتُ وَهۡوَ مُلِيمٞ","ﲍ",[142]],[37,143,"فَلَوۡلَآ أَنَّهُۥ كَانَ مِنَ اَ۬لۡمُسَبِّحِينَ","ﲎ",[143]],[37,144,"لَلَبِثَ فِي بَطۡنِهِۦٓ إِلَىٰ يَوۡمِ يُبۡعَثُونَ","ﲏ",[144]],[37,145,"فَنَبَذۡنَٰهُ بِالۡعَرَآءِ وَهۡوَ سَقِيمٞ","ﲐ",[145]],[37,146,"۞ وَأَنۢبَتۡنَا عَلَيۡهِ شَجَرَةٗ مِّن يَقۡطِينٖ","ﲑ",[146]],[37,147,"وَأَرۡسَلۡنَٰهُ إِلَىٰ مِاْئَةِ أَلۡفٍ أَوۡ يَزِيدُونَ","ﲒ",[147]],[37,148,"فَــَٔامَنُواْ فَمَتَّعۡنَٰهُمۡ إِلَىٰ حِينٖ","ﲓ",[148]],[37,149,"فَاَسۡتَفۡتِهِمۡ أَلِرَبِّكَ اَ۬لۡبَنَاتُ وَلَهُمُ اُ۬لۡبَنُونَ","ﲔ",[149]],[37,150,"أَمۡ خَلَقۡنَا اَ۬لۡمَلَٰٓئِكَةَ إِنَٰثٗا وَهُمۡ شَٰهِدُونَ","ﲕ",[150]],[37,151,"أَلَآ إِنَّهُم مِّنۡ إِفۡكِهِمۡ لَيَقُولُونَ","ﲖ",[151]],[37,152,"وَلَدَ اَ۬للَّهُ وَإِنَّهُمۡ لَكَٰذِبُونَ","ﲗ",[152]],[37,153,"أَصۡطَفَى اَ۬لۡبَنَاتِ عَلَى اَ۬لۡبَنِينَ","ﲘ",[153]]]