[[92,10,"فَسَنُيَسِّرُهُۥ لِلۡعُسۡر۪يٰ","ﰉ",[10]],[92,11,"وَمَا يُغۡنِي عَنۡهُ مَالُهُۥٓ إِذَا تَرَدّۭيٰٓ","ﰊ",[11]],[92,12,"إِنَّ عَلَيۡنَا لَلۡهُدۭيٰ","ﰋ",[12]],[92,13,"وَإِنَّ لَنَا لَلۡأٓخِرَةَ وَاَلۡأُولۭيٰ","ﰌ",[13]],[92,14,"فَأَنذَرۡتُكُمۡ نَارٗا تَلَظّۭيٰ","ﰍ",[14]],[92,15,"لَا يَصۡلَىٰهَآ إِلَّا اَ۬لۡأَشۡقَى","ﰎ",[15]],[92,16,"اَ۬لَّذِي كَذَّبَ وَتَوَلّۭيٰ","ﰏ",[16]],[92,17,"وَسَيُجَنَّبُهَا اَ۬لۡأَتۡقَى","ﰐ",[17]],[92,18,"اَ۬لَّذِي يُؤۡتِي مَالَهُۥ يَتَزَكّۭيٰ","ﰑ",[18]],[92,19,"وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعۡمَةٖ تُجۡزۭيٰٓ","ﰒ",[19]],[92,20,"إِلَّا اَ۪بۡتِغَآءَ وَجۡهِ رَبِّهِ اِ۬لۡأَعۡلۭيٰ","ﰓ",[20]],[92,21,"وَلَسَوۡفَ يَرۡضۭيٰ","ﰔ",[21]],[93,1,"وَاَلضُّحۭيٰ","ﰀ",[1]],[93,2,"وَاَلَّيۡلِ إِذَا سَجۭيٰ","ﰁ",[2]],[93,3,"مَا وَدَّعَكَ رَبُّكَ وَمَا قَلۭيٰ","ﰂ",[3]],[93,4,"وَلَلۡأٓخِرَةُ خَيۡرٞ لَّكَ مِنَ اَ۬لۡأُولۭيٰ","ﰃ",[4]],[93,5,"وَلَسَوۡفَ يُعۡطِيكَ رَبُّكَ فَتَرۡضۭيٰٓ","ﰄ",[5]],[93,6,"أَلَمۡ يَجِدۡكَ يَتِيمٗا فَــَٔاوۭيٰ","ﰅ",[6]],[93,7,"وَوَجَدَكَ ضَآلّٗا فَهَدۭيٰ","ﰆ",[7]],[93,8,"وَوَجَدَكَ عَآئِلٗا فَأَغۡنۭيٰ","ﰇ",[8]],[93,9,"فَأَمَّا اَ۬لۡيَتِيمَ فَلَا تَقۡهَرۡ","ﰈ",[9]],[93,10,"وَأَمَّا اَ۬لسَّآئِلَ فَلَا تَنۡهَرۡ","ﰉ",[10]],[93,11,"وَأَمَّا بِنِعۡمَةِ رَبِّكَ فَحَدِّثۡ","ﰊ",[11]],[94,1,"أَلَمۡ نَشۡرَحۡ لَكَ صَدۡرَكَ","ﰀ",[1]],[94,2,"وَوَضَعۡنَا عَنكَ وِزۡرَكَ","ﰁ",[2]]]