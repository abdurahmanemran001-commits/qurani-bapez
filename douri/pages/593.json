[[88,23,"إِلَّا مَن تَوَلَّىٰ وَكَفَرَ","ﰖ",[23]],[88,24,"فَيُعَذِّبُهُ اُ۬للَّهُ اُ۬لۡعَذَابَ اَ۬لۡأَكۡبَرَ","ﰗ",[24]],[88,25,"إِنَّ إِلَيۡنَآ إِيَابَهُمۡ","ﰘ",[25]],[88,26,"ثُمَّ إِنَّ عَلَيۡنَا حِسَابَهُم","ﰙ",[26]],[89,1,"وَاَلۡفَجۡرِ","ﰀ",[1]],[89,2,"وَلَيَالٍ عَشۡرٖ","ﰁ",[2]],[89,3,"وَاَلشَّفۡعِ وَاَلۡوَتۡرِ","ﰂ",[3]],[89,4,"وَاَلَّيۡلِ إِذَا يَسۡرِۦ","ﰃ",[4]],[89,5,"هَلۡ فِي ذَٰلِكَ قَسَمٞ لِّذِي حِجۡرٍ","ﰄ",[5]],[89,6,"أَلَمۡ تَرَ كَيۡفَ فَعَلَ رَبُّكَ بِعَادٍ","ﰅ",[6]],[89,7,"إِرَمَ ذَاتِ اِ۬لۡعِمَادِ","ﰆ",[7]],[89,8,"اِ۬لَّتِي لَمۡ يُخۡلَقۡ مِثۡلُهَا فِي اِ۬لۡبِلَٰدِ","ﰇ",[8]],[89,9,"وَثَمُودَ اَ۬لَّذِينَ جَابُواْ اُ۬لصَّخۡرَ بِالۡوَادِ","ﰈ",[9]],[89,10,"وَفِرۡعَوۡنَ ذِي اِ۬لۡأَوۡتَادِ","ﰉ",[10]],[89,11,"اِ۬لَّذِينَ طَغَوۡاْ فِي اِ۬لۡبِلَٰدِ","ﰊ",[11]],[89,12,"فَأَكۡثَرُواْ فِيهَا اَ۬لۡفَسَادَ","ﰋ",[12]],[89,13,"فَصَبَّ عَلَيۡهِمۡ رَبُّكَ سَوۡطَ عَذَابٍ","ﰌ",[13]],[89,14,"إِنَّ رَبَّكَ لَبِالۡمِرۡصَادِ","ﰍ",[14]],[89,15,"فَأَمَّا اَ۬لۡإِنسَٰنُ إِذَا مَا اَ۪بۡتَلَىٰهُ رَبُّهُۥ فَأَكۡرَمَهُۥ وَنَعَّمَهُۥ","ﰎ",[15]],[89,16,"فَيَقُولُ رَبِّيَ أَكۡرَمَنِۦ","ﰏ",[15]],[89,17,"وَأَمَّآ إِذَا مَا اَ۪بۡتَلَىٰهُ فَقَدَرَ عَلَيۡهِ رِزۡقَهُۥ","ﰐ",[16]],[89,18,"فَيَقُولُ رَبِّيَ أَهَٰنَنِۦ","ﰑ",[16]],[89,19,"كَلَّاۖ بَل لَّا يُكۡرِمُونَ اَ۬لۡيَتِيمَ","ﰒ",[17]],[89,20,"وَلَا يَحُضُّونَ عَلَىٰ طَعَامِ اِ۬لۡمِسۡكِينِ","ﰓ",[18]],[89,21,"وَيَأۡكُلُونَ اَ۬لتُّرَاثَ أَكۡلٗا لَّمّٗا","ﰔ",[19]],[89,22,"وَيُحِبُّونَ اَ۬لۡمَالَ حُبّٗا جَمّٗا","ﰕ",[20]],[89,23,"كَلَّآ إِذَا دُكَّتِ اِ۬لۡأَرۡضُ دَكّٗا دَكّٗا","ﰖ",[21]],[89,24,"وَجَآءَ رَبُّكَ وَاَلۡمَلَكُ صَفّٗا صَفّٗا","ﰗ",[22]]]