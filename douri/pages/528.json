[[53,44,"وَأَنَّهُۥ خَلَقَ اَ۬لزَّوۡجَيۡنِ اِ۬لذَّكَرَ وَاَلۡأُنثۭيٰ","ﰫ",[45]],[53,45,"مِن نُّطۡفَةٍ إِذَا تُمۡنۭيٰ","ﰬ",[46]],[53,46,"وَأَنَّ عَلَيۡهِ اِ۬لنَّشَآءَةَ اَ۬لۡأُخۡر۪يٰ","ﰭ",[47]],[53,47,"وَأَنَّهُۥ هُوَ أَغۡنَىٰ وَأَقۡنۭيٰ","ﰮ",[48]],[53,48,"وَأَنَّهُۥ هُوَ رَبُّ اُ۬لشِّعۡر۪يٰ","ﰯ",[49]],[53,49,"وَأَنَّهُۥٓ أَهۡلَكَ عَادٗا اَ۬لُّاولۭيٰ","ﰰ",[50]],[53,50,"وَثَمُودٗا فَمَآ أَبۡقۭيٰ","ﰱ",[51]],[53,51,"وَقَوۡمَ نُوحٖ مِّن قَبۡلُۖ إِنَّهُمۡ كَانُواْ هُمۡ أَظۡلَمَ وَأَطۡغۭيٰ","ﰲ",[52]],[53,52,"وَاَلۡمُؤۡتَفِكَةَ أَهۡوۭيٰ","ﰳ",[53]],[53,53,"فَغَشَّىٰهَا مَا غَشّۭيٰ","ﰴ",[54]],[53,54,"فَبِأَيِّ ءَالَآءِ رَبِّكَ تَتَمَار۪يٰ","ﰵ",[55]],[53,55,"هَٰذَا نَذِيرٞ مِّنَ اَ۬لنُّذُرِ اِ۬لۡأُولۭيٰٓ","ﰶ",[56]],[53,56,"أَزِفَتِ اِ۬لۡأٓزِفَةُ","ﰷ",[57]],[53,57,"لَيۡسَ لَهَا مِن دُونِ اِ۬للَّهِ كَاشِفَةٌ","ﰸ",[58]],[53,58,"أَفَمِنۡ هَٰذَا اَ۬لۡحَدِيثِ تَعۡجَبُونَ","ﰹ",[59]],[53,59,"وَتَضۡحَكُونَ وَلَا تَبۡكُونَ","ﰺ",[60]],[53,60,"وَأَنتُمۡ سَٰمِدُونَ","ﰻ",[61]],[53,61,"فَاَسۡجُدُواْۤ لِلَّهِۤ وَاَعۡبُدُواْ۩","ﰼ",[62]],[54,1,"اِ۪قۡتَرَبَتِ اِ۬لسَّاعَةُ وَاَنشَقَّ اَ۬لۡقَمَرُ","ﰀ",[1]],[54,2,"وَإِن يَرَوۡاْ ءَايَةٗ يُعۡرِضُواْ وَيَقُولُواْ سِحۡرٞ مُّسۡتَمِرّٞ","ﰁ",[2]],[54,3,"وَكَذَّبُواْ وَاَتَّبَعُوٓاْ أَهۡوَآءَهُمۡۚ وَكُلُّ أَمۡرٖ مُّسۡتَقِرّٞ","ﰂ",[3]],[54,4,"وَلَقَد جَّآءَهُم مِّنَ اَ۬لۡأَنۢبَآءِ مَا فِيهِ مُزۡدَجَرٌ","ﰃ",[4]],[54,5,"حِكۡمَةُۢ بَٰلِغَةٞۖ فَمَا تُغۡنِ اِ۬لنُّذُرُ","ﰄ",[5]],[54,6,"فَتَوَلَّ عَنۡهُمۡۘ يَوۡمَ يَدۡعُ اُ۬لدَّاعِۦٓ إِلَىٰ شَيۡءٖ نُّكُرٍ","ﰅ",[6]]]