[[56,54,"ثُمَّ إِنَّكُمۡ أَيُّهَا اَ۬لضَّآلُّونَ اَ۬لۡمُكَذِّبُونَ","ﰵ",[51]],[56,55,"لَأٓكِلُونَ مِن شَجَرٖ مِّن زَقُّومٖ","ﰶ",[52]],[56,56,"فَمَالِــُٔونَ مِنۡهَا اَ۬لۡبُطُونَ","ﰷ",[53]],[56,57,"فَشَٰرِبُونَ عَلَيۡهِ مِنَ اَ۬لۡحَمِيمِ","ﰸ",[54]],[56,58,"فَشَٰرِبُونَ شَرۡبَ اَ۬لۡهِيمِ","ﰹ",[55]],[56,59,"هَٰذَا نُزُلُهُمۡ يَوۡمَ اَ۬لدِّينِ","ﰺ",[56]],[56,60,"نَحۡنُ خَلَقۡنَٰكُمۡ فَلَوۡلَا تُصَدِّقُونَ","ﰻ",[57]],[56,61,"أَفَرَءَيۡتُم مَّا تُمۡنُونَ","ﰼ",[58]],[56,62,"ءَٰا۬نتُمۡ تَخۡلُقُونَهُۥٓ أَمۡ نَحۡنُ اُ۬لۡخَٰلِقُونَ","ﰽ",[59]],[56,63,"نَحۡنُ قَدَّرۡنَا بَيۡنَكُمُ اُ۬لۡمَوۡتَ وَمَا نَحۡنُ بِمَسۡبُوقِينَ","ﰾ",[60]],[56,64,"عَلَىٰٓ أَن نُّبَدِّلَ أَمۡثَٰلَكُمۡ وَنُنشِئَكُمۡ فِي مَا لَا تَعۡلَمُونَ","ﰿ",[61]],[56,65,"وَلَقَدۡ عَلِمۡتُمُ اُ۬لنَّشَآءَةَ اَ۬لۡأُولۭيٰ فَلَوۡلَا تَذَّكَّرُونَ","ﱀ",[62]],[56,66,"أَفَرَءَيۡتُم مَّا تَحۡرُثُونَ","ﱁ",[63]],[56,67,"ءَٰا۬نتُمۡ تَزۡرَعُونَهُۥٓ أَمۡ نَحۡنُ اُ۬لزَّٰرِعُونَ","ﱂ",[64]],[56,68,"لَوۡ نَشَآءُ لَجَعَلۡنَٰهُ حُطَٰمٗا فَظَلۡتُمۡ تَفَكَّهُونَ","ﱃ",[65]],[56,69,"إِنَّا لَمُغۡرَمُونَ","ﱄ",[66]],[56,70,"بَلۡ نَحۡنُ مَحۡرُومُونَ","ﱅ",[67]],[56,71,"أَفَرَءَيۡتُمُ اُ۬لۡمَآءَ اَ۬لَّذِي تَشۡرَبُونَ","ﱆ",[68]],[56,72,"ءَٰا۬نتُمۡ أَنزَلۡتُمُوهُ مِنَ اَ۬لۡمُزۡنِ أَمۡ نَحۡنُ اُ۬لۡمُنزِلُونَ","ﱇ",[69]],[56,73,"لَوۡ نَشَآءُ جَعَلۡنَٰهُ أُجَاجٗا فَلَوۡلَا تَشۡكُرُونَ","ﱈ",[70]],[56,74,"أَفَرَءَيۡتُمُ اُ۬لنَّارَ اَ۬لَّتِي تُورُونَ","ﱉ",[71]],[56,75,"ءَٰا۬نتُمۡ أَنشَأۡتُمۡ شَجَرَتَهَآ أَمۡ نَحۡنُ اُ۬لۡمُنشِــُٔونَ","ﱊ",[72]],[56,76,"نَحۡنُ جَعَلۡنَٰهَا تَذۡكِرَةٗ وَمَتَٰعٗا لِّلۡمُقۡوِينَ","ﱋ",[73]],[56,77,"فَسَبِّحۡ بِاسۡمِ رَبِّكَ اَ۬لۡعَظِيمِ","ﱌ",[74]],[56,78,"۞ فَلَآ أُقۡسِمُ بِمَوَٰقِعِ اِ۬لنُّجُومِ","ﱍ",[75]],[56,79,"وَإِنَّهُۥ لَقَسَمٞ لَّوۡ تَعۡلَمُونَ عَظِيمٌ","ﱎ",[76]]]