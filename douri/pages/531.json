[[54,50,"وَمَآ أَمۡرُنَآ إِلَّا وَٰحِدَةٞ كَلَمۡحِۢ بِالۡبَصَرِ","ﰱ",[50]],[54,51,"وَلَقَدۡ أَهۡلَكۡنَآ أَشۡيَاعَكُمۡ فَهَلۡ مِن مُّدَّكِرٖ","ﰲ",[51]],[54,52,"وَكُلُّ شَيۡءٖ فَعَلُوهُ فِي اِ۬لزُّبُرِ","ﰳ",[52]],[54,53,"وَكُلُّ صَغِيرٖ وَكَبِيرٖ مُّسۡتَطَرٌ","ﰴ",[53]],[54,54,"إِنَّ اَ۬لۡمُتَّقِينَ فِي جَنَّٰتٖ وَنَهَرٖ","ﰵ",[54]],[54,55,"فِي مَقۡعَدِ صِدۡقٍ عِندَ مَلِيكٖ مُّقۡتَدِرِۢ","ﰶ",[55]],[55,1,"اِ۬لرَّحۡمَٰنُ عَلَّمَ اَ۬لۡقُرۡءَانَ","ﰀ",[1,2]],[55,2,"خَلَقَ اَ۬لۡإِنسَٰنَ عَلَّمَهُ اُ۬لۡبَيَانَ","ﰁ",[3,4]],[55,3,"اَ۬لشَّمۡسُ وَاَلۡقَمَرُ بِحُسۡبَانٖ","ﰂ",[5]],[55,4,"وَاَلنَّجۡمُ وَاَلشَّجَرُ يَسۡجُدَانِ","ﰃ",[6]],[55,5,"وَاَلسَّمَآءَ رَفَعَهَا وَوَضَعَ اَ۬لۡمِيزَانَ","ﰄ",[7]],[55,6,"أَلَّا تَطۡغَوۡاْ فِي اِ۬لۡمِيزَانِ","ﰅ",[8]],[55,7,"وَأَقِيمُواْ اُ۬لۡوَزۡنَ بِالۡقِسۡطِ وَلَا تُخۡسِرُواْ اُ۬لۡمِيزَانَ","ﰆ",[9]],[55,8,"وَاَلۡأَرۡضَ وَضَعَهَا لِلۡأَنَامِ","ﰇ",[10]],[55,9,"فِيهَا فَٰكِهَةٞ وَاَلنَّخۡلُ ذَاتُ اُ۬لۡأَكۡمَامِ","ﰈ",[11]],[55,10,"وَاَلۡحَبُّ ذُو اُ۬لۡعَصۡفِ وَاَلرَّيۡحَانُ","ﰉ",[12]],[55,11,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","ﰊ",[13]],[55,12,"خَلَقَ اَ۬لۡإِنسَٰنَ مِن صَلۡصَٰلٖ كَاَلۡفَخّ۪ارِ","ﰋ",[14]],[55,13,"وَخَلَقَ اَ۬لۡجَآنَّ مِن مَّارِجٖ مِّن نّ۪ارٖ","ﰌ",[15]],[55,14,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","ﰍ",[16]],[55,15,"رَبُّ اُ۬لۡمَشۡرِقَيۡنِ وَرَبُّ اُ۬لۡمَغۡرِبَيۡنِ","ﰎ",[17]],[55,16,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","ﰏ",[18]]]