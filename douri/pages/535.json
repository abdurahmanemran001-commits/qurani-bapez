[[56,19,"يَطُوفُ عَلَيۡهِمۡ وِلۡدَٰنٞ مُّخَلَّدُونَ","ﰒ",[17]],[56,20,"بِأَكۡوَابٖ وَأَبَارِيقَ وَكَأۡسٖ مِّن مَّعِينٖ","ﰓ",[18]],[56,21,"لَّا يُصَدَّعُونَ عَنۡهَا وَلَا يُنزَفُونَ","ﰔ",[19]],[56,22,"وَفَٰكِهَةٖ مِّمَّا يَتَخَيَّرُونَ","ﰕ",[20]],[56,23,"وَلَحۡمِ طَيۡرٖ مِّمَّا يَشۡتَهُونَ","ﰖ",[21]],[56,24,"وَحُورٌ عِينٞ","ﰗ",[22]],[56,25,"كَأَمۡثَٰلِ اِ۬للُّؤۡلُوِٕ اِ۬لۡمَكۡنُونِ","ﰘ",[23]],[56,26,"جَزَآءَۢ بِمَا كَانُواْ يَعۡمَلُونَ","ﰙ",[24]],[56,27,"لَا يَسۡمَعُونَ فِيهَا لَغۡوٗا وَلَا تَأۡثِيمًا إِلَّا قِيلٗا سَلَٰمٗا سَلَٰمٗا","ﰚ",[25,26]],[56,28,"وَأَصۡحَٰبُ اُ۬لۡيَمِينِ","ﰛ",[27]],[56,29,"مَآ أَصۡحَٰبُ اُ۬لۡيَمِينِ","ﰜ",[27]],[56,30,"فِي سِدۡرٖ مَّخۡضُودٖ","ﰝ",[28]],[56,31,"وَطَلۡحٖ مَّنضُودٖ","ﰞ",[29]],[56,32,"وَظِلّٖ مَّمۡدُودٖ","ﰟ",[30]],[56,33,"وَمَآءٖ مَّسۡكُوبٖ","ﰠ",[31]],[56,34,"وَفَٰكِهَةٖ كَثِيرَةٖ","ﰡ",[32]],[56,35,"لَّا مَقۡطُوعَةٖ وَلَا مَمۡنُوعَةٖ","ﰢ",[33]],[56,36,"وَفُرُشٖ مَّرۡفُوعَةٍ","ﰣ",[34]],[56,37,"إِنَّآ أَنشَأۡنَٰهُنَّ إِنشَآءٗ","ﰤ",[35]],[56,38,"فَجَعَلۡنَٰهُنَّ أَبۡكَارًا","ﰥ",[36]],[56,39,"عُرُبًا أَتۡرَابٗا","ﰦ",[37]],[56,40,"لِّأَصۡحَٰبِ اِ۬لۡيَمِينِ","ﰧ",[38]],[56,41,"۞ ثُلَّةٞ مِّنَ اَ۬لۡأَوَّلِينَ","ﰨ",[39]],[56,42,"وَثُلَّةٞ مِّنَ اَ۬لۡأٓخِرِينَ","ﰩ",[40]],[56,43,"وَأَصۡحَٰبُ اُ۬لشِّمَالِ","ﰪ",[41]],[56,44,"مَآ أَصۡحَٰبُ اُ۬لشِّمَالِ","ﰫ",[41]],[56,45,"فِي سَمُومٖ وَحَمِيمٖ","ﰬ",[42]],[56,46,"وَظِلّٖ مِّن يَحۡمُومٖ","ﰭ",[43]],[56,47,"لَّا بَارِدٖ وَلَا كَرِيمٍ","ﰮ",[44]],[56,48,"إِنَّهُمۡ كَانُواْ قَبۡلَ ذَٰلِكَ مُتۡرَفِينَ","ﰯ",[45]],[56,49,"وَكَانُواْ يُصِرُّونَ عَلَى اَ۬لۡحِنثِ اِ۬لۡعَظِيمِ","ﰰ",[46]],[56,50,"وَكَانُواْ يَقُولُونَ أَٰى۪ذَا مُتۡنَا وَكُنَّا تُرَابٗا وَعِظَٰمًا أَٰ۟نَّا لَمَبۡعُوثُونَ","ﰱ",[47]],[56,51,"أَوَءَابَآؤُنَا اَ۬لۡأَوَّلُونَ","ﰲ",[48]],[56,52,"قُلۡ إِنَّ اَ۬لۡأَوَّلِينَ وَاَلۡأٓخِرِينَ","ﰳ",[49]],[56,53,"لَمَجۡمُوعُونَ إِلَىٰ مِيقَٰتِ يَوۡمٖ مَّعۡلُومٖ","ﰴ",[50]]]