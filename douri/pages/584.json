[[79,17,"اَ۪ذۡهَبۡ إِلَىٰ فِرۡعَوۡنَ إِنَّهُۥ طَغۭيٰ","ﰐ",[17]],[79,18,"فَقُلۡ هَل لَّكَ إِلَىٰٓ أَن تَزَكّۭيٰ","ﰑ",[18]],[79,19,"وَأَهۡدِيَكَ إِلَىٰ رَبِّكَ فَتَخۡشۭيٰ","ﰒ",[19]],[79,20,"فَأَر۪ىٰهُ اُ۬لۡأٓيَةَ اَ۬لۡكُبۡر۪يٰ","ﰓ",[20]],[79,21,"فَكَذَّبَ وَعَصۭيٰ","ﰔ",[21]],[79,22,"ثُمَّ أَدۡبَرَ يَسۡعۭيٰ","ﰕ",[22]],[79,23,"فَحَشَرَ فَنَادۭيٰ","ﰖ",[23]],[79,24,"فَقَالَ أَنَا۠ رَبُّكُمُ اُ۬لۡأَعۡلۭيٰ","ﰗ",[24]],[79,25,"فَأَخَذَهُ اُ۬للَّهُ نَكَالَ اَ۬لۡأٓخِرَةِ وَاَلۡأُولۭيٰٓ","ﰘ",[25]],[79,26,"إِنَّ فِي ذَٰلِكَ لَعِبۡرَةٗ لِّمَن يَخۡشۭيٰٓ","ﰙ",[26]],[79,27,"ءَٰا۬نتُمۡ أَشَدُّ خَلۡقًا أَمِ اِ۬لسَّمَآءُۚ بَنۭىٰهَا","ﰚ",[27]],[79,28,"رَفَعَ سَمۡكَهَا فَسَوّۭىٰهَا","ﰛ",[28]],[79,29,"وَأَغۡطَشَ لَيۡلَهَا وَأَخۡرَجَ ضُحۭىٰهَا","ﰜ",[29]],[79,30,"وَاَلۡأَرۡضَ بَعۡدَ ذَٰلِكَ دَحۭىٰهَآ","ﰝ",[30]],[79,31,"أَخۡرَجَ مِنۡهَا مَآءَهَا وَمَرۡعۭىٰهَا","ﰞ",[31]],[79,32,"وَاَلۡجِبَالَ أَرۡسۭىٰهَا","ﰟ",[32]],[79,33,"مَتَٰعٗا لَّكُمۡ وَلِأَنۡعَٰمِكُمۡ","ﰠ",[33]],[79,34,"فَإِذَا جَآءَتِ اِ۬لطَّآمَّةُ اُ۬لۡكُبۡر۪يٰ","ﰡ",[34]],[79,35,"يَوۡمَ يَتَذَكَّرُ اُ۬لۡإِنسَٰنُ مَا سَعۭيٰ","ﰢ",[35]],[79,36,"وَبُرِّزَتِ اِ۬لۡجَحِيمُ لِمَن يَر۪يٰ","ﰣ",[36]],[79,37,"فَأَمَّا مَن طَغَىٰ وَءَاثَرَ اَ۬لۡحَيَوٰةَ اَ۬لدُّنۡيۭا","ﰤ",[37,38]],[79,38,"فَإِنَّ اَ۬لۡجَحِيمَ هِيَ اَ۬لۡمَأۡوۭيٰ","ﰥ",[39]],[79,39,"وَأَمَّا مَنۡ خَافَ مَقَامَ رَبِّهِۦ وَنَهَى اَ۬لنَّفۡسَ عَنِ اِ۬لۡهَوۭيٰ","ﰦ",[40]],[79,40,"فَإِنَّ اَ۬لۡجَنَّةَ هِيَ اَ۬لۡمَأۡوۭيٰ","ﰧ",[41]],[79,41,"۞ يَسۡــَٔلُونَكَ عَنِ اِ۬لسَّاعَةِ أَيَّانَ مُرۡسۭىٰهَا","ﰨ",[42]],[79,42,"فِيمَ أَنتَ مِن ذِكۡر۪ىٰهَآ","ﰩ",[43]],[79,43,"إِلَىٰ رَبِّكَ مُنتَهۭىٰهَآ","ﰪ",[44]],[79,44,"إِنَّمَآ أَنتَ مُنذِرُ مَن يَخۡشۭىٰهَا","ﰫ",[45]],[79,45,"كَأَنَّهُمۡ يَوۡمَ يَرَوۡنَهَا لَمۡ يَلۡبَثُوٓاْ إِلَّا عَشِيَّةً أَوۡ ضُحۭىٰهَا","ﰬ",[46]]]