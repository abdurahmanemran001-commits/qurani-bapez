[[90,19,"وَاَلَّذِينَ كَفَرُواْ بِــَٔايَٰتِنَا هُمۡ أَصۡحَٰبُ اُ۬لۡمَشۡــَٔمَةِ","ﰒ",[19]],[90,20,"عَلَيۡهِمۡ نَارٞ مُّؤۡصَدَةُۢ","ﰓ",[20]],[91,1,"وَاَلشَّمۡسِ وَضُحۭىٰهَا","ﰀ",[1]],[91,2,"وَاَلۡقَمَرِ إِذَا تَلۭىٰهَا","ﰁ",[2]],[91,3,"وَاَلنَّه۪ارِ إِذَا جَلّۭىٰهَا","ﰂ",[3]],[91,4,"وَاَلَّيۡلِ إِذَا يَغۡشۭىٰهَا","ﰃ",[4]],[91,5,"وَاَلسَّمَآءِ وَمَا بَنۭىٰهَا","ﰄ",[5]],[91,6,"وَاَلۡأَرۡضِ وَمَا طَحۭىٰهَا","ﰅ",[6]],[91,7,"وَنَفۡسٖ وَمَا سَوّۭىٰهَا","ﰆ",[7]],[91,8,"فَأَلۡهَمَهَا فُجُورَهَا وَتَقۡوۭىٰهَا","ﰇ",[8]],[91,9,"قَدۡ أَفۡلَحَ مَن زَكّۭىٰهَا","ﰈ",[9]],[91,10,"وَقَدۡ خَابَ مَن دَسّۭىٰهَا","ﰉ",[10]],[91,11,"كَذَّبَت ثَّمُودُ بِطَغۡوۭىٰهَآ","ﰊ",[11]],[91,12,"إِذِ اِ۪نۢبَعَثَ أَشۡقۭىٰهَا","ﰋ",[12]],[91,13,"فَقَالَ لَهُمۡ رَسُولُ اُ۬للَّهِ نَاقَةَ اَ۬للَّهِ وَسُقۡيٰۭهَا","ﰌ",[13]],[91,14,"فَكَذَّبُوهُ فَعَقَرُوهَا","ﰍ",[14]],[91,15,"فَدَمۡدَمَ عَلَيۡهِمۡ رَبُّهُم بِذَنۢبِهِمۡ فَسَوّۭىٰهَا","ﰎ",[14]],[91,16,"وَلَا يَخَافُ عُقۡبٰۭهَا","ﰏ",[15]],[92,1,"وَاَلَّيۡلِ إِذَا يَغۡشۭيٰ","ﰀ",[1]],[92,2,"وَاَلنَّه۪ارِ إِذَا تَجَلّۭيٰ","ﰁ",[2]],[92,3,"وَمَا خَلَقَ اَ۬لذَّكَرَ وَاَلۡأُنثۭيٰٓ","ﰂ",[3]],[92,4,"إِنَّ سَعۡيَكُمۡ لَشَتّۭيٰ","ﰃ",[4]],[92,5,"فَأَمَّا مَنۡ أَعۡطَىٰ وَاَتَّقۭيٰ","ﰄ",[5]],[92,6,"وَصَدَّقَ بِالۡحُسۡنۭيٰ","ﰅ",[6]],[92,7,"فَسَنُيَسِّرُهُۥ لِلۡيُسۡر۪يٰ","ﰆ",[7]],[92,8,"وَأَمَّا مَنۢ بَخِلَ وَاَسۡتَغۡنۭيٰ","ﰇ",[8]],[92,9,"وَكَذَّبَ بِالۡحُسۡنۭيٰ","ﰈ",[9]]]