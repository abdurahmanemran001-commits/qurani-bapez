[[37,77,"وَجَعَلۡنَا ذُرِّيَّتَهُۥ هُمُ اُ۬لۡبَاقِينَ","ﱌ",[77]],[37,78,"وَتَرَكۡنَا عَلَيۡهِ فِي اِ۬لۡأٓخِرِينَ","ﱍ",[78]],[37,79,"سَلَٰمٌ عَلَىٰ نُوحٖ فِي اِ۬لۡعَٰلَمِينَ","ﱎ",[79]],[37,80,"إِنَّا كَذَٰلِكَ نَجۡزِي اِ۬لۡمُحۡسِنِينَ","ﱏ",[80]],[37,81,"إِنَّهُۥ مِنۡ عِبَادِنَا اَ۬لۡمُؤۡمِنِينَ","ﱐ",[81]],[37,82,"ثُمَّ أَغۡرَقۡنَا اَ۬لۡأٓخَرِينَ","ﱑ",[82]],[37,83,"۞ وَإِنَّ مِن شِيعَتِهِۦ لَإِبۡرَٰهِيمَ","ﱒ",[83]],[37,84,"إِذ جَّآءَ رَبَّهُۥ بِقَلۡبٖ سَلِيمٍ","ﱓ",[84]],[37,85,"إِذۡ قَالَ لِأَبِيهِ وَقَوۡمِهِۦ مَاذَا تَعۡبُدُونَ","ﱔ",[85]],[37,86,"أَٰى۪فۡكًا ءَالِهَةٗ دُونَ اَ۬للَّهِ تُرِيدُونَ","ﱕ",[86]],[37,87,"فَمَا ظَنُّكُم بِرَبِّ اِ۬لۡعَٰلَمِينَ","ﱖ",[87]],[37,88,"فَنَظَرَ نَظۡرَةٗ فِي اِ۬لنُّجُومِ","ﱗ",[88]],[37,89,"فَقَالَ إِنِّي سَقِيمٞ","ﱘ",[89]],[37,90,"فَتَوَلَّوۡاْ عَنۡهُ مُدۡبِرِينَ","ﱙ",[90]],[37,91,"فَرَاغَ إِلَىٰٓ ءَالِهَتِهِمۡ فَقَالَ أَلَا تَأۡكُلُونَ","ﱚ",[91]],[37,92,"مَا لَكُمۡ لَا تَنطِقُونَ","ﱛ",[92]],[37,93,"فَرَاغَ عَلَيۡهِمۡ ضَرۡبَۢا بِالۡيَمِينِ","ﱜ",[93]],[37,94,"فَأَقۡبَلُوٓاْ إِلَيۡهِ يَزِفُّونَ","ﱝ",[94]],[37,95,"قَالَ أَتَعۡبُدُونَ مَا تَنۡحِتُونَ","ﱞ",[95]],[37,96,"وَاَللَّهُ خَلَقَكُمۡ وَمَا تَعۡمَلُونَ","ﱟ",[96]],[37,97,"قَالُواْ اُ۪بۡنُواْ لَهُۥ بُنۡيَٰنٗا فَأَلۡقُوهُ فِي اِ۬لۡجَحِيمِ","ﱠ",[97]],[37,98,"فَأَرَادُواْ بِهِۦ كَيۡدٗا فَجَعَلۡنَٰهُمُ اُ۬لۡأَسۡفَلِينَ","ﱡ",[98]],[37,99,"وَقَالَ إِنِّي ذَاهِبٌ إِلَىٰ رَبِّي سَيَهۡدِينِ","ﱢ",[99]],[37,100,"رَبِّ هَبۡ لِي مِنَ اَ۬لصَّٰلِحِينَ","ﱣ",[100]],[37,101,"فَبَشَّرۡنَٰهُ بِغُلَٰمٍ حَلِيمٖ","ﱤ",[101]],[37,102,"فَلَمَّا بَلَغَ مَعَهُ اُ۬لسَّعۡيَ قَالَ يَٰبُنَيِّ إِنِّيَ أَر۪يٰ فِي اِ۬لۡمَنَامِ أَنِّيَ أَذۡبَحُكَ فَاَنظُرۡ مَاذَا تَر۪يٰۚ قَالَ يَٰٓأَبَتِ اِ۪فۡعَلۡ مَا تُؤۡمَرُۖ سَتَجِدُنِيٓ إِن شَآءَ اَ۬للَّهُ مِنَ اَ۬لصَّٰبِرِينَ","ﱥ",[102]]]