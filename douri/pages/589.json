[[83,34,"فَاَلۡيَوۡمَ اَ۬لَّذِينَ ءَامَنُواْ مِنَ اَ۬لۡكُفّ۪ارِ يَضۡحَكُونَ","ﰡ",[34]],[83,35,"عَلَى اَ۬لۡأَرَآئِكِ يَنظُرُونَ","ﰢ",[35]],[83,36,"هَلۡ ثُوِّبَ اَ۬لۡكُفَّارُ مَا كَانُواْ يَفۡعَلُونَ","ﰣ",[36]],[84,1,"إِذَا اَ۬لسَّمَآءُ اُ۪نشَقَّتۡ","ﰀ",[1]],[84,2,"وَأَذِنَتۡ لِرَبِّهَا وَحُقَّتۡ","ﰁ",[2]],[84,3,"وَإِذَا اَ۬لۡأَرۡضُ مُدَّتۡ","ﰂ",[3]],[84,4,"وَأَلۡقَتۡ مَا فِيهَا وَتَخَلَّتۡ","ﰃ",[4]],[84,5,"وَأَذِنَتۡ لِرَبِّهَا وَحُقَّتۡ","ﰄ",[5]],[84,6,"يَٰٓأَيُّهَا اَ۬لۡإِنسَٰنُ إِنَّكَ كَادِحٌ إِلَىٰ رَبِّكَ كَدۡحٗا فَمُلَٰقِيهِ","ﰅ",[6]],[84,7,"فَأَمَّا مَنۡ أُوتِيَ كِتَٰبَهُۥ بِيَمِينِهِۦ","ﰆ",[7]],[84,8,"فَسَوۡفَ يُحَاسَبُ حِسَابٗا يَسِيرٗا","ﰇ",[8]],[84,9,"وَيَنقَلِبُ إِلَىٰٓ أَهۡلِهِۦ مَسۡرُورٗا","ﰈ",[9]],[84,10,"وَأَمَّا مَنۡ أُوتِيَ كِتَٰبَهُۥ وَرَآءَ ظَهۡرِهِۦ","ﰉ",[10]],[84,11,"فَسَوۡفَ يَدۡعُواْ ثُبُورٗا","ﰊ",[11]],[84,12,"وَيَصۡلَىٰ سَعِيرًا","ﰋ",[12]],[84,13,"إِنَّهُۥ كَانَ فِيٓ أَهۡلِهِۦ مَسۡرُورًا","ﰌ",[13]],[84,14,"إِنَّهُۥ ظَنَّ أَن لَّن يَحُورَ","ﰍ",[14]],[84,15,"بَلَىٰٓۚ إِنَّ رَبَّهُۥ كَانَ بِهِۦ بَصِيرٗا","ﰎ",[15]],[84,16,"۞ فَلَآ أُقۡسِمُ بِالشَّفَقِ","ﰏ",[16]],[84,17,"وَاَلَّيۡلِ وَمَا وَسَقَ","ﰐ",[17]],[84,18,"وَاَلۡقَمَرِ إِذَا اَ۪تَّسَقَ","ﰑ",[18]],[84,19,"لَتَرۡكَبُنَّ طَبَقًا عَن طَبَقٖ","ﰒ",[19]],[84,20,"فَمَا لَهُمۡ لَا يُؤۡمِنُونَ","ﰓ",[20]],[84,21,"وَإِذَا قُرِيـَٔ عَلَيۡهِمِ اِ۬لۡقُرۡءَانُ لَا يَسۡجُدُونَۤ۩","ﰔ",[21]],[84,22,"بَلِ اِ۬لَّذِينَ كَفَرُواْ يُكَذِّبُونَ","ﰕ",[22]],[84,23,"وَاَللَّهُ أَعۡلَمُ بِمَا يُوعُونَ","ﰖ",[23]],[84,24,"فَبَشِّرۡهُم بِعَذَابٍ أَلِيمٍ","ﰗ",[24]]]