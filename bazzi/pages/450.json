[[37,103,"فَلَمَّا أَسۡلَمَا وَتَلَّهُۥ لِلۡجَبِينِ","ﱦ",[103]],[37,104,"وَنَٰدَيۡنَٰهُۥ أَن يَٰإِبۡرَٰهِيمُ","ﱧ",[104]],[37,105,"قَدۡ صَدَّقۡتَ ٱلرُّءۡيَاۚ إِنَّا كَذَٰلِكَ نَجۡزِي ٱلۡمُحۡسِنِينَ","ﱨ",[105]],[37,106,"إِنَّ هَٰذَا لَهُوَ ٱلۡبَلَٰٓؤُاْ ٱلۡمُبِينُ","ﱩ",[106]],[37,107,"وَفَدَيۡنَٰهُۥ بِذِبۡحٍ عَظِيمٖ","ﱪ",[107]],[37,108,"وَتَرَكۡنَا عَلَيۡهِۦ فِي ٱلۡأٓخِرِينَ","ﱫ",[108]],[37,109,"سَلَٰمٌ عَلَىٰ إِبۡرَٰهِيمَ","ﱬ",[109]],[37,110,"كَذَٰلِكَ نَجۡزِي ٱلۡمُحۡسِنِينَ","ﱭ",[110]],[37,111,"إِنَّهُۥ مِنۡ عِبَادِنَا ٱلۡمُؤۡمِنِينَ","ﱮ",[111]],[37,112,"وَبَشَّرۡنَٰهُۥ بِإِسۡحَٰقَ نَبِيّٗا مِّنَ ٱلصَّٰلِحِينَ","ﱯ",[112]],[37,113,"وَبَٰرَكۡنَا عَلَيۡهِۦ وَعَلَىٰ إِسۡحَٰقَۚ وَمِن ذُرِّيَّتِهِمَا مُحۡسِنٞ وَظَالِمٞ لِّنَفۡسِهِۦ مُبِينٞ","ﱰ",[113]],[37,114,"وَلَقَدۡ مَنَنَّا عَلَىٰ مُوسَىٰ وَهَٰرُونَ","ﱱ",[114]],[37,115,"وَنَجَّيۡنَٰهُمَا وَقَوۡمَهُمَا مِنَ ٱلۡكَرۡبِ ٱلۡعَظِيمِ","ﱲ",[115]],[37,116,"وَنَصَرۡنَٰهُمُۥ فَكَانُواْ هُمُ ٱلۡغَٰلِبِينَ","ﱳ",[116]],[37,117,"وَءَاتَيۡنَٰهُمَا ٱلۡكِتَٰبَ ٱلۡمُسۡتَبِينَ","ﱴ",[117]],[37,118,"وَهَدَيۡنَٰهُمَا ٱلصِّرَٰطَ ٱلۡمُسۡتَقِيمَ","ﱵ",[118]],[37,119,"وَتَرَكۡنَا عَلَيۡهِمَا فِي ٱلۡأٓخِرِينَ","ﱶ",[119]],[37,120,"سَلَٰمٌ عَلَىٰ مُوسَىٰ وَهَٰرُونَ","ﱷ",[120]],[37,121,"إِنَّا كَذَٰلِكَ نَجۡزِي ٱلۡمُحۡسِنِينَ","ﱸ",[121]],[37,122,"إِنَّهُمَا مِنۡ عِبَادِنَا ٱلۡمُؤۡمِنِينَ","ﱹ",[122]],[37,123,"وَإِنَّ إِلۡيَاسَ لَمِنَ ٱلۡمُرۡسَلِينَ","ﱺ",[123]],[37,124,"إِذۡ قَالَ لِقَوۡمِهِۦ أَلَا تَتَّقُونَ","ﱻ",[124]],[37,125,"أَتَدۡعُونَ بَعۡلٗا وَتَذَرُونَ أَحۡسَنَ ٱلۡخَٰلِقِينَ","ﱼ",[125]],[37,126,"ٱللَّهُ رَبُّكُمُۥ وَرَبُّ ءَابَآئِكُمُ ٱلۡأَوَّلِينَ","ﱽ",[126]]]