[[106,1,"لِإِيلَٰفِ قُرَيۡشٍ","ﰀ",[1]],[106,2,"إِۦلَٰفِهِمُۥ رِحۡلَةَ ٱلشِّتَآءِ وَٱلصَّيۡفِ","ﰁ",[2]],[106,3,"فَلۡيَعۡبُدُواْ رَبَّ هَٰذَا ٱلۡبَيۡتِ","ﰂ",[3]],[106,4,"ٱلَّذِي أَطۡعَمَهُمُۥ مِن جُوعٖ","ﰃ",[4]],[106,5,"وَءَامَنَهُمُۥ مِنۡ خَوۡفِۭ","ﰄ",[4]],[107,1,"أَرَءَيۡتَ ٱلَّذِي يُكَذِّبُ بِٱلدِّينِ","ﰀ",[1]],[107,2,"فَذَٰلِكَ ٱلَّذِي يَدُعُّ ٱلۡيَتِيمَ","ﰁ",[2]],[107,3,"وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلۡمِسۡكِينِ","ﰂ",[3]],[107,4,"فَوَيۡلٞ لِّلۡمُصَلِّينَ","ﰃ",[4]],[107,5,"ٱلَّذِينَ هُمُۥ عَن صَلَاتِهِمُۥ سَاهُونَ","ﰄ",[5]],[107,6,"ٱلَّذِينَ هُمُۥ يُرَآءُونَ وَيَمۡنَعُونَ ٱلۡمَاعُونَ","ﰅ",[6,7]],[108,1,"إِنَّا أَعۡطَيۡنَٰكَ ٱلۡكَوۡثَرَ","ﰀ",[1]],[108,2,"فَصَلِّ لِرَبِّكَ وَٱنۡحَرۡ","ﰁ",[2]],[108,3,"إِنَّ شَانِئَكَ هُوَ ٱلۡأَبۡتَرُ","ﰂ",[3]]]