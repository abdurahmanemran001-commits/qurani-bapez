[[77,20,"أَلَمۡ نَخۡلُقكُّمُۥ مِن مَّآءٖ مَّهِينٖ","ﰓ",[20]],[77,21,"فَجَعَلۡنَٰهُۥ فِي قَرَارٖ مَّكِينٍ","ﰔ",[21]],[77,22,"إِلَىٰ قَدَرٖ مَّعۡلُومٖ","ﰕ",[22]],[77,23,"فَقَدَرۡنَا فَنِعۡمَ ٱلۡقَٰدِرُونَ","ﰖ",[23]],[77,24,"وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ","ﰗ",[24]],[77,25,"أَلَمۡ نَجۡعَلِ ٱلۡأَرۡضَ كِفَاتًا","ﰘ",[25]],[77,26,"أَحۡيَآءٗ وَأَمۡوَٰتٗا","ﰙ",[26]],[77,27,"وَجَعَلۡنَا فِيهَا رَوَٰسِيَ شَٰمِخَٰتٖ وَأَسۡقَيۡنَٰكُمُۥ مَآءٗ فُرَاتٗا","ﰚ",[27]],[77,28,"وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ","ﰛ",[28]],[77,29,"ٱنطَلِقُواْ إِلَىٰ مَا كُنتُمُۥ بِهِۦ تُكَذِّبُونَ","ﰜ",[29]],[77,30,"ٱنطَلِقُواْ إِلَىٰ ظِلّٖ ذِي ثَلَٰثِ شُعَبٖ","ﰝ",[30]],[77,31,"لَّا ظَلِيلٖ وَلَا يُغۡنِي مِنَ ٱللَّهَبِ","ﰞ",[31]],[77,32,"إِنَّهَا تَرۡمِي بِشَرَرٖ كَٱلۡقَصۡرِ","ﰟ",[32]],[77,33,"كَأَنَّهُۥ جِمَٰلَٰتٞ صُفۡرٞ","ﰠ",[33]],[77,34,"وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ","ﰡ",[34]],[77,35,"هَٰذَا يَوۡمُ لَا يَنطِقُونَ","ﰢ",[35]],[77,36,"وَلَا يُؤۡذَنُ لَهُمُۥ فَيَعۡتَذِرُونَ","ﰣ",[36]],[77,37,"وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ","ﰤ",[37]],[77,38,"هَٰذَا يَوۡمُ ٱلۡفَصۡلِۖ جَمَعۡنَٰكُمُۥ وَٱلۡأَوَّلِينَ","ﰥ",[38]],[77,39,"فَإِن كَانَ لَكُمُۥ كَيۡدٞ فَكِيدُونِ","ﰦ",[39]],[77,40,"وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ","ﰧ",[40]],[77,41,"إِنَّ ٱلۡمُتَّقِينَ فِي ظِلَٰلٖ وَعِيُونٖ","ﰨ",[41]],[77,42,"وَفَوَٰكِهَ مِمَّا يَشۡتَهُونَ","ﰩ",[42]],[77,43,"كُلُواْ وَٱشۡرَبُواْ هَنِيٓــَٔۢا بِمَا كُنتُمُۥ تَعۡمَلُونَ","ﰪ",[43]],[77,44,"إِنَّا كَذَٰلِكَ نَجۡزِي ٱلۡمُحۡسِنِينَ","ﰫ",[44]],[77,45,"وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ","ﰬ",[45]],[77,46,"كُلُواْ وَتَمَتَّعُواْ قَلِيلًا إِنَّكُمُۥ مُجۡرِمُونَ","ﰭ",[46]],[77,47,"وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ","ﰮ",[47]],[77,48,"وَإِذَا قِيلَ لَهُمُ ٱرۡكَعُواْ لَا يَرۡكَعُونَ","ﰯ",[48]],[77,49,"وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ","ﰰ",[49]],[77,50,"فَبِأَيِّ حَدِيثِۭ بَعۡدَهُۥ يُؤۡمِنُونَ","ﰱ",[50]]]