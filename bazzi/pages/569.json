[[70,11,"يُبَصَّرُونَهُمُۥۚ يَوَدُّ ٱلۡمُجۡرِمُ لَوۡ يَفۡتَدِي مِنۡ عَذَابِ يَوۡمِئِذِۭ بِبَنِيهِۦ","ﰊ",[11]],[70,12,"وَصَٰحِبَتِهِۦ وَأَخِيهِۦ","ﰋ",[12]],[70,13,"وَفَصِيلَتِهِ ٱلَّتِي تُــٔۡوِيهِۦ","ﰌ",[13]],[70,14,"وَمَن فِي ٱلۡأَرۡضِ جَمِيعٗا ثُمَّ يُنجِيهِۦ","ﰍ",[14]],[70,15,"كَلَّاۖ إِنَّهَا لَظَىٰ","ﰎ",[15]],[70,16,"نَزَّاعَةٞ لِّلشَّوَىٰ","ﰏ",[16]],[70,17,"تَدۡعُواْ مَنۡ أَدۡبَرَ وَتَوَلَّىٰ","ﰐ",[17]],[70,18,"وَجَمَعَ فَأَوۡعَىٰ","ﰑ",[18]],[70,19,"۞إِنَّ ٱلۡإِنسَٰنَ خُلِقَ هَلُوعًا","ﰒ",[19]],[70,20,"إِذَا مَسَّهُ ٱلشَّرُّ جَزُوعٗا","ﰓ",[20]],[70,21,"وَإِذَا مَسَّهُ ٱلۡخَيۡرُ مَنُوعًا","ﰔ",[21]],[70,22,"إِلَّا ٱلۡمُصَلِّينَ","ﰕ",[22]],[70,23,"ٱلَّذِينَ هُمُۥ عَلَىٰ صَلَاتِهِمُۥ دَآئِمُونَ","ﰖ",[23]],[70,24,"وَٱلَّذِينَ فِي أَمۡوَٰلِهِمُۥ حَقّٞ مَّعۡلُومٞ","ﰗ",[24]],[70,25,"لِّلسَّآئِلِ وَٱلۡمَحۡرُومِ","ﰘ",[25]],[70,26,"وَٱلَّذِينَ يُصَدِّقُونَ بِيَوۡمِ ٱلدِّينِ","ﰙ",[26]],[70,27,"وَٱلَّذِينَ هُمُۥ مِنۡ عَذَابِ رَبِّهِمُۥ مُشۡفِقُونَ","ﰚ",[27]],[70,28,"إِنَّ عَذَابَ رَبِّهِمُۥ غَيۡرُ مَأۡمُونٖ","ﰛ",[28]],[70,29,"وَٱلَّذِينَ هُمُۥ لِفُرُوجِهِمُۥ حَٰفِظُونَ","ﰜ",[29]],[70,30,"إِلَّا عَلَىٰ أَزۡوَٰجِهِمُۥ أَوۡ مَا مَلَكَتۡ أَيۡمَٰنُهُمُۥ فَإِنَّهُمُۥ غَيۡرُ مَلُومِينَ","ﰝ",[30]],[70,31,"فَمَنِ ٱبۡتَغَىٰ وَرَآءَ ذَٰلِكَ فَأُوْلَٰٓئِكَ هُمُ ٱلۡعَادُونَ","ﰞ",[31]],[70,32,"وَٱلَّذِينَ هُمُۥ لِأَمَٰنَتِهِمُۥ وَعَهۡدِهِمُۥ رَٰعُونَ","ﰟ",[32]],[70,33,"وَٱلَّذِينَ هُمُۥ بِشَهَٰدَتِهِمُۥ قَآئِمُونَ","ﰠ",[33]],[70,34,"وَٱلَّذِينَ هُمُۥ عَلَىٰ صَلَاتِهِمُۥ يُحَافِظُونَ","ﰡ",[34]],[70,35,"أُوْلَٰٓئِكَ فِي جَنَّٰتٖ مُّكۡرَمُونَ","ﰢ",[35]],[70,36,"فَمَالِ ٱلَّذِينَ كَفَرُواْ قِبَلَكَ مُهۡطِعِينَ","ﰣ",[36]],[70,37,"عَنِ ٱلۡيَمِينِ وَعَنِ ٱلشِّمَالِ عِزِينَ","ﰤ",[37]],[70,38,"أَيَطۡمَعُ كُلُّ ٱمۡرِيٕٖ مِّنۡهُمُۥ أَن يُدۡخَلَ جَنَّةَ نَعِيمٖ","ﰥ",[38]],[70,39,"كَلَّاۖ إِنَّا خَلَقۡنَٰهُمُۥ مِمَّا يَعۡلَمُونَ","ﰦ",[39]],[70,40,"فَلَا أُقۡسِمُ بِرَبِّ ٱلۡمَشَٰرِقِ وَٱلۡمَغَٰرِبِ إِنَّا لَقَٰدِرُونَ","ﰧ",[40]]]