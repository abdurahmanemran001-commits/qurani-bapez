[[74,47,"فَمَا تَنفَعُهُمُۥ شَفَٰعَةُ ٱلشَّٰفِعِينَ","ﰮ",[48]],[74,48,"فَمَا لَهُمُۥ عَنِ ٱلتَّذۡكِرَةِ مُعۡرِضِينَ","ﰯ",[49]],[74,49,"كَأَنَّهُمُۥ حُمُرٞ مُّسۡتَنفِرَةٞ","ﰰ",[50]],[74,50,"فَرَّتۡ مِن قَسۡوَرَةِۭ","ﰱ",[51]],[74,51,"بَلۡ يُرِيدُ كُلُّ ٱمۡرِيٕٖ مِّنۡهُمُۥ أَن يُؤۡتَىٰ صُحُفٗا مُّنَشَّرَةٗ","ﰲ",[52]],[74,52,"كَلَّاۖ بَل لَّا يَخَافُونَ ٱلۡأٓخِرَةَ","ﰳ",[53]],[74,53,"كَلَّا إِنَّهُۥ تَذۡكِرَةٞ","ﰴ",[54]],[74,54,"فَمَن شَآءَ ذَكَرَهُۥ","ﰵ",[55]],[74,55,"وَمَا يَذۡكُرُونَ إِلَّا أَن يَشَآءَ ٱللَّهُۚ هُوَ أَهۡلُ ٱلتَّقۡوَىٰ وَأَهۡلُ ٱلۡمَغۡفِرَةِ","ﰶ",[56]],[75,1,"لَأُاْقۡسِمُ بِيَوۡمِ ٱلۡقِيَٰمَةِ","ﰀ",[1]],[75,2,"وَلَا أُقۡسِمُ بِٱلنَّفۡسِ ٱللَّوَّامَةِ","ﰁ",[2]],[75,3,"أَيَحۡسِبُ ٱلۡإِنسَٰنُ أَلَّن نَّجۡمَعَ عِظَامَهُۥ","ﰂ",[3]],[75,4,"بَلَىٰ قَٰدِرِينَ عَلَىٰ أَن نُّسَوِّيَ بَنَانَهُۥ","ﰃ",[4]],[75,5,"بَلۡ يُرِيدُ ٱلۡإِنسَٰنُ لِيَفۡجُرَ أَمَامَهُۥ","ﰄ",[5]],[75,6,"يَسۡــَٔلُ أَيَّانَ يَوۡمُ ٱلۡقِيَٰمَةِ","ﰅ",[6]],[75,7,"فَإِذَا بَرِقَ ٱلۡبَصَرُ","ﰆ",[7]],[75,8,"وَخَسَفَ ٱلۡقَمَرُ","ﰇ",[8]],[75,9,"وَجُمِعَ ٱلشَّمۡسُ وَٱلۡقَمَرُ","ﰈ",[9]],[75,10,"يَقُولُ ٱلۡإِنسَٰنُ يَوۡمَئِذٍ أَيۡنَ ٱلۡمَفَرُّ","ﰉ",[10]],[75,11,"كَلَّا لَا وَزَرَ","ﰊ",[11]],[75,12,"إِلَىٰ رَبِّكَ يَوۡمَئِذٍ ٱلۡمُسۡتَقَرُّ","ﰋ",[12]],[75,13,"يُنَبَّؤُاْ ٱلۡإِنسَٰنُ يَوۡمَئِذِۭ بِمَا قَدَّمَ وَأَخَّرَ","ﰌ",[13]],[75,14,"بَلِ ٱلۡإِنسَٰنُ عَلَىٰ نَفۡسِهِۦ بَصِيرَةٞ","ﰍ",[14]],[75,15,"وَلَوۡ أَلۡقَىٰ مَعَاذِيرَهُۥ","ﰎ",[15]],[75,16,"لَا تُحَرِّكۡ بِهِۦ لِسَانَكَ لِتَعۡجَلَ بِهِۦ إِنَّ عَلَيۡنَا جَمۡعَهُۥ وَقُرَانَهُۥ","ﰏ",[16,17]],[75,17,"فَإِذَا قَرَأۡنَٰهُۥ فَٱتَّبِعۡ قُرَانَهُۥ","ﰐ",[18]],[75,18,"ثُمَّ إِنَّ عَلَيۡنَا بَيَانَهُۥ","ﰑ",[19]]]