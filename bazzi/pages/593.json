[[88,23,"إِلَّا مَن تَوَلَّىٰ وَكَفَرَ","ﰖ",[23]],[88,24,"فَيُعَذِّبُهُ ٱللَّهُ ٱلۡعَذَابَ ٱلۡأَكۡبَرَ","ﰗ",[24]],[88,25,"إِنَّ إِلَيۡنَا إِيَابَهُمُۥ","ﰘ",[25]],[88,26,"ثُمَّ إِنَّ عَلَيۡنَا حِسَابَهُمُۥ","ﰙ",[26]],[89,1,"وَٱلۡفَجۡرِ","ﰀ",[1]],[89,2,"وَلَيَالٍ عَشۡرٖ","ﰁ",[2]],[89,3,"وَٱلشَّفۡعِ وَٱلۡوَتۡرِ","ﰂ",[3]],[89,4,"وَٱلَّيۡلِ إِذَا يَسۡرِۦ","ﰃ",[4]],[89,5,"هَلۡ فِي ذَٰلِكَ قَسَمٞ لِّذِي حِجۡرٍ","ﰄ",[5]],[89,6,"أَلَمۡ تَرَ كَيۡفَ فَعَلَ رَبُّكَ بِعَادٍ","ﰅ",[6]],[89,7,"إِرَمَ ذَاتِ ٱلۡعِمَادِ","ﰆ",[7]],[89,8,"ٱلَّتِي لَمۡ يُخۡلَقۡ مِثۡلُهَا فِي ٱلۡبِلَٰدِ","ﰇ",[8]],[89,9,"وَثَمُودَ ٱلَّذِينَ جَابُواْ ٱلصَّخۡرَ بِٱلۡوَادِۦ","ﰈ",[9]],[89,10,"وَفِرۡعَوۡنَ ذِي ٱلۡأَوۡتَادِ","ﰉ",[10]],[89,11,"ٱلَّذِينَ طَغَوۡاْ فِي ٱلۡبِلَٰدِ","ﰊ",[11]],[89,12,"فَأَكۡثَرُواْ فِيهَا ٱلۡفَسَادَ","ﰋ",[12]],[89,13,"فَصَبَّ عَلَيۡهِمُۥ رَبُّكَ سَوۡطَ عَذَابٍ","ﰌ",[13]],[89,14,"إِنَّ رَبَّكَ لَبِٱلۡمِرۡصَادِ","ﰍ",[14]],[89,15,"فَأَمَّا ٱلۡإِنسَٰنُ إِذَا مَا ٱبۡتَلَىٰهُۥ رَبُّهُۥ فَأَكۡرَمَهُۥ وَنَعَّمَهُۥ","ﰎ",[15]],[89,16,"فَيَقُولُ رَبِّيَ أَكۡرَمَنِۦ","ﰏ",[15]],[89,17,"وَأَمَّا إِذَا مَا ٱبۡتَلَىٰهُۥ فَقَدَرَ عَلَيۡهِۦ رِزۡقَهُۥ","ﰐ",[16]],[89,18,"فَيَقُولُ رَبِّيَ أَهَٰنَنِۦ","ﰑ",[16]],[89,19,"كَلَّاۖ بَل لَّا تُكۡرِمُونَ ٱلۡيَتِيمَ","ﰒ",[17]],[89,20,"وَلَا تَحُضُّونَ عَلَىٰ طَعَامِ ٱلۡمِسۡكِينِ","ﰓ",[18]],[89,21,"وَتَأۡكُلُونَ ٱلتُّرَاثَ أَكۡلٗا لَّمّٗا","ﰔ",[19]],[89,22,"وَتُحِبُّونَ ٱلۡمَالَ حُبّٗا جَمّٗا","ﰕ",[20]],[89,23,"كَلَّاۖ إِذَا دُكَّتِ ٱلۡأَرۡضُ دَكّٗا دَكّٗا","ﰖ",[21]],[89,24,"وَجَآءَ رَبُّكَ وَٱلۡمَلَكُ صَفّٗا صَفّٗا","ﰗ",[22]]]