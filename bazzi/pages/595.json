[[90,19,"وَٱلَّذِينَ كَفَرُواْ بِــَٔايَٰتِنَا هُمُۥ أَصۡحَٰبُ ٱلۡمَشۡــَٔمَةِ","ﰒ",[19]],[90,20,"عَلَيۡهِمُۥ نَارٞ مُّوصَدَةُۢ","ﰓ",[20]],[91,1,"وَٱلشَّمۡسِ وَضُحَىٰهَا","ﰀ",[1]],[91,2,"وَٱلۡقَمَرِ إِذَا تَلَىٰهَا","ﰁ",[2]],[91,3,"وَٱلنَّهَارِ إِذَا جَلَّىٰهَا","ﰂ",[3]],[91,4,"وَٱلَّيۡلِ إِذَا يَغۡشَىٰهَا","ﰃ",[4]],[91,5,"وَٱلسَّمَآءِ وَمَا بَنَىٰهَا","ﰄ",[5]],[91,6,"وَٱلۡأَرۡضِ وَمَا طَحَىٰهَا","ﰅ",[6]],[91,7,"وَنَفۡسٖ وَمَا سَوَّىٰهَا","ﰆ",[7]],[91,8,"فَأَلۡهَمَهَا فُجُورَهَا وَتَقۡوَىٰهَا","ﰇ",[8]],[91,9,"قَدۡ أَفۡلَحَ مَن زَكَّىٰهَا","ﰈ",[9]],[91,10,"وَقَدۡ خَابَ مَن دَسَّىٰهَا","ﰉ",[10]],[91,11,"كَذَّبَتۡ ثَمُودُ بِطَغۡوَىٰهَا","ﰊ",[11]],[91,12,"إِذِ ٱنۢبَعَثَ أَشۡقَىٰهَا","ﰋ",[12]],[91,13,"فَقَالَ لَهُمُۥ رَسُولُ ٱللَّهِ نَاقَةَ ٱللَّهِ وَسُقۡيَٰهَا","ﰌ",[13]],[91,14,"فَكَذَّبُوهُۥ فَعَقَرُوهَا فَدَمۡدَمَ عَلَيۡهِمُۥ رَبُّهُمُۥ بِذَنۢبِهِمُۥ فَسَوَّىٰهَا","ﰍ",[14]],[91,15,"وَلَا يَخَافُ عُقۡبَٰهَا","ﰎ",[15]],[92,1,"وَٱلَّيۡلِ إِذَا يَغۡشَىٰ","ﰀ",[1]],[92,2,"وَٱلنَّهَارِ إِذَا تَجَلَّىٰ","ﰁ",[2]],[92,3,"وَمَا خَلَقَ ٱلذَّكَرَ وَٱلۡأُنثَىٰ","ﰂ",[3]],[92,4,"إِنَّ سَعۡيَكُمُۥ لَشَتَّىٰ","ﰃ",[4]],[92,5,"فَأَمَّا مَنۡ أَعۡطَىٰ وَٱتَّقَىٰ","ﰄ",[5]],[92,6,"وَصَدَّقَ بِٱلۡحُسۡنَىٰ","ﰅ",[6]],[92,7,"فَسَنُيَسِّرُهُۥ لِلۡيُسۡرَىٰ","ﰆ",[7]],[92,8,"وَأَمَّا مَنۢ بَخِلَ وَٱسۡتَغۡنَىٰ","ﰇ",[8]],[92,9,"وَكَذَّبَ بِٱلۡحُسۡنَىٰ","ﰈ",[9]]]