[[54,50,"وَمَا أَمۡرُنَا إِلَّا وَٰحِدَةٞ كَلَمۡحِۭ بِٱلۡبَصَرِ","ﰱ",[50]],[54,51,"وَلَقَدۡ أَهۡلَكۡنَا أَشۡيَاعَكُمُۥ فَهَلۡ مِن مُّدَّكِرٖ","ﰲ",[51]],[54,52,"وَكُلُّ شَيۡءٖ فَعَلُوهُۥ فِي ٱلزُّبُرِ","ﰳ",[52]],[54,53,"وَكُلُّ صَغِيرٖ وَكَبِيرٖ مُّسۡتَطَرٌ","ﰴ",[53]],[54,54,"إِنَّ ٱلۡمُتَّقِينَ فِي جَنَّٰتٖ وَنَهَرٖ","ﰵ",[54]],[54,55,"فِي مَقۡعَدِ صِدۡقٍ عِندَ مَلِيكٖ مُّقۡتَدِرِۭ","ﰶ",[55]],[55,1,"ٱلرَّحۡمَٰنُ عَلَّمَ ٱلۡقُرَانَ","ﰀ",[1,2]],[55,2,"خَلَقَ ٱلۡإِنسَٰنَ","ﰁ",[3]],[55,3,"عَلَّمَهُ ٱلۡبَيَانَ","ﰂ",[4]],[55,4,"ٱلشَّمۡسُ وَٱلۡقَمَرُ بِحُسۡبَانٖ","ﰃ",[5]],[55,5,"وَٱلنَّجۡمُ وَٱلشَّجَرُ يَسۡجُدَانِ","ﰄ",[6]],[55,6,"وَٱلسَّمَآءَ رَفَعَهَا وَوَضَعَ ٱلۡمِيزَانَ","ﰅ",[7]],[55,7,"أَلَّا تَطۡغَوۡاْ فِي ٱلۡمِيزَانِ","ﰆ",[8]],[55,8,"وَأَقِيمُواْ ٱلۡوَزۡنَ بِٱلۡقِسۡطِ وَلَا تُخۡسِرُواْ ٱلۡمِيزَانَ","ﰇ",[9]],[55,9,"وَٱلۡأَرۡضَ وَضَعَهَا لِلۡأَنَامِ فِيهَا فَٰكِهَةٞ وَٱلنَّخۡلُ ذَاتُ ٱلۡأَكۡمَامِ","ﰈ",[10,11]],[55,10,"وَٱلۡحَبُّ ذُو ٱلۡعَصۡفِ وَٱلرَّيۡحَانُ","ﰉ",[12]],[55,11,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","ﰊ",[13]],[55,12,"خَلَقَ ٱلۡإِنسَٰنَ مِن صَلۡصَٰلٖ كَٱلۡفَخَّارِ","ﰋ",[14]],[55,13,"وَخَلَقَ ٱلۡجَآنَّ مِن مَّارِجٖ مِّن نَّارٖ","ﰌ",[15]],[55,14,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","ﰍ",[16]],[55,15,"رَبُّ ٱلۡمَشۡرِقَيۡنِ وَرَبُّ ٱلۡمَغۡرِبَيۡنِ","ﰎ",[17]],[55,16,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","ﰏ",[18]]]