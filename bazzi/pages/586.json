[[80,41,"تَرۡهَقُهَا قَتَرَةٌ","ﰨ",[41]],[80,42,"أُوْلَٰٓئِكَ هُمُ ٱلۡكَفَرَةُ ٱلۡفَجَرَةُ","ﰩ",[42]],[81,1,"إِذَا ٱلشَّمۡسُ كُوِّرَتۡ","ﰀ",[1]],[81,2,"وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتۡ","ﰁ",[2]],[81,3,"وَإِذَا ٱلۡجِبَالُ سُيِّرَتۡ","ﰂ",[3]],[81,4,"وَإِذَا ٱلۡعِشَارُ عُطِّلَتۡ","ﰃ",[4]],[81,5,"وَإِذَا ٱلۡوُحُوشُ حُشِرَتۡ","ﰄ",[5]],[81,6,"وَإِذَا ٱلۡبِحَارُ سُجِرَتۡ","ﰅ",[6]],[81,7,"وَإِذَا ٱلنُّفُوسُ زُوِّجَتۡ","ﰆ",[7]],[81,8,"وَإِذَا ٱلۡمَوۡءُۥدَةُ سُئِلَتۡ","ﰇ",[8]],[81,9,"بِأَيِّ ذَنۢبٖ قُتِلَتۡ","ﰈ",[9]],[81,10,"وَإِذَا ٱلصُّحُفُ نُشِّرَتۡ","ﰉ",[10]],[81,11,"وَإِذَا ٱلسَّمَآءُ كُشِطَتۡ","ﰊ",[11]],[81,12,"وَإِذَا ٱلۡجَحِيمُ سُعِرَتۡ","ﰋ",[12]],[81,13,"وَإِذَا ٱلۡجَنَّةُ أُزۡلِفَتۡ","ﰌ",[13]],[81,14,"عَلِمَتۡ نَفۡسٞ مَّا أَحۡضَرَتۡ","ﰍ",[14]],[81,15,"فَلَا أُقۡسِمُ بِٱلۡخُنَّسِ","ﰎ",[15]],[81,16,"ٱلۡجَوَارِ ٱلۡكُنَّسِ","ﰏ",[16]],[81,17,"وَٱلَّيۡلِ إِذَا عَسۡعَسَ","ﰐ",[17]],[81,18,"وَٱلصُّبۡحِ إِذَا تَنَفَّسَ","ﰑ",[18]],[81,19,"إِنَّهُۥ لَقَوۡلُ رَسُولٖ كَرِيمٖ","ﰒ",[19]],[81,20,"ذِي قُوَّةٍ عِندَ ذِي ٱلۡعَرۡشِ مَكِينٖ","ﰓ",[20]],[81,21,"مُّطَاعٖ ثَمَّ أَمِينٖ","ﰔ",[21]],[81,22,"وَمَا صَاحِبُكُمُۥ بِمَجۡنُونٖ","ﰕ",[22]],[81,23,"وَلَقَدۡ رَءَاهُۥ بِٱلۡأُفُقِ ٱلۡمُبِينِ","ﰖ",[23]],[81,24,"وَمَا هُوَ عَلَى ٱلۡغَيۡبِ بِضظَنِينٖ","ﰗ",[24]],[81,25,"وَمَا هُوَ بِقَوۡلِ شَيۡطَٰنٖ رَّجِيمٖ","ﰘ",[25]],[81,26,"فَأَيۡنَ تَذۡهَبُونَ","ﰙ",[26]],[81,27,"إِنۡ هُوَ إِلَّا ذِكۡرٞ لِّلۡعَٰلَمِينَ","ﰚ",[27]],[81,28,"لِمَن شَآءَ مِنكُمُۥ أَن يَسۡتَقِيمَ","ﰛ",[28]],[81,29,"وَمَا تَشَآءُونَ إِلَّا أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلۡعَٰلَمِينَ","ﰜ",[29]]]