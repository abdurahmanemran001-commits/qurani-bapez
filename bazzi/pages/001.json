[[1,1,"بِسۡمِ ٱللَّهِ ٱلرَّحۡمَٰنِ ٱلرَّحِيمِ","ﰀ",[1]],[1,2,"ٱلۡحَمۡدُ لِلَّهِ رَبِّ ٱلۡعَٰلَمِينَ","ﰁ",[2]],[1,3,"ٱلرَّحۡمَٰنِ ٱلرَّحِيمِ","ﰂ",[3]],[1,4,"مَلِكِ يَوۡمِ ٱلدِّينِ","ﰃ",[4]],[1,5,"إِيَّاكَ نَعۡبُدُ وَإِيَّاكَ نَسۡتَعِينُ","ﰄ",[5]],[1,6,"ٱهۡدِنَا ٱلصِّرَٰطَ ٱلۡمُسۡتَقِيمَ","ﰅ",[6]],[1,7,"صِرَٰطَ ٱلَّذِينَ أَنۡعَمۡتَ عَلَيۡهِمُۥ غَيۡرِ ٱلۡمَغۡضُوبِ عَلَيۡهِمُۥ وَلَا ٱلضَّآلِّينَ","ﰆ",[7]]]