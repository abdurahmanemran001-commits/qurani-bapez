[[56,54,"ثُمَّ إِنَّكُمُۥ أَيُّهَا ٱلضَّآلُّونَ ٱلۡمُكَذِّبُونَ","ﰵ",[51]],[56,55,"لَأٓكِلُونَ مِن شَجَرٖ مِّن زَقُّومٖ","ﰶ",[52]],[56,56,"فَمَالِــُٔونَ مِنۡهَا ٱلۡبُطُونَ","ﰷ",[53]],[56,57,"فَشَٰرِبُونَ عَلَيۡهِۦ مِنَ ٱلۡحَمِيمِ","ﰸ",[54]],[56,58,"فَشَٰرِبُونَ شَرۡبَ ٱلۡهِيمِ","ﰹ",[55]],[56,59,"هَٰذَا نُزُلُهُمُۥ يَوۡمَ ٱلدِّينِ","ﰺ",[56]],[56,60,"نَحۡنُ خَلَقۡنَٰكُمُۥ فَلَوۡلَا تُصَدِّقُونَ","ﰻ",[57]],[56,61,"أَفَرَءَيۡتُمُۥ مَا تُمۡنُونَ","ﰼ",[58]],[56,62,"ءَا۬نتُمُۥ تَخۡلُقُونَهُۥ أَمۡ نَحۡنُ ٱلۡخَٰلِقُونَ","ﰽ",[59]],[56,63,"نَحۡنُ قَدَرۡنَا بَيۡنَكُمُ ٱلۡمَوۡتَ وَمَا نَحۡنُ بِمَسۡبُوقِينَ","ﰾ",[60]],[56,64,"عَلَىٰ أَن نُّبَدِّلَ أَمۡثَٰلَكُمُۥ وَنُنشِئَكُمُۥ فِي مَا لَا تَعۡلَمُونَ","ﰿ",[61]],[56,65,"وَلَقَدۡ عَلِمۡتُمُ ٱلنَّشَآءَةَ ٱلۡأُولَىٰ فَلَوۡلَا تَذَّكَّرُونَ","ﱀ",[62]],[56,66,"أَفَرَءَيۡتُمُۥ مَا تَحۡرُثُونَ","ﱁ",[63]],[56,67,"ءَا۬نتُمُۥ تَزۡرَعُونَهُۥ أَمۡ نَحۡنُ ٱلزَّٰرِعُونَ","ﱂ",[64]],[56,68,"لَوۡ نَشَآءُ لَجَعَلۡنَٰهُۥ حُطَٰمٗا فَظَلۡتُمُۥ تَفَكَّهُونَ","ﱃ",[65]],[56,69,"إِنَّا لَمُغۡرَمُونَ","ﱄ",[66]],[56,70,"بَلۡ نَحۡنُ مَحۡرُومُونَ","ﱅ",[67]],[56,71,"أَفَرَءَيۡتُمُ ٱلۡمَآءَ ٱلَّذِي تَشۡرَبُونَ","ﱆ",[68]],[56,72,"ءَا۬نتُمُۥ أَنزَلۡتُمُوهُۥ مِنَ ٱلۡمُزۡنِ أَمۡ نَحۡنُ ٱلۡمُنزِلُونَ","ﱇ",[69]],[56,73,"لَوۡ نَشَآءُ جَعَلۡنَٰهُۥ أُجَاجٗا فَلَوۡلَا تَشۡكُرُونَ","ﱈ",[70]],[56,74,"أَفَرَءَيۡتُمُ ٱلنَّارَ ٱلَّتِي تُورُونَ","ﱉ",[71]],[56,75,"ءَا۬نتُمُۥ أَنشَأۡتُمُۥ شَجَرَتَهَا أَمۡ نَحۡنُ ٱلۡمُنشِــُٔونَ","ﱊ",[72]],[56,76,"نَحۡنُ جَعَلۡنَٰهَا تَذۡكِرَةٗ وَمَتَٰعٗا لِّلۡمُقۡوِينَ","ﱋ",[73]],[56,77,"فَسَبِّحۡ بِٱسۡمِ رَبِّكَ ٱلۡعَظِيمِ","ﱌ",[74]],[56,78,"۞فَلَا أُقۡسِمُ بِمَوَٰقِعِ ٱلنُّجُومِ","ﱍ",[75]],[56,79,"وَإِنَّهُۥ لَقَسَمٞ لَّوۡ تَعۡلَمُونَ عَظِيمٌ","ﱎ",[76]]]