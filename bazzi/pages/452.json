[[37,154,"مَا لَكُمُۥ كَيۡفَ تَحۡكُمُونَ","ﲙ",[154]],[37,155,"أَفَلَا تَذَّكَّرُونَ","ﲚ",[155]],[37,156,"أَمۡ لَكُمُۥ سُلۡطَٰنٞ مُّبِينٞ","ﲛ",[156]],[37,157,"فَأۡتُواْ بِكِتَٰبِكُمُۥ إِن كُنتُمُۥ صَٰدِقِينَ","ﲜ",[157]],[37,158,"وَجَعَلُواْ بَيۡنَهُۥ وَبَيۡنَ ٱلۡجِنَّةِ نَسَبٗاۚ وَلَقَدۡ عَلِمَتِ ٱلۡجِنَّةُ إِنَّهُمُۥ لَمُحۡضَرُونَ","ﲝ",[158]],[37,159,"سُبۡحَٰنَ ٱللَّهِ عَمَّا يَصِفُونَ","ﲞ",[159]],[37,160,"إِلَّا عِبَادَ ٱللَّهِ ٱلۡمُخۡلِصِينَ","ﲟ",[160]],[37,161,"فَإِنَّكُمُۥ وَمَا تَعۡبُدُونَ","ﲠ",[161]],[37,162,"مَا أَنتُمُۥ عَلَيۡهِۦ بِفَٰتِنِينَ","ﲡ",[162]],[37,163,"إِلَّا مَنۡ هُوَ صَالِ ٱلۡجَحِيمِ","ﲢ",[163]],[37,164,"وَمَا مِنَّا إِلَّا لَهُۥ مَقَامٞ مَّعۡلُومٞ","ﲣ",[164]],[37,165,"وَإِنَّا لَنَحۡنُ ٱلصَّآفُّونَ","ﲤ",[165]],[37,166,"وَإِنَّا لَنَحۡنُ ٱلۡمُسَبِّحُونَ","ﲥ",[166]],[37,167,"وَإِن كَانُواْ لَيَقُولُونَ","ﲦ",[167]],[37,168,"لَوۡ أَنَّ عِندَنَا ذِكۡرٗا مِّنَ ٱلۡأَوَّلِينَ","ﲧ",[168]],[37,169,"لَكُنَّا عِبَادَ ٱللَّهِ ٱلۡمُخۡلِصِينَ","ﲨ",[169]],[37,170,"فَكَفَرُواْ بِهِۦۖ فَسَوۡفَ يَعۡلَمُونَ","ﲩ",[170]],[37,171,"وَلَقَدۡ سَبَقَتۡ كَلِمَتُنَا لِعِبَادِنَا ٱلۡمُرۡسَلِينَ","ﲪ",[171]],[37,172,"إِنَّهُمُۥ لَهُمُ ٱلۡمَنصُورُونَ","ﲫ",[172]],[37,173,"وَإِنَّ جُندَنَا لَهُمُ ٱلۡغَٰلِبُونَ","ﲬ",[173]],[37,174,"فَتَوَلَّ عَنۡهُمُۥ حَتَّىٰ حِينٖ","ﲭ",[174]],[37,175,"وَأَبۡصِرۡهُمُۥ فَسَوۡفَ يُبۡصِرُونَ","ﲮ",[175]],[37,176,"أَفَبِعَذَابِنَا يَسۡتَعۡجِلُونَ","ﲯ",[176]],[37,177,"فَإِذَا نَزَلَ بِسَاحَتِهِمُۥ فَسَآءَ صَبَاحُ ٱلۡمُنذَرِينَ","ﲰ",[177]],[37,178,"وَتَوَلَّ عَنۡهُمُۥ حَتَّىٰ حِينٖ","ﲱ",[178]],[37,179,"وَأَبۡصِرۡ فَسَوۡفَ يُبۡصِرُونَ","ﲲ",[179]],[37,180,"سُبۡحَٰنَ رَبِّكَ رَبِّ ٱلۡعِزَّةِ عَمَّا يَصِفُونَ","ﲳ",[180]],[37,181,"وَسَلَٰمٌ عَلَى ٱلۡمُرۡسَلِينَ","ﲴ",[181]],[37,182,"وَٱلۡحَمۡدُ لِلَّهِ رَبِّ ٱلۡعَٰلَمِينَ","ﲵ",[182]]]