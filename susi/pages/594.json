[[89,25,"وَجِاْيٓءَ يَوۡمَئِذِۢ بِجَهَنَّمَ","ﰘ",[23]],[89,26,"يَوۡمَئِذٖ يَتَذَكَّرُ اُ۬لۡإِنسَٰنُ وَأَنَّىٰ لَهُ اُ۬لذِّكۡر۪يٰ","ﰙ",[23]],[89,27,"يَقُولُ يَٰلَيۡتَنِي قَدَّمۡتُ لِحَيَاتِي","ﰚ",[24]],[89,28,"فَيَوۡمَئِذٖ لَّا يُعَذِّبُ عَذَابَهُۥ أَحَدٞ","ﰛ",[25]],[89,29,"وَلَا يُوثِقُ وَثَاقَهُۥ أَحَدٞ","ﰜ",[26]],[89,30,"يَٰأَيَّتُهَا اَ۬لنَّفۡسُ اُ۬لۡمُطۡمَئِنَّةُ","ﰝ",[27]],[89,31,"اُ۪رۡجِعِي إِلَىٰ رَبِّكِ رَاضِيَةٗ مَّرۡضِيَّةٗ","ﰞ",[28]],[89,32,"فَاَدۡخُلِي فِي عِبَٰدِي وَاَدۡخُلِي جَنَّتِي","ﰟ",[29,30]],[90,1,"لَا أُقۡسِم بِهَٰذَا اَ۬لۡبَلَدِ","ﰀ",[1]],[90,2,"وَأَنتَ حِلُّۢ بِهَٰذَا اَ۬لۡبَلَدِ","ﰁ",[2]],[90,3,"وَوَالِدٖ وَمَا وَلَدَ","ﰂ",[3]],[90,4,"لَقَدۡ خَلَقۡنَا اَ۬لۡإِنسَٰنَ فِي كَبَدٍ","ﰃ",[4]],[90,5,"أَيَحۡسِبُ أَن لَّن يَقۡدِرَ عَلَيۡهِ أَحَدٞ","ﰄ",[5]],[90,6,"يَقُولُ أَهۡلَكۡتُ مَالٗا لُّبَدًا","ﰅ",[6]],[90,7,"أَيَحۡسِبُ أَن لَّمۡ يَرَهُۥ أَحَدٌ","ﰆ",[7]],[90,8,"أَلَمۡ نَجۡعَل لَّهُۥ عَيۡنَيۡنِ","ﰇ",[8]],[90,9,"وَلِسَانٗا وَشَفَتَيۡنِ","ﰈ",[9]],[90,10,"وَهَدَيۡنَٰهُ اُ۬لنَّجۡدَيۡنِ","ﰉ",[10]],[90,11,"فَلَا اَ۪قۡتَحَمَ اَ۬لۡعَقَبَةَ","ﰊ",[11]],[90,12,"وَمَا أَدۡر۪ىٰكَ مَا اَ۬لۡعَقَبَةُ","ﰋ",[12]],[90,13,"فَكَّ رَقَبَةً","ﰌ",[13]],[90,14,"أَوۡ أَطۡعَمَ فِي يَوۡمٖ ذِي مَسۡغَبَةٖ","ﰍ",[14]],[90,15,"يَتِيمٗا ذَا مَقۡرَبَةٍ","ﰎ",[15]],[90,16,"أَوۡ مِسۡكِينٗا ذَا مَتۡرَبَةٖ","ﰏ",[16]],[90,17,"ثُمَّ كَانَ مِنَ اَ۬لَّذِينَ ءَامَنُواْ وَتَوَاصَوۡاْ بِالصَّبۡرِ وَتَوَاصَوۡاْ بِالۡمَرۡحَمَةِ","ﰐ",[17]],[90,18,"أُوْلَٰٓئِكَ أَصۡحَٰبُ اُ۬لۡمَيۡمَنَةِ","ﰑ",[18]]]