[[70,11,"يُبَصَّرُونَهُمۡۚ يَوَدُّ اُ۬لۡمُجۡرِمُ لَوۡ يَفۡتَدِي مِنۡ عَذَابِ يَوۡمِئِذِۢ بِبَنِيهِ","ﰊ",[11]],[70,12,"وَصَٰحِبَتِهِۦ وَأَخِيهِ","ﰋ",[12]],[70,13,"وَفَصِيلَتِهِ اِ۬لَّتِي تُــٔۡوِيهِ","ﰌ",[13]],[70,14,"وَمَن فِي اِ۬لۡأَرۡضِ جَمِيعٗا ثُمَّ يُنجِيهِ","ﰍ",[14]],[70,15,"كَلَّاۖ إِنَّهَا لَظۭيٰ","ﰎ",[15]],[70,16,"نَزَّاعَةٞ لِّلشَّوۭيٰ","ﰏ",[16]],[70,17,"تَدۡعُواْ مَنۡ أَدۡبَرَ وَتَوَلّۭيٰ","ﰐ",[17]],[70,18,"وَجَمَعَ فَأَوۡعۭيٰ","ﰑ",[18]],[70,19,"إِنَّ اَ۬لۡإِنسَٰنَ خُلِقَ هَلُوعًا","ﰒ",[19]],[70,20,"إِذَا مَسَّهُ اُ۬لشَّرُّ جَزُوعٗا","ﰓ",[20]],[70,21,"وَإِذَا مَسَّهُ اُ۬لۡخَيۡرُ مَنُوعًا","ﰔ",[21]],[70,22,"إِلَّا اَ۬لۡمُصَلِّينَ","ﰕ",[22]],[70,23,"اَ۬لَّذِينَ هُمۡ عَلَىٰ صَلَاتِهِمۡ دَآئِمُونَ","ﰖ",[23]],[70,24,"وَاَلَّذِينَ فِي أَمۡوَٰلِهِمۡ حَقّٞ مَّعۡلُومٞ","ﰗ",[24]],[70,25,"لِّلسَّآئِلِ وَاَلۡمَحۡرُومِ","ﰘ",[25]],[70,26,"وَاَلَّذِينَ يُصَدِّقُونَ بِيَوۡمِ اِ۬لدِّينِ","ﰙ",[26]],[70,27,"وَاَلَّذِينَ هُم مِّنۡ عَذَابِ رَبِّهِم مُّشۡفِقُونَ","ﰚ",[27]],[70,28,"إِنَّ عَذَابَ رَبِّهِمۡ غَيۡرُ مَامُونٖ","ﰛ",[28]],[70,29,"وَاَلَّذِينَ هُمۡ لِفُرُوجِهِمۡ حَٰفِظُونَ","ﰜ",[29]],[70,30,"إِلَّا عَلَىٰ أَزۡوَٰجِهِمۡ أَوۡ مَا مَلَكَتۡ أَيۡمَٰنُهُمۡ فَإِنَّهُمۡ غَيۡرُ مَلُومِينَ","ﰝ",[30]],[70,31,"فَمَنِ اِ۪بۡتَغَىٰ وَرَآءَ ذَٰلِكَ فَأُوْلَٰٓئِكَ هُمُ اُ۬لۡعَادُونَ","ﰞ",[31]],[70,32,"وَاَلَّذِينَ هُمۡ لِأَمَٰنَٰتِهِمۡ وَعَهۡدِهِمۡ رَٰعُونَ","ﰟ",[32]],[70,33,"وَاَلَّذِينَ هُم بِشَهَٰدَتِهِمۡ قَآئِمُونَ","ﰠ",[33]],[70,34,"وَاَلَّذِينَ هُمۡ عَلَىٰ صَلَاتِهِمۡ يُحَافِظُونَ","ﰡ",[34]],[70,35,"أُوْلَٰٓئِكَ فِي جَنَّٰتٖ مُّكۡرَمُونَ","ﰢ",[35]],[70,36,"فَمَالِ اِ۬لَّذِينَ كَفَرُواْ قِبَلَكَ مُهۡطِعِينَ","ﰣ",[36]],[70,37,"عَنِ اِ۬لۡيَمِينِ وَعَنِ اِ۬لشِّمَالِ عِزِينَ","ﰤ",[37]],[70,38,"أَيَطۡمَعُ كُلُّ اُ۪مۡرِيٕٖ مِّنۡهُمۡ أَن يُدۡخَلَ جَنَّةَ نَعِيمٖ","ﰥ",[38]],[70,39,"كَلَّاۖ إِنَّا خَلَقۡنَٰهُم مِّمَّا يَعۡلَمُونَ","ﰦ",[39]],[70,40,"۞ فَلَا أُقۡسِم بِرَبِّ اِ۬لۡمَشَٰرِقِ وَاَلۡمَغَٰرِبِ إِنَّا لَقَٰدِرُونَ","ﰧ",[40]]]