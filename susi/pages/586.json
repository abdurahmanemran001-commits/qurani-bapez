[[80,41,"تَرۡهَقُهَا قَتَرَةٌ","ﰨ",[41]],[80,42,"أُوْلَٰٓئِكَ هُمُ اُ۬لۡكَفَرَةُ اُ۬لۡفَجَرَةُ","ﰩ",[42]],[81,1,"إِذَا اَ۬لشَّمۡسُ كُوِّرَتۡ","ﰀ",[1]],[81,2,"وَإِذَا اَ۬لنُّجُومُ اُ۪نكَدَرَتۡ","ﰁ",[2]],[81,3,"وَإِذَا اَ۬لۡجِبَالُ سُيِّرَتۡ","ﰂ",[3]],[81,4,"وَإِذَا اَ۬لۡعِشَارُ عُطِّلَتۡ","ﰃ",[4]],[81,5,"وَإِذَا اَ۬لۡوُحُوشُ حُشِرَتۡ","ﰄ",[5]],[81,6,"وَإِذَا اَ۬لۡبِحَارُ سُجِرَتۡ","ﰅ",[6]],[81,7,"وَإِذَا اَ۬لنُّفُوس زُّوِّجَتۡ","ﰆ",[7]],[81,8,"وَإِذَا اَ۬لۡمَوۡءُۥدَة سُّئِلَتۡ","ﰇ",[8]],[81,9,"بِأَيِّ ذَنۢبٖ قُتِلَتۡ","ﰈ",[9]],[81,10,"وَإِذَا اَ۬لصُّحُفُ نُشِّرَتۡ","ﰉ",[10]],[81,11,"وَإِذَا اَ۬لسَّمَآءُ كُشِطَتۡ","ﰊ",[11]],[81,12,"وَإِذَا اَ۬لۡجَحِيمُ سُعِرَتۡ","ﰋ",[12]],[81,13,"وَإِذَا اَ۬لۡجَنَّةُ أُزۡلِفَتۡ","ﰌ",[13]],[81,14,"عَلِمَتۡ نَفۡسٞ مَّا أَحۡضَرَتۡ","ﰍ",[14]],[81,15,"فَلَا أُقۡسِم بِالۡخُنَّسِ","ﰎ",[15]],[81,16,"اِ۬لۡجَوَارِ اِ۬لۡكُنَّسِ","ﰏ",[16]],[81,17,"وَاَلَّيۡلِ إِذَا عَسۡعَسَ","ﰐ",[17]],[81,18,"وَاَلصُّبۡحِ إِذَا تَنَفَّسَ","ﰑ",[18]],[81,19,"إِنَّهُۥ لَقَوۡل رَّسُولٖ كَرِيمٖ","ﰒ",[19]],[81,20,"ذِي قُوَّةٍ عِندَ ذِي اِ۬لۡعَرۡشِ مَكِينٖ","ﰓ",[20]],[81,21,"مُّطَاعٖ ثَمَّ أَمِينٖ","ﰔ",[21]],[81,22,"وَمَا صَاحِبُكُم بِمَجۡنُونٖ","ﰕ",[22]],[81,23,"وَلَقَدۡ رَء۪اهُ بِالۡأُفُقِ اِ۬لۡمُبِينِ","ﰖ",[23]],[81,24,"وَمَا هُوَ عَلَى اَ۬لۡغَيۡب بِّضظَنِينٖ","ﰗ",[24]],[81,25,"وَمَا هُوَ بِقَوۡلِ شَيۡطَٰنٖ رَّجِيمٖ","ﰘ",[25]],[81,26,"فَأَيۡنَ تَذۡهَبُونَ","ﰙ",[26]],[81,27,"إِنۡ هُوَ إِلَّا ذِكۡرٞ لِّلۡعَٰلَمِينَ","ﰚ",[27]],[81,28,"لِمَن شَآءَ مِنكُمۡ أَن يَسۡتَقِيمَ","ﰛ",[28]],[81,29,"وَمَا تَشَآءُونَ إِلَّا أَن يَشَآءَ اَ۬للَّهُ رَبُّ اُ۬لۡعَٰلَمِينَ","ﰜ",[29]]]