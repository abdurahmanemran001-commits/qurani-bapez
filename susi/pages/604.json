[[112,1,"قُلۡ هُوَ اَ۬للَّهُ أَحَدٌ","ﰀ",[1]],[112,2,"اِ۬للَّهُ اُ۬لصَّمَدُ","ﰁ",[2]],[112,3,"لَمۡ يَلِدۡ وَلَمۡ يُولَدۡ","ﰂ",[3]],[112,4,"وَلَمۡ يَكُن لَّهُۥ كُفُؤًا أَحَدُۢ","ﰃ",[4]],[113,1,"قُلۡ أَعُوذُ بِرَبِّ اِ۬لۡفَلَقِ","ﰀ",[1]],[113,2,"مِن شَرِّ مَا خَلَقَ","ﰁ",[2]],[113,3,"وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ","ﰂ",[3]],[113,4,"وَمِن شَرِّ اِ۬لنَّفَّٰثَٰتِ فِي اِ۬لۡعُقَدِ","ﰃ",[4]],[113,5,"وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ","ﰄ",[5]],[114,1,"قُلۡ أَعُوذُ بِرَبِّ اِ۬لنَّاسِ","ﰀ",[1]],[114,2,"مَلِكِ اِ۬لنَّاسِ","ﰁ",[2]],[114,3,"إِلَٰهِ اِ۬لنَّاسِ","ﰂ",[3]],[114,4,"مِن شَرِّ اِ۬لۡوَسۡوَاسِ اِ۬لۡخَنَّاسِ","ﰃ",[4]],[114,5,"اِ۬لَّذِي يُوَسۡوِسُ فِي صُدُورِ اِ۬لنَّاسِ","ﰄ",[5]],[114,6,"مِنَ اَ۬لۡجِنَّةِ وَاَلنَّاسِ","ﰅ",[6]]]