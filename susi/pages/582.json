[[78,1,"عَمَّ يَتَسَآءَلُونَ","ﰀ",[1]],[78,2,"عَنِ اِ۬لنَّبَإِ اِ۬لۡعَظِيمِ","ﰁ",[2]],[78,3,"اِ۬لَّذِي هُمۡ فِيهِ مُخۡتَلِفُونَ","ﰂ",[3]],[78,4,"كَلَّا سَيَعۡلَمُونَ","ﰃ",[4]],[78,5,"ثُمَّ كَلَّا سَيَعۡلَمُونَ","ﰄ",[5]],[78,6,"أَلَمۡ نَجۡعَلِ اِ۬لۡأَرۡضَ مِهَٰدٗا","ﰅ",[6]],[78,7,"وَاَلۡجِبَالَ أَوۡتَادٗا","ﰆ",[7]],[78,8,"وَخَلَقۡنَٰكُمۡ أَزۡوَٰجٗا","ﰇ",[8]],[78,9,"وَجَعَلۡنَا نَوۡمَكُمۡ سُبَاتٗا","ﰈ",[9]],[78,10,"وَجَعَلۡنَا اَ۬لَّيۡل لِّبَاسٗا","ﰉ",[10]],[78,11,"وَجَعَلۡنَا اَ۬لنَّهَارَ مَعَاشٗا","ﰊ",[11]],[78,12,"وَبَنَيۡنَا فَوۡقَكُمۡ سَبۡعٗا شِدَادٗا","ﰋ",[12]],[78,13,"وَجَعَلۡنَا سِرَاجٗا وَهَّاجٗا","ﰌ",[13]],[78,14,"وَأَنزَلۡنَا مِنَ اَ۬لۡمُعۡصِرَٰتِ مَآءٗ ثَجَّاجٗا","ﰍ",[14]],[78,15,"لِّنُخۡرِجَ بِهِۦ حَبّٗا وَنَبَاتٗا","ﰎ",[15]],[78,16,"وَجَنَّٰتٍ أَلۡفَافًا","ﰏ",[16]],[78,17,"إِنَّ يَوۡمَ اَ۬لۡفَصۡلِ كَانَ مِيقَٰتٗا","ﰐ",[17]],[78,18,"يَوۡمَ يُنفَخُ فِي اِ۬لصُّورِ فَتَاتُونَ أَفۡوَاجٗا","ﰑ",[18]],[78,19,"وَفُتِّحَتِ اِ۬لسَّمَآءُ فَكَانَتۡ أَبۡوَٰبٗا","ﰒ",[19]],[78,20,"وَسُيِّرَتِ اِ۬لۡجِبَالُ فَكَانَت سَّرَابًا","ﰓ",[20]],[78,21,"إِنَّ جَهَنَّمَ كَانَتۡ مِرۡصَادٗا","ﰔ",[21]],[78,22,"لِّلطَّٰغِينَ مَــَٔابٗا","ﰕ",[22]],[78,23,"لَّٰبِثِينَ فِيهَا أَحۡقَابٗا","ﰖ",[23]],[78,24,"لَّا يَذُوقُونَ فِيهَا بَرۡدٗا وَلَا شَرَابًا","ﰗ",[24]],[78,25,"إِلَّا حَمِيمٗا وَغَسَاقٗا","ﰘ",[25]],[78,26,"جَزَآءٗ وِفَاقًا","ﰙ",[26]],[78,27,"إِنَّهُمۡ كَانُواْ لَا يَرۡجُونَ حِسَابٗا","ﰚ",[27]],[78,28,"وَكَذَّبُواْ بِــَٔايَٰتِنَا كِذَّابٗا","ﰛ",[28]],[78,29,"وَكُلَّ شَيۡءٍ أَحۡصَيۡنَٰهُ كِتَٰبٗا","ﰜ",[29]],[78,30,"فَذُوقُواْ فَلَن نَّزِيدَكُمۡ إِلَّا عَذَابًا","ﰝ",[30]]]