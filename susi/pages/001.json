[[1,1,"اِ۬لۡحَمۡدُ لِلَّهِ رَبِّ اِ۬لۡعَٰلَمِينَ","ﰀ",[2]],[1,2,"اَ۬لرَّحۡمَٰنِ اِ۬لرَّحِيم","ﰁ",[3]],[1,3,"مَّلِكِ يَوۡمِ اِ۬لدِّينِ","ﰂ",[4]],[1,4,"إِيَّاكَ نَعۡبُدُ وَإِيَّاكَ نَسۡتَعِينُ","ﰃ",[5]],[1,5,"اُ۪هۡدِنَا اَ۬لصِّرَٰطَ اَ۬لۡمُسۡتَقِيمَ","ﰄ",[6]],[1,6,"صِرَٰطَ اَ۬لَّذِينَ أَنۡعَمۡتَ عَلَيۡهِمۡ","ﰅ",[7]],[1,7,"غَيۡرِ اِ۬لۡمَغۡضُوبِ عَلَيۡهِمۡ وَلَا اَ۬لضَّآلِّينَ","ﰆ",[7]]]