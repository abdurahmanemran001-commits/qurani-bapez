[[86,1,"وَاَلسَّمَآءِ وَاَلطَّارِقِ","ﰀ",[1]],[86,2,"وَمَا أَدۡر۪ىٰكَ مَا اَ۬لطَّارِقُ","ﰁ",[2]],[86,3,"اُ۬لنَّجۡمُ اُ۬لثَّاقِبُ","ﰂ",[3]],[86,4,"إِن كُلُّ نَفۡسٖ لَّمَا عَلَيۡهَا حَافِظٞ","ﰃ",[4]],[86,5,"فَلۡيَنظُرِ اِ۬لۡإِنسَٰنُ مِمَّ خُلِقَ","ﰄ",[5]],[86,6,"خُلِقَ مِن مَّآءٖ دَافِقٖ","ﰅ",[6]],[86,7,"يَخۡرُجُ مِنۢ بَيۡنِ اِ۬لصُّلۡبِ وَاَلتَّرَآئِبِ","ﰆ",[7]],[86,8,"إِنَّهُۥ عَلَىٰ رَجۡعِهِۦ لَقَادِرٞ","ﰇ",[8]],[86,9,"يَوۡمَ تُبۡلَى اَ۬لسَّرَآئِرُ","ﰈ",[9]],[86,10,"فَمَا لَهُۥ مِن قُوَّةٖ وَلَا نَاصِرٖ","ﰉ",[10]],[86,11,"وَاَلسَّمَآءِ ذَاتِ اِ۬لرَّجۡعِ","ﰊ",[11]],[86,12,"وَاَلۡأَرۡضِ ذَاتِ اِ۬لصَّدۡعِ","ﰋ",[12]],[86,13,"إِنَّهُۥ لَقَوۡلٞ فَصۡلٞ","ﰌ",[13]],[86,14,"وَمَا هُوَ بِالۡهَزۡلِ","ﰍ",[14]],[86,15,"إِنَّهُمۡ يَكِيدُونَ كَيۡدٗا وَأَكِيدُ كَيۡدٗا","ﰎ",[15,16]],[86,16,"فَمَهِّلِ اِ۬لۡكٰ۪فِرِينَ أَمۡهِلۡهُمۡ رُوَيۡدَۢا","ﰏ",[17]],[87,1,"سَبِّحِ اِ۪سۡمَ رَبِّكَ اَ۬لۡأَعۡلَى","ﰀ",[1]],[87,2,"اَ۬لَّذِي خَلَقَ فَسَوّۭيٰ","ﰁ",[2]],[87,3,"وَاَلَّذِي قَدَّرَ فَهَدۭيٰ","ﰂ",[3]],[87,4,"وَاَلَّذِي أَخۡرَجَ اَ۬لۡمَرۡعۭيٰ","ﰃ",[4]],[87,5,"فَجَعَلَهُۥ غُثَآءً أَحۡوۭيٰ","ﰄ",[5]],[87,6,"سَنُقۡرِئُكَ فَلَا تَنسۭيٰ","ﰅ",[6]],[87,7,"إِلَّا مَا شَآءَ اَ۬للَّهُۚ إِنَّهُۥ يَعۡلَمُ اُ۬لۡجَهۡرَ وَمَا يَخۡفۭيٰ","ﰆ",[7]],[87,8,"وَنُيَسِّرُكَ لِلۡيُسۡر۪يٰ","ﰇ",[8]],[87,9,"فَذَكِّرۡ إِن نَّفَعَتِ اِ۬لذِّكۡر۪يٰ","ﰈ",[9]],[87,10,"سَيَذَّكَّرُ مَن يَخۡشۭيٰ","ﰉ",[10]]]