[[94,3,"اَ۬لَّذِي أَنقَضَ ظَهۡرَكَ","ﰂ",[3]],[94,4,"وَرَفَعۡنَا لَكَ ذِكۡرَكَ","ﰃ",[4]],[94,5,"فَإِنَّ مَعَ اَ۬لۡعُسۡرِ يُسۡرًا","ﰄ",[5]],[94,6,"إِنَّ مَعَ اَ۬لۡعُسۡرِ يُسۡرٗا","ﰅ",[6]],[94,7,"فَإِذَا فَرَغۡتَ فَاَنصَبۡ","ﰆ",[7]],[94,8,"وَإِلَىٰ رَبِّكَ فَاَرۡغَب","ﰇ",[8]],[95,1,"وَاَلتِّينِ وَاَلزَّيۡتُونِ","ﰀ",[1]],[95,2,"وَطُورِ سِينِينَ","ﰁ",[2]],[95,3,"وَهَٰذَا اَ۬لۡبَلَدِ اِ۬لۡأَمِينِ","ﰂ",[3]],[95,4,"لَقَدۡ خَلَقۡنَا اَ۬لۡإِنسَٰنَ فِي أَحۡسَنِ تَقۡوِيمٖ","ﰃ",[4]],[95,5,"ثُمَّ رَدَدۡنَٰهُ أَسۡفَلَ سَٰفِلِينَ","ﰄ",[5]],[95,6,"إِلَّا اَ۬لَّذِينَ ءَامَنُواْ وَعَمِلُواْ اُ۬لصَّٰلِحَٰتِ فَلَهُمۡ أَجۡرٌ غَيۡرُ مَمۡنُونٖ","ﰅ",[6]],[95,7,"فَمَا يُكَذِّبُكَ بَعۡدُ بِالدِّينِ","ﰆ",[7]],[95,8,"أَلَيۡسَ اَ۬للَّهُ بِأَحۡكَمِ اِ۬لۡحَٰكِمِينَ","ﰇ",[8]],[96,1,"اِ۪قۡرَأۡ بِاسۡمِ رَبِّكَ اَ۬لَّذِي خَلَقَ","ﰀ",[1]],[96,2,"خَلَقَ اَ۬لۡإِنسَٰنَ مِنۡ عَلَقٍ","ﰁ",[2]],[96,3,"اِ۪قۡرَأۡ وَرَبُّكَ اَ۬لۡأَكۡرَمُ","ﰂ",[3]],[96,4,"اُ۬لَّذِي عَلَّم بِالۡقَلَمِ","ﰃ",[4]],[96,5,"عَلَّمَ اَ۬لۡإِنسَٰنَ مَا لَمۡ يَعۡلَمۡ","ﰄ",[5]],[96,6,"كَلَّا إِنَّ اَ۬لۡإِنسَٰنَ لَيَطۡغۭيٰ","ﰅ",[6]],[96,7,"أَن رَّء۪اهُ اُ۪سۡتَغۡنۭيٰ","ﰆ",[7]],[96,8,"إِنَّ إِلَىٰ رَبِّكَ اَ۬لرُّجۡعۭيٰ","ﰇ",[8]],[96,9,"أَرَءَيۡتَ اَ۬لَّذِي يَنۡهۭيٰ","ﰈ",[9]],[96,10,"عَبۡدًا إِذَا صَلّۭيٰ","ﰉ",[10]],[96,11,"أَرَءَيۡتَ إِن كَانَ عَلَى اَ۬لۡهُدۭيٰ","ﰊ",[11]],[96,12,"أَوۡ أَمَرَ بِالتَّقۡوۭيٰ","ﰋ",[12]]]