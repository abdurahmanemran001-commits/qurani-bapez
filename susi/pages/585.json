[[80,1,"عَبَسَ وَتَوَلّۭيٰ","ﰀ",[1]],[80,2,"أَن جَآءَهُ اُ۬لۡأَعۡمۭيٰ","ﰁ",[2]],[80,3,"وَمَا يُدۡرِيكَ لَعَلَّهُۥ يَزَّكّۭيٰ","ﰂ",[3]],[80,4,"أَوۡ يَذَّكَّرُ فَتَنفَعُهُ اُ۬لذِّكۡر۪يٰ","ﰃ",[4]],[80,5,"أَمَّا مَنِ اِ۪سۡتَغۡنۭيٰ","ﰄ",[5]],[80,6,"فَأَنتَ لَهُۥ تَصَدّۭيٰ","ﰅ",[6]],[80,7,"وَمَا عَلَيۡكَ أَلَّا يَزَّكّۭيٰ","ﰆ",[7]],[80,8,"وَأَمَّا مَن جَآءَكَ يَسۡعۭيٰ","ﰇ",[8]],[80,9,"وَهۡوَ يَخۡشۭيٰ","ﰈ",[9]],[80,10,"فَأَنتَ عَنۡهُ تَلَهّۭيٰ","ﰉ",[10]],[80,11,"كَلَّا إِنَّهَا تَذۡكِرَةٞ","ﰊ",[11]],[80,12,"فَمَن شَآءَ ذَكَرَهُۥ","ﰋ",[12]],[80,13,"فِي صُحُفٖ مُّكَرَّمَةٖ","ﰌ",[13]],[80,14,"مَّرۡفُوعَةٖ مُّطَهَّرَةِۢ","ﰍ",[14]],[80,15,"بِأَيۡدِي سَفَرَةٖ","ﰎ",[15]],[80,16,"كِرَامِۢ بَرَرَةٖ","ﰏ",[16]],[80,17,"قُتِلَ اَ۬لۡإِنسَٰنُ مَا أَكۡفَرَهُۥ","ﰐ",[17]],[80,18,"مِنۡ أَيِّ شَيۡءٍ خَلَقَهُۥ","ﰑ",[18]],[80,19,"مِن نُّطۡفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ","ﰒ",[19]],[80,20,"ثُمَّ اَ۬لسَّبِيلَ يَسَّرَهُۥ","ﰓ",[20]],[80,21,"ثُمَّ أَمَاتَهُۥ فَأَقۡبَرَهُۥ","ﰔ",[21]],[80,22,"ثُمَّ إِذَا شَا أَنشَرَهُۥ","ﰕ",[22]],[80,23,"كَلَّا لَمَّا يَقۡضِ مَا أَمَرَهُۥ","ﰖ",[23]],[80,24,"فَلۡيَنظُرِ اِ۬لۡإِنسَٰنُ إِلَىٰ طَعَامِهِۦ","ﰗ",[24]],[80,25,"إِنَّا صَبَبۡنَا اَ۬لۡمَآءَ صَبّٗا","ﰘ",[25]],[80,26,"ثُمَّ شَقَقۡنَا اَ۬لۡأَرۡضَ شَقّٗا","ﰙ",[26]],[80,27,"فَأَنۢبَتۡنَا فِيهَا حَبّٗا","ﰚ",[27]],[80,28,"وَعِنَبٗا وَقَضۡبٗا","ﰛ",[28]],[80,29,"وَزَيۡتُونٗا وَنَخۡلٗا","ﰜ",[29]],[80,30,"وَحَدَآئِقَ غُلۡبٗا","ﰝ",[30]],[80,31,"وَفَٰكِهَةٗ وَأَبّٗا","ﰞ",[31]],[80,32,"مَّتَٰعٗا لَّكُمۡ وَلِأَنۡعَٰمِكُمۡ","ﰟ",[32]],[80,33,"فَإِذَا جَآءَتِ اِ۬لصَّآخَّةُ","ﰠ",[33]],[80,34,"يَوۡمَ يَفِرُّ اُ۬لۡمَرۡءُ مِنۡ أَخِيهِ","ﰡ",[34]],[80,35,"وَأُمِّهِۦ وَأَبِيهِ","ﰢ",[35]],[80,36,"وَصَٰحِبَتِهِۦ وَبَنِيهِ","ﰣ",[36]],[80,37,"لِكُلِّ اِ۪مۡرِيٕٖ مِّنۡهُمۡ يَوۡمَئِذٖ شَانٞ يُغۡنِيهِ","ﰤ",[37]],[80,38,"۞ وُجُوهٞ يَوۡمَئِذٖ مُّسۡفِرَةٞ","ﰥ",[38]],[80,39,"ضَاحِكَةٞ مُّسۡتَبۡشِرَةٞ","ﰦ",[39]],[80,40,"وَوُجُوهٞ يَوۡمَئِذٍ عَلَيۡهَا غَبَرَةٞ","ﰧ",[40]]]