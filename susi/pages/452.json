[[37,154,"مَا لَكُمۡ كَيۡفَ تَحۡكُمُونَ","ﲙ",[154]],[37,155,"أَفَلَا تَذَّكَّرُونَ","ﲚ",[155]],[37,156,"أَمۡ لَكُمۡ سُلۡطَٰنٞ مُّبِينٞ","ﲛ",[156]],[37,157,"فَاتُواْ بِكِتَٰبِكُمۡ إِن كُنتُمۡ صَٰدِقِينَ","ﲜ",[157]],[37,158,"وَجَعَلُواْ بَيۡنَهُۥ وَبَيۡنَ اَ۬لۡجِنَّةِ نَسَبٗاۚ وَلَقَدۡ عَلِمَتِ اِ۬لۡجِنَّةُ إِنَّهُمۡ لَمُحۡضَرُونَ","ﲝ",[158]],[37,159,"سُبۡحَٰنَ اَ۬للَّهِ عَمَّا يَصِفُونَ","ﲞ",[159]],[37,160,"إِلَّا عِبَادَ اَ۬للَّهِ اِ۬لۡمُخۡلِصِينَ","ﲟ",[160]],[37,161,"فَإِنَّكُمۡ وَمَا تَعۡبُدُونَ","ﲠ",[161]],[37,162,"مَا أَنتُمۡ عَلَيۡهِ بِفَٰتِنِينَ","ﲡ",[162]],[37,163,"إِلَّا مَنۡ هُوَ صَالِ اِ۬لۡجَحِيمِ","ﲢ",[163]],[37,164,"وَمَا مِنَّا إِلَّا لَهُۥ مَقَامٞ مَّعۡلُومٞ","ﲣ",[164]],[37,165,"وَإِنَّا لَنَحۡنُ اُ۬لصَّآفُّونَ","ﲤ",[165]],[37,166,"وَإِنَّا لَنَحۡنُ اُ۬لۡمُسَبِّحُونَ","ﲥ",[166]],[37,167,"وَإِن كَانُواْ لَيَقُولُونَ","ﲦ",[167]],[37,168,"لَوۡ أَنَّ عِندَنَا ذِكۡرٗا مِّنَ اَ۬لۡأَوَّلِينَ","ﲧ",[168]],[37,169,"لَكُنَّا عِبَادَ اَ۬للَّهِ اِ۬لۡمُخۡلِصِينَ","ﲨ",[169]],[37,170,"فَكَفَرُواْ بِهِۦۖ فَسَوۡفَ يَعۡلَمُونَ","ﲩ",[170]],[37,171,"وَلَقَد سَّبَقَتۡ كَلِمَتُنَا لِعِبَادِنَا اَ۬لۡمُرۡسَلِينَ","ﲪ",[171]],[37,172,"إِنَّهُمۡ لَهُمُ اُ۬لۡمَنصُورُونَ","ﲫ",[172]],[37,173,"وَإِنَّ جُندَنَا لَهُمُ اُ۬لۡغَٰلِبُونَ","ﲬ",[173]],[37,174,"فَتَوَلَّ عَنۡهُمۡ حَتَّىٰ حِينٖ","ﲭ",[174]],[37,175,"وَأَبۡصِرۡهُمۡ فَسَوۡفَ يُبۡصِرُونَ","ﲮ",[175]],[37,176,"أَفَبِعَذَابِنَا يَسۡتَعۡجِلُونَ","ﲯ",[176]],[37,177,"فَإِذَا نَزَلَ بِسَاحَتِهِمۡ فَسَآءَ صَبَاحُ اُ۬لۡمُنذَرِينَ","ﲰ",[177]],[37,178,"وَتَوَلَّ عَنۡهُمۡ حَتَّىٰ حِينٖ","ﲱ",[178]],[37,179,"وَأَبۡصِرۡ فَسَوۡفَ يُبۡصِرُونَ","ﲲ",[179]],[37,180,"سُبۡحَٰنَ رَبِّكَ رَبِّ اِ۬لۡعِزَّةِ عَمَّا يَصِفُونَ","ﲳ",[180]],[37,181,"وَسَلَٰمٌ عَلَى اَ۬لۡمُرۡسَلِينَ","ﲴ",[181]],[37,182,"وَاَلۡحَمۡدُ لِلَّهِ رَبِّ اِ۬لۡعَٰلَمِينَ","ﲵ",[182]]]