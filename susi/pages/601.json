[[103,1,"وَاَلۡعَصۡرِ","ﰀ",[1]],[103,2,"إِنَّ اَ۬لۡإِنسَٰنَ لَفِي خُسۡرٍ","ﰁ",[2]],[103,3,"إِلَّا اَ۬لَّذِينَ ءَامَنُواْ وَعَمِلُواْ اُ۬لصَّٰلِحَٰتِ وَتَوَاصَوۡاْ بِالۡحَقِّ وَتَوَاصَوۡاْ بِالصَّبۡرِ","ﰂ",[3]],[104,1,"وَيۡلٞ لِّكُلِّ هُمَزَةٖ لُّمَزَةٍ","ﰀ",[1]],[104,2,"اِ۬لَّذِي جَمَعَ مَالٗا وَعَدَّدَهُۥ","ﰁ",[2]],[104,3,"يَحۡسِبُ أَنَّ مَالَهُۥ أَخۡلَدَهُۥ","ﰂ",[3]],[104,4,"كَلَّاۖ لَيُنۢبَذَنَّ فِي اِ۬لۡحُطَمَةِ","ﰃ",[4]],[104,5,"وَمَا أَدۡر۪ىٰكَ مَا اَ۬لۡحُطَمَةُ","ﰄ",[5]],[104,6,"نَارُ اُ۬للَّهِ اِ۬لۡمُوقَدَةُ","ﰅ",[6]],[104,7,"اُ۬لَّتِي تَطَّلِع عَّلَى اَ۬لۡأَفۡــِٔدَةِ","ﰆ",[7]],[104,8,"إِنَّهَا عَلَيۡهِم مُّؤۡصَدَةٞ","ﰇ",[8]],[104,9,"فِي عَمَدٖ مُّمَدَّدَةِۢ","ﰈ",[9]],[105,1,"أَلَمۡ تَرَ كَيۡف فَّعَل رَّبُّكَ بِأَصۡحَٰبِ اِ۬لۡفِيلِ","ﰀ",[1]],[105,2,"أَلَمۡ يَجۡعَلۡ كَيۡدَهُمۡ فِي تَضۡلِيلٖ","ﰁ",[2]],[105,3,"وَأَرۡسَلَ عَلَيۡهِمۡ طَيۡرًا أَبَابِيلَ","ﰂ",[3]],[105,4,"تَرۡمِيهِم بِحِجَارَةٖ مِّن سِجِّيلٖ","ﰃ",[4]],[105,5,"فَجَعَلَهُمۡ كَعَصۡفٖ مَّاكُولِۢ","ﰄ",[5]]]