[[56,80,"إِنَّهُۥ لَقُرۡءَانٞ كَرِيمٞ","ﱏ",[77]],[56,81,"فِي كِتَٰبٖ مَّكۡنُونٖ","ﱐ",[78]],[56,82,"لَّا يَمَسُّهُۥ إِلَّا اَ۬لۡمُطَهَّرُونَ","ﱑ",[79]],[56,83,"تَنزِيلٞ مِّن رَّبِّ اِ۬لۡعَٰلَمِينَ","ﱒ",[80]],[56,84,"أَفَبِهَٰذَا اَ۬لۡحَدِيثِ أَنتُم مُّدۡهِنُونَ","ﱓ",[81]],[56,85,"وَتَجۡعَلُونَ رِزۡقَكُمۡ أَنَّكُمۡ تُكَذِّبُونَ","ﱔ",[82]],[56,86,"فَلَوۡلَا إِذَا بَلَغَتِ اِ۬لۡحُلۡقُومَ","ﱕ",[83]],[56,87,"وَأَنتُمۡ حِينَئِذٖ تَنظُرُونَ","ﱖ",[84]],[56,88,"وَنَحۡنُ أَقۡرَبُ إِلَيۡهِ مِنكُمۡ وَلَٰكِن لَّا تُبۡصِرُونَ","ﱗ",[85]],[56,89,"فَلَوۡلَا إِن كُنتُمۡ غَيۡرَ مَدِينِينَ","ﱘ",[86]],[56,90,"تَرۡجِعُونَهَا إِن كُنتُمۡ صَٰدِقِينَ","ﱙ",[87]],[56,91,"فَأَمَّا إِن كَانَ مِنَ اَ۬لۡمُقَرَّبِينَ","ﱚ",[88]],[56,92,"فَرَوۡحٞ وَرَيۡحَانٞ وَجَنَّتُ نَعِيمٖ","ﱛ",[89]],[56,93,"وَأَمَّا إِن كَانَ مِنۡ أَصۡحَٰبِ اِ۬لۡيَمِينِ","ﱜ",[90]],[56,94,"فَسَلَٰمٞ لَّكَ مِنۡ أَصۡحَٰبِ اِ۬لۡيَمِينِ","ﱝ",[91]],[56,95,"وَأَمَّا إِن كَانَ مِنَ اَ۬لۡمُكَذِّبِينَ اَ۬لضَّآلِّينَ","ﱞ",[92]],[56,96,"فَنُزُلٞ مِّنۡ حَمِيمٖ","ﱟ",[93]],[56,97,"وَتَصۡلِيَة جَّحِيمٍ","ﱠ",[94]],[56,98,"إِنَّ هَٰذَا لَهۡوَ حَقُّ اُ۬لۡيَقِينِ","ﱡ",[95]],[56,99,"فَسَبِّحۡ بِاسۡمِ رَبِّكَ اَ۬لۡعَظِيمِ","ﱢ",[96]],[57,1,"سَبَّحَ لِلَّهِ مَا فِي اِ۬لسَّمَٰوَٰتِ وَاَلۡأَرۡضِۖ وَهۡوَ اَ۬لۡعَزِيزُ اُ۬لۡحَكِيمُ","ﰀ",[1]],[57,2,"لَهُۥ مُلۡكُ اُ۬لسَّمَٰوَٰتِ وَاَلۡأَرۡضِۖ يُحۡيِۦ وَيُمِيتُۖ وَهۡوَ عَلَىٰ كُلِّ شَيۡءٖ قَدِيرٌ","ﰁ",[2]],[57,3,"هُوَ اَ۬لۡأَوَّلُ وَاَلۡأٓخِرُ وَاَلظَّٰهِرُ وَاَلۡبَاطِنُۖ وَهۡوَ بِكُلِّ شَيۡءٍ عَلِيمٌ","ﰂ",[3]]]