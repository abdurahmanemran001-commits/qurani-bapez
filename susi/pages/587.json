[[82,1,"إِذَا اَ۬لسَّمَآءُ اُ۪نفَطَرَتۡ","ﰀ",[1]],[82,2,"وَإِذَا اَ۬لۡكَوَاكِبُ اُ۪نتَثَرَتۡ","ﰁ",[2]],[82,3,"وَإِذَا اَ۬لۡبِحَارُ فُجِّرَتۡ","ﰂ",[3]],[82,4,"وَإِذَا اَ۬لۡقُبُورُ بُعۡثِرَتۡ","ﰃ",[4]],[82,5,"عَلِمَتۡ نَفۡسٞ مَّا قَدَّمَتۡ وَأَخَّرَتۡ","ﰄ",[5]],[82,6,"يَٰأَيُّهَا اَ۬لۡإِنسَٰنُ مَا غَرَّكَ بِرَبِّكَ اَ۬لۡكَرِيمِ","ﰅ",[6]],[82,7,"اِ۬لَّذِي خَلَقَكَ فَسَوَّىٰكَ فَعَدَّلَكَ","ﰆ",[7]],[82,8,"فِي أَيِّ صُورَةٖ مَّا شَآءَ رَكَّبَك","ﰇ",[8]],[82,9,"كَّلَّا بَلۡ تُكَذِّبُونَ بِالدِّينِ","ﰈ",[9]],[82,10,"وَإِنَّ عَلَيۡكُمۡ لَحَٰفِظِينَ","ﰉ",[10]],[82,11,"كِرَامٗا كَٰتِبِينَ","ﰊ",[11]],[82,12,"يَعۡلَمُونَ مَا تَفۡعَلُونَ","ﰋ",[12]],[82,13,"إِنَّ اَ۬لۡأَبۡرَارَ لَفِي نَعِيمٖ","ﰌ",[13]],[82,14,"وَإِنَّ اَ۬لۡفُجَّارَ لَفِي جَحِيمٖ","ﰍ",[14]],[82,15,"يَصۡلَوۡنَهَا يَوۡمَ اَ۬لدِّينِ","ﰎ",[15]],[82,16,"وَمَا هُمۡ عَنۡهَا بِغَآئِبِينَ","ﰏ",[16]],[82,17,"وَمَا أَدۡر۪ىٰكَ مَا يَوۡمُ اُ۬لدِّينِ","ﰐ",[17]],[82,18,"ثُمَّ مَا أَدۡر۪ىٰكَ مَا يَوۡمُ اُ۬لدِّينِ","ﰑ",[18]],[82,19,"يَوۡمُ لَا تَمۡلِكُ نَفۡسٞ لِّنَفۡسٖ شَيۡــٔٗاۖ وَاَلۡأَمۡرُ يَوۡمَئِذٖ لِّلَّهِ","ﰒ",[19]],[83,1,"وَيۡلٞ لِّلۡمُطَفِّفِينَ","ﰀ",[1]],[83,2,"اَ۬لَّذِينَ إِذَا اَ۪كۡتَالُواْ عَلَى اَ۬لنَّاسِ يَسۡتَوۡفُونَ","ﰁ",[2]],[83,3,"وَإِذَا كَالُوهُمۡ أَو وَّزَنُوهُمۡ يُخۡسِرُونَ","ﰂ",[3]],[83,4,"أَلَا يَظُنُّ أُوْلَٰٓئِكَ أَنَّهُم مَّبۡعُوثُونَ","ﰃ",[4]]]