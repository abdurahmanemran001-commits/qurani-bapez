[[109,1,"قُلۡ يَٰأَيُّهَا اَ۬لۡكَٰفِرُونَ","ﰀ",[1]],[109,2,"لَا أَعۡبُدُ مَا تَعۡبُدُونَ","ﰁ",[2]],[109,3,"وَلَا أَنتُمۡ عَٰبِدُونَ مَا أَعۡبُدُ","ﰂ",[3]],[109,4,"وَلَا أَنَا۠ عَابِدٞ مَّا عَبَدتُّمۡ","ﰃ",[4]],[109,5,"وَلَا أَنتُمۡ عَٰبِدُونَ مَا أَعۡبُدُ","ﰄ",[5]],[109,6,"لَكُمۡ دِينُكُمۡ وَلِي دِينِ","ﰅ",[6]],[110,1,"إِذَا جَآءَ نَصۡرُ اُ۬للَّهِ وَاَلۡفَتۡحُ","ﰀ",[1]],[110,2,"وَرَأَيۡتَ اَ۬لنَّاسَ يَدۡخُلُونَ فِي دِينِ اِ۬للَّهِ أَفۡوَاجٗا","ﰁ",[2]],[110,3,"فَسَبِّحۡ بِحَمۡدِ رَبِّكَ وَاَسۡتَغۡفِرۡهُۚ إِنَّهُۥ كَانَ تَوَّابَۢا","ﰂ",[3]],[111,1,"تَبَّتۡ يَدَا أَبِي لَهَبٖ وَتَبَّ","ﰀ",[1]],[111,2,"مَا أَغۡنَىٰ عَنۡهُ مَالُهُۥ وَمَا كَسَبَ","ﰁ",[2]],[111,3,"سَيَصۡلَىٰ نَارٗا ذَاتَ لَهَبٖ","ﰂ",[3]],[111,4,"وَاَمۡرَأَتُهُۥ حَمَّالَةُ اُ۬لۡحَطَبِ","ﰃ",[4]],[111,5,"فِي جِيدِهَا حَبۡلٞ مِّن مَّسَدِۢ","ﰄ",[5]]]